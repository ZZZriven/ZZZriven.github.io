 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2607.13104v1","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"Read PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"SUMMARY"}],["$","p",null,{"children":"用“更新什么、凭什么更新”组织 self-improvement 研究，将 model parameters 与 prompt、memory、工具、control logic 放入同一个系统框架。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Improvement Target"}],["$","dd",null,{"children":"Model Parameters & Scaffolds"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Feedback"}],["$","dd",null,{"children":"综合内生生成、评价 feedback 与环境经验"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"Evidence Scope"}],["$","dd",null,{"children":"综述框架；核读摘要与框架材料，未通读全部正文"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"同样被称为 self-improvement 的系统，实际可能只修改一次回答，也可能积累 memory 或更新 model parameters。缺少统一的系统描述，会让机制、学习信号和评测结果难以比较，也难以判断能力是否被持续保留。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"作者把 Agent 表示为 foundation model 与 scaffold 的组合，并用自主产生且提交更新的算子描述改进。这一视角将关注点放在经验如何转化为保留的系统变化，而不只看最终回答是否更好。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],"$L10"]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"论文框架中，foundation model 改进可利用内生示例、评价 feedback 或外部经验；scaffold 改进则细分 prompt、memory、工具和整体 control logic。同一 feedback 形式可能服务于不同更新对象，因此单一技术标签不够准确。"}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"综述先建立系统层面的形式化，再按更新对象和驱动信号梳理方法，将 model 改进与 scaffold 改进分成两大分支，并另设评测与 benchmark 入口。各类方法与代表论文之间建立了可追踪的索引。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"主要产出是组织文献的框架与研究地图，而非新的性能纪录。其价值在于把 prompt evolution、memory 积累、工具创建和参数学习放到可比较的坐标中，并连接应用、评测与尚未解决的问题。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"本条核对了 arXiv 摘要与正文框架，未逐页通读 97 页全文。综述覆盖 self-improvement 的广义家族，不意味着每篇收录论文都实现了改进机制自身通过 recursion 获得提升，也不提供通用 RSI 已实现的实证。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：可将此框架转化为统一阅读表，逐篇记录更新对象、feedback 来源、提交条件、保留时长和独立测试。下一步应补充长期能力曲线及更新失败案例，让分类同时服务于证据比较。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"该综述从 model 与 scaffold 组成、更新对象及 feedback 信号分析 Agent self-improvement，帮助区分经验保留、系统更新和能力测量。作为定义与框架研究收录，不把分类方案本身当作 recursive optimization 系统的实证。"}]]}]

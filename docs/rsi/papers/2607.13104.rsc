1b:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
1c:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"同样被称为 self-improvement 的系统，实际可能只修改一次回答，也可能积累 memory 或更新 model parameters。缺少统一的系统描述，会让机制、学习信号和评测结果难以比较，也难以判断能力是否被持续保留。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Improvements in Modern Agentic Systems: A Survey · v1","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Self-improvement 被用于描述权重训练、记忆更新、代码搜索和当前答案修订，导致同一词指向不同过程。这篇 Survey 从系统状态与更新算子出发，试图建立可比较的描述语言。其价值在于帮助读者判断什么被保留、由什么信号改变、证据支持到哪一步。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Improvements in Modern Agentic Systems: A Survey · v1","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"较早的 Self-Evolving Agents Survey 用 What、When、How 组织领域；DGM 与 Self-Rewarding 分别展示代码和 Model 层的闭环。本文更强调 Foundation Model 与 Operational Scaffold 的组合，以及系统自身执行所产生的信号如何被提交成持久更新。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2507.21046",{"href":"#reference-2507.21046","aria-label":"来源 2: A Survey of Self-Evolving Agents: What, When, How, and Where to Evolve on the Path to Artificial Super Intelligence","children":["[",2,"]"]}],["$","a","2505.22954",{"href":"#reference-2505.22954","aria-label":"来源 3: Darwin Godel Machine: Open-Ended Evolution of Self-Improving Agents","children":["[",3,"]"]}],["$","a","2401.10020",{"href":"#reference-2401.10020","aria-label":"来源 4: Self-Rewarding Language Models","children":["[",4,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"如果只按应用领域分组，同一更新机制会散落在多个栏目；只按是否更新 Weights，又会漏掉工具和 Memory。可以先将系统写成可变状态，再追踪一次执行产生什么信号、哪个算子提交修改。由此自然得到 Update Target 与 Feedback 两条独立轴，并留下对 Improver 自身变化的进一步问题。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2507.21046",{"href":"#reference-2507.21046","aria-label":"来源 2: A Survey of Self-Evolving Agents: What, When, How, and Where to Evolve on the Path to Artificial Super Intelligence","children":["[",2,"]"]}],["$","a","2505.22954",{"href":"#reference-2505.22954","aria-label":"来源 3: Darwin Godel Machine: Open-Ended Evolution of Self-Improving Agents","children":["[",3,"]"]}],["$","a","2401.10020",{"href":"#reference-2401.10020","aria-label":"来源 4: Self-Rewarding Language Models","children":["[",4,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],["$L21"]]}]]}],"$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]

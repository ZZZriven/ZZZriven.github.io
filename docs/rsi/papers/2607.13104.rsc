-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"同样被称为自我改进的系统，实际可能只修改一次回答，也可能积累记忆或更新模型参数。缺少统一的系统描述，会让机制、学习信号和评测结果难以比较，也难以判断能力是否被持续保留。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"作者把智能体表示为基础模型与运行支架的组合，并用自主产生且提交更新的算子描述改进。这一视角将关注点放在经验如何转化为保留的系统变化，而不只看最终回答是否更好。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],["$","h2",null,{"children":["关键观察",false]}],"$L10"]}]]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","p",null,{"children":"论文框架中，基础模型改进可利用内生示例、评价反馈或外部经验；支架改进则细分提示、记忆、工具和整体控制逻辑。同一反馈形式可能服务于不同更新对象，因此单一技术标签不够准确。"}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"综述先建立系统层面的形式化，再按更新对象和驱动信号梳理方法，将模型改进与支架改进分成两大分支，并另设评测与基准入口。配套项目页提供从分类到代表论文的可追踪索引。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"主要产出是组织文献的框架与研究地图，而非新的性能纪录。其价值在于把提示演化、记忆积累、工具创建和参数学习放到可比较的坐标中，并连接应用、评测与尚未解决的问题。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"本条核对了arXiv 摘要与正文框架，未逐页通读97页全文。综述覆盖自我改进的广义家族，不意味着每篇收录论文都实现了改进机制自身的递归提升，也不提供通用RSI已实现的实证。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：可将此框架转化为统一阅读表，逐篇记录更新对象、反馈来源、提交条件、保留时长和独立测试。下一步应补充长期能力曲线及更新失败案例，让分类同时服务于证据比较。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"该综述从模型与支架组成、更新对象及反馈信号分析智能体自改进，帮助区分经验保留、系统更新和能力测量。作为定义与框架研究收录，不把分类方案本身当作递归改进系统的实证。"}]]}]

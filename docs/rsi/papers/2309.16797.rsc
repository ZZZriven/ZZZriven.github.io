"path",{"d":"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv 原文",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2309.16797v1","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"阅读 PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"ABSTRACT / 摘要"}],["$","p",null,{"children":"不仅搜索更好的任务提示，还修改负责产生这些提示的变异提示，是在固定进化框架内研究改进策略自修改的案例。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"改进对象"}],["$","dd",null,{"children":"任务提示与提示改进策略"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"反馈来源"}],["$","dd",null,{"children":"带答案的任务训练集提供适应度；种群选择保留优胜个体；变异提示被更新后继续控制下一轮提示生成。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"证据边界"}],["$","dd",null,{"children":"已核验 arXiv 摘要与 v1 历史，正文第 3 节个体构成、选择及第 3.2 节变异机制；未复现实验。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"手写提示容易受具体任务和设计者经验限制，固定的提示改写策略也可能阻碍搜索。论文研究能否让语言模型进化任务提示，同时调整产生提示变体的规则，使下一轮搜索采用由系统自己更新的改进策略。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"如果变异规则也用自然语言表示，生成器就可以把自己的操作条件作为可编辑对象。由此可区分直接改进任务提示和改进产生提示的方法：后者会影响下一轮候选的分布，是本文自指机制的核心。"}]]}]]}],"$L10","$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],["$","h2",null,{"children":["关键观察",false]}],["$","p",null,{"children":"一个进化个体同时保留任务提示、变异提示以及可选的成功推理示例，任务适应度决定选择。论文展示变异提示能够被超变异操作更新；但决定使用哪些操作以及如何评估个体的外层框架仍由研究者预设。"}]]}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"初始化多样化提示种群，在训练题目上评估任务表现，以锦标赛选择保留更好的个体。语言模型执行直接改写、分布式变异等操作；超变异会重写变异提示，更新后的变异提示再参与后续任务提示生成。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"作者报告，进化出的提示在算术与常识推理基准上超过所比较的人工提示策略，并能产生适用于仇恨言论分类的复杂提示。实验验证了有限任务域中的提示进化，不意味着语言模型底层参数或通用能力持续增加。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"适应度来自带答案的训练任务，基础语言模型、外层选择算法和超变异机制仍固定。可编辑对象主要是提示文本，结果受任务分布与评估预算制约；这里的自修改范围不能延伸为完整系统任意重写和无界进步。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：应在相同候选生成和评估预算下比较固定变异与可变异改进策略，并检验学到的变异提示能否迁移到新任务。这样才能分离改进器更新的实际贡献与单纯扩大提示搜索数量带来的收益。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"变异提示承担后续候选生成的改进职责，并能由系统重写后投入下一轮，因此归为受限的改进器自修改。主分类落在智能体与代码方向的提示策略层，明确其不修改模型权重或全部进化程序。"}]]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"来源与核验范围"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。核心洞察、局限分析、关联分类与未来展望含本站解读；论文观察与实验结果在其原始设置下成立。摘要级核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2309.16797",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2309.16797","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要与提交历史：题名、作者、日期、任务域与提示比较结论。"}]]}],["$","li","https://arxiv.org/html/2309.16797v1",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2309.16797v1","target":"_blank","rel":"noreferrer","children":["任务提示与变异提示的自修改"," ↗"]}],["$","span",null,{"children":"全文第 3 节：适应度、种群个体、锦标赛选择；第 3.2 节尤其 3.2.3：超变异与变异提示更新。"}]]}]]}],["$","span",null,{"children":["arXiv:","2309.16797"," · v1"," / REVIEWED ","2026.09.12"]}]]}]

15:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"model 生成批评文字，并不保证它准确识别了自己的错误。论文研究在没有答案标签、工具验证或其他 external feedback 时，已有 model 能否仅靠自身能力修正 reasoning，并排除评测协议带来的虚假增益。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Large Language Models Cannot Self-Correct Reasoning Yet · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"自纠错实验常把更多调用、Oracle 提示或外部工具与修订机制混在一起。本文问的是更窄的问题：没有外部正确性反馈的固定 LLM，能否仅凭自身判断改善 Reasoning？它提醒研究者为强结论准备匹配的信息与计算对照。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Large Language Models Cannot Self-Correct Reasoning Yet · v2","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"Self-Refine 研究当前答案的反馈修订，Reflexion 使用多种反馈与记忆，CRITIC 引入工具。本文区分 Intrinsic Self-correction 与带外部反馈的设置，重新检查 Prompt、Oracle Labels 和采样预算对结果的影响。不同研究的问题范围不完全相同。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2303.17651",{"href":"#reference-2303.17651","aria-label":"来源 2: Self-Refine: Iterative Refinement with Self-Feedback","children":["[",2,"]"]}],["$","a","2303.11366",{"href":"#reference-2303.11366","aria-label":"来源 3: Reflexion: Language Agents with Verbal Reinforcement Learning","children":["[",3,"]"]}],["$","a","2305.11738",{"href":"#reference-2305.11738","aria-label":"来源 4: CRITIC: Large Language Models Can Self-Correct with Tool-Interactive Critiquing","children":["[",4,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"若只挑错误答案进入修订，系统实际上已经获得了“哪些题错了”的信息。若修订比基线多用几倍调用，也不能确定收益来自诊断能力。先消除这些混淆，再统计 Wrong→Right 与 Right→Wrong，便能看见净变化来自哪里。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2303.17651",{"href":"#reference-2303.17651","aria-label":"来源 2: Self-Refine: Iterative Refinement with Self-Feedback","children":["[",2,"]"]}],["$","a","2303.11366",{"href":"#reference-2303.11366","aria-label":"来源 3: Reflexion: Language Agents with Verbal Reinforcement Learning","children":["[",3,"]"]}],["$","a","2305.11738",{"href":"#reference-2305.11738","aria-label":"来源 4: CRITIC: Large Language Models Can Self-Correct with Tool-Interactive Critiquing","children":["[",4,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],"$L19","$undefined","$L1a"]}]]]}]]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]

0-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2310.01798v2","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"Read PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"SUMMARY"}],["$","p",null,{"children":"通过去掉答案标签等外部帮助，检验 model 能否自行辨认 reasoning 错误，并强调停止规则、初始 prompt 和等预算 baseline 会改变结论。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Improvement Target"}],["$","dd",null,{"children":"Output Refinement & Feedback Reliability"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Feedback"}],["$","dd",null,{"children":"比较内生文字 feedback 与答案标签等 external feedback"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"Evidence Scope"}],["$","dd",null,{"children":"历史 model 的 reasoning 任务实验；不可 generalization 为所有 model 的永久定理"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"model 生成批评文字，并不保证它准确识别了自己的错误。论文研究在没有答案标签、工具验证或其他 external feedback 时，已有 model 能否仅靠自身能力修正 reasoning，并排除评测协议带来的虚假增益。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"判断何时应保留正确答案，本身就是 self-correction 的关键能力。若研究者用真实标签阻止 model 把正确答案改错，便给循环注入了强外部信息；这种成绩不能直接归因于 model 独立 reflection。"}]]}]]}],["$","section","observation",{"id":"observation","children":["$L10","$L11"]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","span",null,{"className":"reading-section-number","children":["0",3]}]
11:["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"正文记录到正确答案被改错的比例可能高于错误答案被修正的比例；一些收益在移除标签指导后消失。作者还发现，额外调用次数与更充分的 feedback prompt 会影响比较，必须同时控制这些因素。"}]]}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"对比有 oracle 标签和纯 intrinsic feedback 的生成—批评—再回答流程，在数学、常识和 multi-hop 问答任务上测试多个 model 与 prompt。进一步用相近调用预算的 self-consistency 方法，以及更完整的初始 prompt 作对照。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"在所评估的历史 model 和 reasoning 设置中，intrinsic self-correction 通常没有稳定增益，部分实验出现性能下降。论文将问题定位到判断答案正确性的困难，而不是断言所有 feedback、所有任务或未来 model 都无法改进。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"该结论有明确的时间、model 与任务范围，不能作为新一代 model 的免检结论。作者承认可验证 external feedback，以及风格或偏好调整等任务中 self-correction 的作用；本条核读方法、结果和局限，未复现实验。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：在当前 model 上应重测错误发现、定位、修正和保留正确答案四种能力，并使用相同 inference budget。还可比较独立 verifier 与同 model reflection，量化额外 feedback 究竟贡献了多少可靠信息。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"编者归类：这是阅读 Self-Refine、Reflexion 和 self-rewarding 工作的关键对照，提醒读者追问 feedback 来自哪里、谁决定停止。它为 RSI 中的评价可靠性提供经验边界，并不构成通用 RSI 不可能的证明。"}]]}]

ng-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"智能体的提示、反思步骤和工具组合通常依赖人工调试，搜索范围又容易被固定模板限制。论文研究能否把完整智能体设计写成代码，让另一个智能体持续发现可复用且表现更好的结构。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"代码能够同时表达提示、条件分支、循环和模块调用，比只改一段提示提供更大的设计空间。历史候选不必立刻成为最优解，也可能作为后续组合的中间材料，因此档案的价值超出保存冠军。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],"$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","h2",null,{"children":["关键观察",false]}]
11:["$","p",null,{"children":"正文的搜索轨迹显示，多样反馈、特定属性评价和组合答案等设计先后出现，后来被融合到更好的智能体中。部分早期设计自身成绩有限，却为后续复杂反馈机制提供了可继承的构件。"}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"Meta Agent Search根据档案生成设计说明和forward函数，进行新颖性反思，再在验证任务上执行。错误反馈触发修复，候选代码与分数写入档案；多轮搜索后，在保留测试集及跨模型任务上评估。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"作者报告在阅读理解、数学、科学等任务上超过所比较的人工设计基线，并观察到部分跨任务及跨模型迁移。正文同时指出不同领域增益并不相同，基础模型知识不足会限制结构搜索带来的提升。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"实验仍采用人为提供的模型接口、验证集、基础框架和搜索轮数；代码空间理论上丰富不等于有限预算可遍历全部设计。本条核读方法与实验章节，未复现实验，也未逐项审计生成智能体。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：值得进一步测试档案规模、验证集过拟合和搜索成本的关系，并把生成的设计迁移到长程真实任务。若要提出更强RSI主张，还需让改进器接受可验证修改并测量后续搜索效率。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"固定元智能体利用历史档案搜索可保存、复用的任务智能体实现，属于持久系统优化。改进对象是任务智能体的代码；元智能体与搜索流程没有由新发现的智能体替代，不能据此声称改进器已递归自修改。"}]]}]
17:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"来源与核验范围"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。核心洞察、局限分析、关联分类与未来展望含本站解读；论文观察与实验结果在其原始设置下成立。摘要级核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2408.08435",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2408.08435","target":"_blank","rel":"noreferrer","children":["arXiv 原始论文"," ↗"]}],["$","span",null,{"children":"摘要与元数据"}]]}],["$","li","https://arxiv.org/html/2408.08435v2",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2408.08435v2","target":"_blank","rel":"noreferrer","children":["方法与实验正文"," ↗"]}],["$","span",null,{"children":"正文第2至4节核读；未复现"}]]}],["$","li","https://arxiv.org/html/2408.08435v2#S3",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2408.08435v2#S3","target":"_blank","rel":"noreferrer","children":["arXiv：分类与更新范围核验"," ↗"]}],["$","span",null,{"children":"核对论文的优化目标、被冻结的组件、更新范围及与系统自修改的区别。"}]]}]]}],["$","span",null,{"children":["arXiv:","2408.08435"," · v2"," / REVIEWED ","2026.09.12"]}]]}]

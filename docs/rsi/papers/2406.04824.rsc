14:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
15:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"Bayesian optimization 下一次试验的位置由 acquisition function 决定，但不同问题需要不同的探索与利用平衡。论文研究能否自动发现可读的 acquisition function，减少人工设计，同时让新函数适用于训练之外的目标问题。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Bayesian Optimization 用少量昂贵函数评估寻找好解，Acquisition Function 决定下一次试哪里。不同问题适合不同探索策略，手工设计一个通用函数很难。FunBO 研究通过 LLM 代码搜索发现可读、可迁移的 Acquisition Functions。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch · v2","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"OPRO 展示 LLM 可根据历史分数优化候选，STOP 展示程序形式的改进器优化。FunBO 采用 FunSearch 的程序数据库与生成框架，将搜索对象具体化为 BO 内部的 Acquisition Function。它优化一个供外部任务使用的算法组件，未据此更新自己的 LLM 搜索器。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2309.03409",{"href":"#reference-2309.03409","aria-label":"来源 2: Large Language Models as Optimizers","children":["[",2,"]"]}],["$","a","2310.02304",{"href":"#reference-2310.02304","aria-label":"来源 3: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Acquisition Function 往往是预测均值、不确定性和当前最好值的一个短公式。LLM 能生成这种代码，BO 回合又能客观比较公式好坏，因此可以把公式设计转成程序搜索。难点是某个函数在有限训练目标上有效，是否仍适合尺度、维度和形状不同的新目标。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2309.03409",{"href":"#reference-2309.03409","aria-label":"来源 2: Large Language Models as Optimizers","children":["[",2,"]"]}],["$","a","2310.02304",{"href":"#reference-2310.02304","aria-label":"来源 3: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"可以把优化 strategy 本身当作程序 search 对象，再用它真正驱动一轮优化后的表现来打分。编辑理解是，评价必须落在下游 search 效率；公式看似新颖或代码更复杂，不能直接说明它是更好的优化算法。"}],"$undefined",["$","div",null,{"className":"block-citations","children":["$L1a"]}]]}]]]}]]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"阅读已固定版本的原文 Background、方法与主要结果，结合下列相关文献撰写。Paper Claim 表示作者报告，未独立复现；Inference 包括数学教学推演与 Idea Reconstruction。One-Week Reproduction、Counterexample 和 Follow-up 均为待执行提案，Novelty 尚需更全面的文献与实验检验。"}],["$","ol",null,{"children":[["$","li","paper",{"id":"reference-paper","children":[["$","a",null,{"href":"https://arxiv.org/html/2406.04824v2","target":"_blank","rel":"noreferrer","children":["[",1,"] ","FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch · v2"," ↗"]}],["$","span",null,{"children":"原文 Background、Method / Formalization 与主要实验或理论结论。数字沿用原文设置；未独立运行完整实验。"}]]}],["$","li","2309.03409",{"id":"reference-2309.03409","children":[["$","a",null,{"href":"https://arxiv.org/abs/2309.03409v3","target":"_blank","rel":"noreferrer","children":["[",2,"] ","Large Language Models as Optimizers"," ↗"]}],["$","span",null,{"children":"相关方法与研究背景；用于说明具体差异，不能替代对本篇结论的验证。"}]]}],["$","li","2310.02304",{"id":"reference-2310.02304","children":[["$","a",null,{"href":"https://arxiv.org/abs/2310.02304v3","target":"_blank","rel":"noreferrer","children":["[",3,"] ","Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation"," ↗"]}],["$","span",null,{"children":"相关方法与研究背景；用于说明具体差异，不能替代对本篇结论的验证。"}]]}]]}],["$","span",null,{"children":["arXiv:","2406.04824"," · ","v2"," / REVIEWED ","2026.09.13"]}]]}]

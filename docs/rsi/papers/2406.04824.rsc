ldren":[["$","span",null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"贝叶斯优化下一次试验的位置由采集函数决定，但不同问题需要不同的探索与利用平衡。论文研究能否自动发现可读的采集函数，减少人工设计，同时让新函数适用于训练之外的目标问题。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"可以把优化策略本身当作程序搜索对象，再用它真正驱动一轮优化后的表现来打分。编辑理解是，评价必须落在下游搜索效率；公式看似新颖或代码更复杂，不能直接说明它是更好的优化算法。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],"$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","h2",null,{"children":["关键观察",false]}]
11:["$","p",null,{"children":"正文展示一个结合已有探索思想的新采集函数，在局部极值较多的示例中继续探索。不同任务的收益并不一致：超参数实验里，一类任务出现优势，另一类与基线相近，体现目标分布的重要性。"}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"系统从历史程序库选取采集函数组成提示，让模型生成新实现，执行贝叶斯优化并按训练目标上的表现评分。多样化程序保留供下一轮采样，最后在较好候选中以验证目标选择输出函数。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"作者在全局优化与超参数优化设置中报告可竞争或更好的收敛表现，也测试训练分布之外的函数。输出具有可分析的代码形式；这说明算法产物能够迁移，并未展示生成模型或程序搜索器自身更新。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"输入输出形式、目标函数集合、评价过程与搜索框架由研究者指定，搜到的是外部贝叶斯优化组件。发现一个更好的采集函数，不等于负责发现它的智能体变强，也不提供持续递归改进的证据。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：可追踪采集函数从离线函数库到昂贵真实实验的收益，并报告搜索本身的成本与回本条件。进一步让发现的策略影响后续算法搜索，可检验改进是否回流到产生它的系统。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"编辑归类为相关产物优化：自动发现优化策略是 RSI 可能利用的算法研发环节。只有当产物被用于下一轮系统研发，并在统一预算下提高后续发现能力，才会形成更接近递归增强的证据链。"}]]}]
17:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"来源与核验范围"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。核心洞察、局限分析、关联分类与未来展望含本站解读；论文观察与实验结果在其原始设置下成立。摘要级核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2406.04824",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2406.04824","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"题名、作者、首次日期、v2 日期和实验范围。"}]]}],["$","li","https://arxiv.org/html/2406.04824v2",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2406.04824v2","target":"_blank","rel":"noreferrer","children":["程序搜索方法与实验"," ↗"]}],["$","span",null,{"children":"第 3 节、OOD-bench、ID-bench 和 HPO-ID 实验段落：候选选择、函数迁移及任务差异。"}]]}]]}],["$","span",null,{"children":["arXiv:","2406.04824"," · v2"," / REVIEWED ","2026.09.12"]}]]}]

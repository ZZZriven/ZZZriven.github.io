1b:["$","section","method",{"id":"method","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"05"}],["$","div",null,{"children":[["$","h2",null,{"children":"Method & Worked Example"}],["$","p",null,{"className":"section-question","children":"沿着输入、处理、输出走完 Pipeline。"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"系统从历史程序库选取 acquisition function 组成 prompt，让 model 生成新实现，执行 Bayesian optimization 并按训练目标上的表现评分。多样化程序保留供下一轮采样，最后在较好候选中以验证目标选择输出函数。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"沿用论文全局优化设置：输入一组辅助目标函数和初始 Acquisition Function；LLM 根据数据库中已有函数代码产生候选；每个候选在训练目标上驱动 BO，依据最终优化结果评分并回存。输出是可明确写出的 Acquisition Formula，再用于未见函数和 Hyperparameter Optimization。内层 BO 更新 Surrogate，外层搜索仍是既定流程。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
1c:["$","section","mathematics",{"id":"mathematics","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"06"}],["$","div",null,{"children":[["$","h2",null,{"children":"Mathematical Foundations"}],["$","p",null,{"className":"section-question","children":"从符号、直觉与简单例子理解理论。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"BO 的 Surrogate 给候选点 x 预测均值 μ(x) 和不确定性 σ(x)。以最小化为例，Expected Improvement 衡量新点相对当前最好值 f_best 的潜在改善。下面是背景公式，不是 FunBO 声称唯一采用的发现公式。FunBO 搜索的正是类似这种将预测信息变成采样优先级的程序。"}],["$","pre",null,{"className":"math-block","aria-label":"数学表达式","children":"EI(x) = E[max(f_best − f(x), 0) | observed data]\nx_next = argmax_x acquisition(x)\nμ: predicted mean; σ: prediction uncertainty"}],["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"以最小化目标 f 为例，f_best 是目前见过的最小值。一个新点如果比它更小，改进量为 f_best−f(x)；如果更大，改进量记为 0。由于还没有真实评价 f(x)，Surrogate Model 给出它的预测分布，对这些可能改进求平均就得到 Expected Improvement。较好的预测均值 μ 和较大的不确定性 σ 都可能使一个点值得尝试。FunBO 搜索的是选择下一点的 Acquisition 程序；一次学到更好的选择规则，并不表示搜索该规则的外层过程也被更新。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
1d:["$","section","experiments",{"id":"experiments","children":[[["$","span","results",{"className":"anchor-alias","id":"results"}],["$","span","observation",{"className":"anchor-alias","id":"observation"}]],["$","span",null,{"className":"reading-section-number","children":"07"}],["$","div",null,{"children":[["$","h2",null,{"children":"Experiments & Claims"}],["$","p",null,{"className":"section-question","children":"Research Question → Experiment → Answer"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"Question：自动发现的 Acquisition Function 能否泛化？→ Experiment：在训练内外的全局优化函数和超参数任务上比较既有与发现的函数。→ Answer：作者报告有竞争力的表现；泛化范围仍取决于训练目标集合、Surrogate 与评估预算。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"作者在全局优化与超参数优化设置中报告可竞争或更好的收敛表现，也测试训练分布之外的函数。输出具有可分析的代码形式；这说明算法产物能够迁移，并未展示生成 model 或程序 search 器自身更新。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
1e:["$","section","takeaways",{"id":"takeaways","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"08"}],["$","div",null,{"children":[["$","h2",null,{"children":"Takeaways"}],["$","p",null,{"className":"section-question","children":"这篇论文改变了哪些判断？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"FunBO 将算法设计变成可审查的短程序产物。区分内层 BO 的数据更新与外层 LLM 搜索过程，能避免把“优化了优化算法”直接当成闭合 RSI。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
1f:["$","section","assumptions",{"id":"assumptions","children":[[["$","span","limits",{"className":"anchor-alias","id":"limits"}]],["$","span",null,{"className":"reading-section-number","children":"09"}],["$","div",null,{"children":[["$","h2",null,{"children":"Most Fragile Assumption"}],["$","p",null,{"className":"section-question","children":"哪一个假设失效会动摇方法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"最脆弱的假设是辅助目标反映了部署问题的探索需求。训练函数的光滑性、维度与尺度若过于单一，发现的规则可能只利用这些特征。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"输入输出形式、objective function 集合、评价过程与 search 框架由研究者指定，搜到的是外部 Bayesian optimization 组件。发现一个更好的 acquisition function，不等于负责发现它的 Agent 变强，也不提供持续 recursive optimization 的证据。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
20:["$","section","reproduction",{"id":"reproduction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"10"}],["$","div",null,{"children":[["$","h2",null,{"children":"One-Week Reproduction"}],["$","p",null,{"className":"section-question","children":"用一周检验一个最小且明确的命题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"Day 1–2：实现 GP-based BO 与 EI Baseline，选三类解析函数。Day 3–5：搜索十个短 Acquisition Programs，统一评估次数。Day 6–7：在变维、缩放和含噪函数上测试，比较 Simple Regret 与稳定性。"}],"$undefined",null]}]]]}]]}]
21:["$","section","counterexample",{"id":"counterexample","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"11"}],["$","div",null,{"children":[["$","h2",null,{"children":"Counterexample Design"}],["$","p",null,{"className":"section-question","children":"如何构造有辨识力的反例？"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"对同一个目标做正比例缩放和平移，最优点不变。如果发现的 Acquisition Function 因绝对数值尺度改变而显著退步，就能识别缺少尺度不变性的捷径。"}],"$undefined",null]}]]]}]]}]
22:["$","section","follow-up",{"id":"follow-up","children":[[["$","span","outlook",{"className":"anchor-alias","id":"outlook"}]],["$","span",null,{"className":"reading-section-number","children":"12"}],["$","div",null,{"children":[["$","h2",null,{"children":"Follow-up Research"}],["$","p",null,{"className":"section-question","children":"从缺陷与需求推导新的研究问题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"研究可证明不变性的算法发现：将平移、尺度和维度结构作为变换群，搜索仅满足必要不变量的 Acquisition Programs，并测是否改善跨问题迁移。相对 OPRO 的自由候选生成，这尝试把领域结构变成搜索空间约束；关键是证明约束保留了有价值的策略。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2309.03409",{"href":"#reference-2309.03409","aria-label":"来源 2: Large Language Models as Optimizers","children":["[",2,"]"]}],["$","a","2310.02304",{"href":"#reference-2310.02304","aria-label":"来源 3: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation","children":["[",3,"]"]}]]}]]}]]]}]]}]

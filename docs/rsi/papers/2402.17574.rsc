",null,{"children":"Loop Role"}],["$","dd",null,{"children":"Solver"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Persistence"}],["$","dd",null,{"children":"Across Tasks"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Recursive Reuse"}],["$","dd",null,{"children":"Not Demonstrated"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Evidence"}],["$","dd",null,{"children":"Task Gain"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"System Boundary"}],["$","dd",null,{"children":"Persistent Policy Prompts & World Beliefs；以该论文实际可更新组件为边界，固定部分见下方判定。"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Feedback"}],["$","dd",null,{"children":"完整博弈轨迹、终局信息、玩家得分及相同条件重放的收益。"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Evidence Scope"}],["$","dd",null,{"children":"prompt 更新与候选 search 框架由设计者固定，foundation model 没有 gradient 训练。牌局收益受到对手与随机性影响，不能仅凭一次高收益认定 policy 更优；world belief 也只是 model 的可修订假设，并非真实隐藏状态。 已核验固定版本的相关方法与主要结果；未独立复现。"}]]}]]}],"$L10","$L11"]}]]]}],"$L12","$L13","$L14","$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]

14:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
15:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"多步博弈的 reward 延迟出现，Agent 还看不到对手全部状态，逐动作 reflection 很难判断失败源头。论文研究如何利用整局结果检查关于自身与对手的信念，并把教训提炼为之后仍可使用的 policy。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agent-Pro: Learning to Evolve via Policy-Level Reflection and Optimization · v3","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"交互游戏中的好行动依赖对规则、对手和自身状态的判断。只在某个动作后反思，容易忽略造成多次错误的 Policy-level Belief。Agent-Pro 研究从整段经历修订这些信念和策略，并以搜索选择能提高收益的 Prompt。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agent-Pro: Learning to Evolve via Policy-Level Reflection and Optimization · v3","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"Reflexion 保存语言反思，OPRO 根据反馈优化 Prompt。Agent-Pro 结合 Belief-aware Decision Making、Policy-level Reflection 与 DFS-based Policy Evolution，主要通过 Context 中的策略指令变化学习，而非 Model Weight Fine-Tuning。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2303.11366",{"href":"#reference-2303.11366","aria-label":"来源 2: Reflexion: Language Agents with Verbal Reinforcement Learning","children":["[",2,"]"]}],["$","a","2309.03409",{"href":"#reference-2309.03409","aria-label":"来源 3: Large Language Models as Optimizers","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"一次失败行动可能只是错误世界模型的表面症状。例如持续高估对手弃牌概率，会影响很多下注决定。先把行为背后的信念显式化，再回顾多轮轨迹检查信念，便能修改一类行动而非一条动作。之后需要重复对局，因为单局输赢并不足以评价策略。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2303.11366",{"href":"#reference-2303.11366","aria-label":"来源 2: Reflexion: Language Agents with Verbal Reinforcement Learning","children":["[",2,"]"]}],["$","a","2309.03409",{"href":"#reference-2309.03409","aria-label":"来源 3: Large Language Models as Optimizers","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"行为失误可能来自对局面的错误理解，修订单个动作未必改变这一根源。Agent-Pro 把 world modeling 与行为准则写入持久 prompt；编辑理解是，优化对象由一次选择转为产生一类选择的决策规则。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agent-Pro: Learning to Evolve via Policy-Level Reflection and Optimization · v3","children":["[",1,"]"]}]]}]]}]]]}]]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]

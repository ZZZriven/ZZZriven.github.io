1a:["$","aside",null,{"className":"reading-sidebar","children":["$","div",null,{"className":"reading-sidebar-inner","children":[["$","p",null,{"className":"overline","children":"12 QUESTIONS"}],["$","nav",null,{"aria-label":"论文阅读目录","children":[[["$","a","problem",{"href":"#problem","children":[["$","span",null,{"children":"01"}],"Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":[["$","span",null,{"children":"02"}],"Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":[["$","span",null,{"children":"03"}],"Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":[["$","span",null,{"children":"04"}],"Core Intuition"]}],["$","a","method",{"href":"#method","children":[["$","span",null,{"children":"05"}],"Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":[["$","span",null,{"children":"06"}],"Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":[["$","span",null,{"children":"07"}],"Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":[["$","span",null,{"children":"08"}],"Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":[["$","span",null,{"children":"09"}],"Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":[["$","span",null,{"children":"10"}],"One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":[["$","span",null,{"children":"11"}],"Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":[["$","span",null,{"children":"12"}],"Follow-up Research"]}]],["$","a",null,{"href":"#rsi-relation","children":"Classification & RSI Relation"}],["$","a",null,{"href":"#sources","children":"Sources & Verification"}]]}]]}]}]
1b:["$","section","method",{"id":"method","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"05"}],["$","div",null,{"children":[["$","h2",null,{"children":"Method & Worked Example"}],["$","p",null,{"className":"section-question","children":"沿着输入、处理、输出走完 Pipeline。"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"初始 improver 多次调用 language model 并按 utility function 选择候选，然后将它自身作为下一轮的优化输入。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation · v3","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"沿用原文程序优化任务的接口，作一个简化演示：输入是初始求解程序 s、评分器 u 和固定 LLM。Seed Improver 采样多个改写版本，执行评分后返回最好者。Meta 阶段把 s 换成 Improver 源码，把 u 换成“它改进一组程序后的平均得分”。输出可能是带 Beam Search 或候选重用的新 Improver；随后用这个新版继续优化自身。原文确实分析了多种此类搜索策略，具体简化输入并非原文样本。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation · v3","children":["[",1,"]"]}]]}]]}]]]}]]}]
1c:["$","section","mathematics",{"id":"mathematics","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"06"}],["$","div",null,{"children":[["$","h2",null,{"children":"Mathematical Foundations"}],["$","p",null,{"className":"section-question","children":"从符号、直觉与简单例子理解理论。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"先区分两层函数。u(s) 给一个解打分；I(u,s,L) 接收评分器、原解和 LLM，返回新解。把 I 放到多道任务上，平均最终得分得到 Meta-Utility。于是 I 也可以被自身当作字符串程序修改。递归写法定义了一个过程，不能单凭公式推出每步必然增益；有限样本 Meta-Utility 与真实任务分布之间还存在泛化误差。"}],["$","pre",null,{"className":"math-block","aria-label":"数学表达式","children":"s′ = I(u, s, L)\nû(I) = (1/|D|) Σ_(u,s)∈D u(I(u,s,L))\nI_(t+1) = I_t(û, I_t, L)"}],["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation · v3","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"先看内层：u 是给程序打分的函数，s 是待改程序，L 是可调用的语言模型；I 返回修改后的 s′。第二式把一组任务 D 中这些修改结果的分数取平均，从而得到给 Improver 打分的函数 û。最后，将待改程序的位置换成 I_t 自己，并将评分函数换成 û，输入输出类型就闭合了。比如 I_t 原来只提一个候选，修改后会提三个候选并择优，下一轮就能用这个新过程继续修改 Improver。候选数增加也增加成本，因此更高分需要与等预算搜索比较。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation · v3","children":["[",1,"]"]}]]}]]}]]]}]]}]
1d:["$","section","experiments",{"id":"experiments","children":[[["$","span","results",{"className":"anchor-alias","id":"results"}],["$","span","observation",{"className":"anchor-alias","id":"observation"}]],["$","span",null,{"className":"reading-section-number","children":"07"}],["$","div",null,{"children":[["$","h2",null,{"children":"Experiments & Claims"}],["$","p",null,{"className":"section-question","children":"Research Question → Experiment → Answer"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"Question：改进后的 Improver 是否更能帮助下游任务？→ Experiment：比较 Seed 与演化 Improver 在程序优化任务上的效用，并分析产生的搜索策略和迁移。→ Answer：作者报告有限任务上的增益，同时单独检查了生成代码尝试绕过 Sandbox 的行为；性能实验不等于对所有程序的安全或泛化保证。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation · v3","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"作者在一组下游任务中观察到，演化后的 improver 生成的程序优于初始 improver 的产出。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation · v3","children":["[",1,"]"]}]]}]]}]]]}]]}]
1e:["$","section","takeaways",{"id":"takeaways","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"08"}],["$","div",null,{"children":[["$","h2",null,{"children":"Takeaways"}],["$","p",null,{"className":"section-question","children":"这篇论文改变了哪些判断？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"STOP 的关键是把 Improver Quality 定义为它让别人变好的程度。它不要求更新 LLM Weights，但也没有覆盖全系统。读代码时要追踪两层预算：优化 Improver 的成本，以及使用它解决每个新任务的成本。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation · v3","children":["[",1,"]"]}]]}]]}]]]}]]}]
1f:["$","section","assumptions",{"id":"assumptions","children":[[["$","span","limits",{"className":"anchor-alias","id":"limits"}]],["$","span",null,{"className":"reading-section-number","children":"09"}],["$","div",null,{"children":[["$","h2",null,{"children":"Most Fragile Assumption"}],["$","p",null,{"className":"section-question","children":"哪一个假设失效会动摇方法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"最脆弱的假设是训练任务上的平均改进效用能代表未来任务。Improver 可能学会利用评分器结构，或把计算量集中在少量容易高分的任务上；这会提高 Meta-Utility，却削弱通用性。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation · v3","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"论文明确说明 base language model 没有改变，因此这不构成完整的 Recursive Self-Improvement。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation · v3","children":["[",1,"]"]}]]}]]}]]]}]]}]
20:["$","section","reproduction",{"id":"reproduction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"10"}],["$","div",null,{"children":[["$","h2",null,{"children":"One-Week Reproduction"}],["$","p",null,{"className":"section-question","children":"用一周检验一个最小且明确的命题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"Day 1–2：写五类简单程序任务及隐藏输入。Day 3–5：用固定 LLM、固定调用上限比较 Seed Best-of-N 与两轮自我修改的 Improver。Day 6–7：在未见函数族上评估，每次记录实际 LLM 调用和执行次数。只检验搜索策略的迁移，不以几次成功推断无界 RSI。"}],"$undefined",null]}]]]}]]}]
21:["$","section","counterexample",{"id":"counterexample","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"11"}],["$","div",null,{"children":[["$","h2",null,{"children":"Counterexample Design"}],["$","p",null,{"className":"section-question","children":"如何构造有辨识力的反例？"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"令训练评分器总是先执行小输入，而隐藏任务包含超大输入及失败超时。一个学会加大无意义搜索或利用固定测试顺序的 Improver 可能在训练上很好。严格控制执行预算后若优势消失，就能将机制收益与预算利用区分。"}],"$undefined",null]}]]]}]]}]
22:["$","section","follow-up",{"id":"follow-up","children":[[["$","span","outlook",{"className":"anchor-alias","id":"outlook"}]],["$","span",null,{"className":"reading-section-number","children":"12"}],["$","div",null,{"children":[["$","h2",null,{"children":"Follow-up Research"}],["$","p",null,{"className":"section-question","children":"从缺陷与需求推导新的研究问题。"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"后续相关工作 HyperAgents 已研究可编辑 Meta-Agent，并用受控的 Improvement@k 比较产生更好后继的能力。因此，仅增加 Improver 评测不足以支撑新颖性。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2603.19461v1",{"href":"#reference-2603.19461v1","aria-label":"来源 4: HyperAgents","children":["[",4,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"把 Improver 视为带适用条件的程序：自动发现哪些任务结构适合 Beam Search、局部编辑或重启，并输出可检验的选择条件。相对 OPRO 的候选优化，这研究的是改进策略的可迁移选择定律。关键验证是换一类任务后，这些条件仍能预测策略优势；若只能记忆训练任务名称，就没有得到结构性知识。 相对 HyperAgents，待检验的缺口是改进机制在何种条件下可分解、移植与继承；需要同起点、同预算的组件交叉实验，识别机制作用及交互项。这个缺口尚未完成穷尽式检索，不能宣称已确认 Novelty。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2210.03629",{"href":"#reference-2210.03629","aria-label":"来源 2: ReAct: Synergizing Reasoning and Acting in Language Models","children":["[",2,"]"]}],["$","a","2309.03409",{"href":"#reference-2309.03409","aria-label":"来源 3: Large Language Models as Optimizers","children":["[",3,"]"]}],["$","a","2603.19461v1",{"href":"#reference-2603.19461v1","aria-label":"来源 4: HyperAgents","children":["[",4,"]"]}]]}]]}]]]}]]}]

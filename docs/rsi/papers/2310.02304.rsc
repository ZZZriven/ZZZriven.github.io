],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"不仅优化目标程序，还让负责优化的程序本身变得更好，是否可行？"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"STOP 将程序改进器本身作为待优化程序，递归目标因而从一次解题转向如何更好地搜索解法。改进是否有效由下游效用判断，保存的是新的优化代码；这里可递归改变的是组织语言模型调用的算法，而非语言模型的参数。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],"$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","h2",null,{"children":["关键观察",false]}]
11:["$","p",null,{"children":"摘要报告演化后的改进器在一小组下游任务上胜过初始版本，出现了束搜索、遗传算法、模拟退火等策略。作者同时明确语言模型本身未变化，因此实验展示了程序层面的递归优化，也留下了模型能力能否突破原有边界的问题。"}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"初始改进器多次调用语言模型并按效用函数选择候选，然后将它自身作为下一轮的优化输入。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"作者在一组下游任务中观察到，演化后的改进器生成的程序优于初始改进器的产出。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"论文明确说明基础语言模型没有改变，因此这不构成完整的递归自我改进。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：需要在从未用于优化改进器的任务上测量收益，并将模型调用次数与搜索预算纳入比较。还可检验改进器是否能反复产生更好的后继版本，区分偶然找到一个高分程序与稳定提升后续优化能力这两种情况。"}]]}]]}]

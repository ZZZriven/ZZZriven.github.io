problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"不仅优化目标程序，还让负责优化的程序本身变得更好，是否可行？"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"STOP 将程序 improver 本身作为待优化程序，recursive objective 因而从一次解题转向如何更好地 search 解法。改进是否有效由下游效用判断，保存的是新的优化代码；这里通过 recursion 改变的是组织 language model 调用的算法，而非 language model 的参数。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],"$L10"]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"摘要报告演化后的 improver 在一小组下游任务上胜过初始版本，出现了 beam search、genetic algorithm、simulated annealing 等 strategy。作者同时明确 language model 本身未变化，因此实验展示了程序层面的 recursive optimization，也留下了 model 能力能否突破原有边界的问题。"}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"初始 improver 多次调用 language model 并按 utility function 选择候选，然后将它自身作为下一轮的优化输入。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"作者在一组下游任务中观察到，演化后的 improver 生成的程序优于初始 improver 的产出。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"论文明确说明 base language model 没有改变，因此这不构成完整的 Recursive Self-Improvement。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：需要在从未用于优化 improver 的任务上测量收益，并将 model 调用次数与 search 预算纳入比较。还可检验 improver 是否能反复产生更好的后继版本，区分偶然找到一个高分程序与稳定提升后续优化能力这两种情况。"}]]}]]}]

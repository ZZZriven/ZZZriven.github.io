 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv 原文",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2212.08073v1","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"阅读 PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"ABSTRACT / 摘要"}],["$","p",null,{"children":"将人写原则转为自批评、答案修订与 AI 偏好标签，再通过监督学习和强化学习训练更少有害行为的助手。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"改进对象"}],["$","dd",null,{"children":"模型权重与偏好模型"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"反馈来源"}],["$","dd",null,{"children":"人写原则指导自批评与 AI 有害性偏好；有用性仍包含人类反馈；偏好模型把比较标签转为强化学习奖励。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"证据边界"}],["$","dd",null,{"children":"已核验 arXiv 摘要与 v1 历史，正文第 3.5 节批评消融及第 4.1 节 AI 反馈流程；未复现实验。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"逐条收集有害性偏好标签难以覆盖不断变化的模型回答。论文研究能否用一组人写原则指导模型批评、修订与比较回答，把人工监督从密集标注转到较紧凑的行为准则，同时维持助手的有用性与正常交流。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"监督不必始终表现为人工给出的正确答案，也可以先规定比较准则，再让模型把准则应用到具体样本。修订数据改善生成行为，比较数据训练奖励来源；两类反馈承担不同职责，需要分别检查它们是否可靠。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],"$L10"]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],["$","h2",null,{"children":["关键观察",false]}],["$","p",null,{"children":"正文显示，显式批评对较小模型的修订更有帮助，较大模型直接修订也能获得相近收益；批评本身有时夸大或判断不准。AI 比较经过思维链后还可能过度自信，说明解释更长并不自动意味着反馈更校准。"}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"先按原则让模型批评并修订初始回答，用修订结果监督微调；再对模型回答对生成 AI 有害性偏好，训练偏好模型并用其奖励做强化学习。原实验仍保留有用性的人类反馈，AI 标签主要替代有害性标注。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"作者报告，经训练的助手在有害性与回避性评价之间取得更好的折中，能够解释为何拒绝有害请求。主要贡献是降低特定监督维度对逐条人工标签的需求，实验并未证明所有监督都可以移除。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"原则由人制定，有用性训练仍用人工标签，反馈模型也不等同于完全独立的真值来源。原则冲突、反馈偏差及奖励过拟合都会影响结果；无害性提升不能直接当作通用推理能力提升，更不能当作开放式递归增长。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：值得把原则冲突、罕见场景与反馈模型偏差纳入单独的留出评价，追踪训练轮次增加时有用性是否退化。下一步应检验反馈器更新能否改善独立评价，而非只增加对既定原则措辞的迎合。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"自批评产物进入同一助手后续训练，模型更新被保留，归为持久系统优化。训练框架及原则由研究者设定，论文没有让系统自主修改承担下一轮训练的算法，因此不归为改进器自修改。"}]]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"来源与核验范围"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。核心洞察、局限分析、关联分类与未来展望含本站解读；论文观察与实验结果在其原始设置下成立。摘要级核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2212.08073",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2212.08073","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要与提交历史：题名、作者、日期、两阶段训练与有害性评价结论。"}]]}],["$","li","https://arxiv.org/html/2212.08073v1",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2212.08073v1","target":"_blank","rel":"noreferrer","children":["监督来源与反馈校准"," ↗"]}],["$","span",null,{"children":"全文第 3.5 节：批评与直接修订；第 4.1 节：有用性人类标签、有害性 AI 标签及偏好置信度处理。"}]]}]]}],["$","span",null,{"children":["arXiv:","2212.08073"," · v1"," / REVIEWED ","2026.09.12"]}]]}]

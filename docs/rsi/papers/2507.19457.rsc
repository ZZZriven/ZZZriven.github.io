15:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
16:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"稀疏标量 reward 通常不能直接说明失败原因，reinforcement learning 适配新任务又可能需要大量轨迹。论文研究能否从少量可读执行信息中提炼高层规则，并通过 prompt 更新提高单个或复合 LLM 系统的表现。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Scalar Reward 把一个复杂失败压成一个数，丢掉工具报错、误解约束和中间决策等线索。GEPA 研究能否用语言 Reflection 把少量 Trajectory 转成可保留的 Prompt 改进，并通过保留互补候选避免过早集中在一个方案。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning · v2","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"TextGrad 已通过文本反馈更新系统变量，Promptbreeder 已演化 Prompt 及 Mutation Prompt。GEPA 重点在完整执行轨迹的诊断、候选选择和互补经验合并。其主流程更新目标系统 Prompts，固定 Reflection 与选择程序并未因此成为已验证的自我修改 Improver。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2406.07496",{"href":"#reference-2406.07496","aria-label":"来源 2: TextGrad: Automatic \"Differentiation\" via Text","children":["[",2,"]"]}],["$","a","2309.16797",{"href":"#reference-2309.16797","aria-label":"来源 3: Promptbreeder: Self-Referential Self-Improvement Via Prompt Evolution","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"一次失败的日志常直接暴露修复方向，比试出许多微小参数变化更便宜。但一条新规则可能帮助一类任务、损害另一类任务，因此不应只保留平均分最高的 Prompt。保留在不同样本上有优势的候选，再尝试合并互补规则，就形成 Reflection 与 Pareto Selection 的组合。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2406.07496",{"href":"#reference-2406.07496","aria-label":"来源 2: TextGrad: Automatic \"Differentiation\" via Text","children":["[",2,"]"]}],["$","a","2309.16797",{"href":"#reference-2309.16797","aria-label":"来源 3: Promptbreeder: Self-Referential Self-Improvement Via Prompt Evolution","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"轨迹中包含的错误位置、工具返回和 reasoning 过程，比一个最终分数提供更多可操作信息。reflection model 可将这些信息压缩成修改建议，而保留不同任务子集上的优势候选，有利于积累互补经验。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning · v2","children":["[",1,"]"]}]]}]]}]]]}]]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]

n":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"稀疏标量 reward 通常不能直接说明失败原因，reinforcement learning 适配新任务又可能需要大量轨迹。论文研究能否从少量可读执行信息中提炼高层规则，并通过 prompt 更新提高单个或复合 LLM 系统的表现。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"轨迹中包含的错误位置、工具返回和 reasoning 过程，比一个最终分数提供更多可操作信息。reflection model 可将这些信息压缩成修改建议，而保留不同任务子集上的优势候选，有利于积累互补经验。"}]]}]]}],["$","section","observation",{"id":"observation","children":["$L10","$L11"]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]

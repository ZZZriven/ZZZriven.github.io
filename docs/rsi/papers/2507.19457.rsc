1b:["$","section","method",{"id":"method","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"05"}],["$","div",null,{"children":[["$","h2",null,{"children":"Method & Worked Example"}],["$","p",null,{"className":"section-question","children":"沿着输入、处理、输出走完 Pipeline。"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"先选取候选系统并在小批任务上执行，记录轨迹和 feedback；reflection model 据此提出 prompt 变体并测试。候选池保留不同任务上的有效方案，并可合并互补模块，反复进行选择、mutation 和评价。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"沿用工具使用轨迹作教学演示：一个 Agent 误读 API 返回字段，Reflection 在真实错误日志中定位问题，修改该模块的 Prompt，强调字段语义与检查步骤。新候选先在 Minibatch 测试，再在更大评估集上记录逐题表现；有互补优势的候选可能被保留或合并。输出是更新后的 Prompt 集合，非 Model Weight Update。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
1c:["$","section","mathematics",{"id":"mathematics","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"06"}],["$","div",null,{"children":[["$","h2",null,{"children":"Mathematical Foundations"}],["$","p",null,{"className":"section-question","children":"从符号、直觉与简单例子理解理论。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Pareto 的核心是逐项比较。若候选 A 在所有测试样本上都不差于 B，且至少一项更好，A 支配 B。GEPA 利用逐任务优势保留多样候选。此处的“前沿”依赖有限样本，增加样本或换分布后可能改变；不能将开发集上的非支配性理解为总体最优。"}],["$","pre",null,{"className":"math-block","aria-label":"数学表达式","children":"A dominates B if sᵢ(A) ≥ sᵢ(B) for every i\nand sⱼ(A) > sⱼ(B) for at least one j"}],["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"用两个任务说明 Pareto。Prompt A 在两项任务的分数为 (0.9,0.5)，B 为 (0.7,0.8)，双方各有优势，不能互相 Dominate；C 为 (0.6,0.4)，则被 A 和 B 同时支配。保留 A 与 B 可以让后续修改利用不同专长，单纯用平均分挑一个胜者会丢掉这种差别。这里的二维数值是教学示例；真实搜索还取决于样本级表现、候选生成和预算，Pareto 保留本身不保证会找到更好的组合。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
1d:["$","section","experiments",{"id":"experiments","children":[[["$","span","results",{"className":"anchor-alias","id":"results"}],["$","span","observation",{"className":"anchor-alias","id":"observation"}]],["$","span",null,{"className":"reading-section-number","children":"07"}],["$","div",null,{"children":[["$","h2",null,{"children":"Experiments & Claims"}],["$","p",null,{"className":"section-question","children":"Research Question → Experiment → Answer"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"Question：文本 Reflection 能否用较少 Rollout 达到较强适应？→ Experiment：在多任务上比较相关 Prompt Optimizer 和 GRPO 设置，分析反思、选择及合并组件。→ Answer：作者报告样本效率与任务分数优势；Rollout 数量、Token 成本及训练计算是不同资源指标，不能互换。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"更新版摘要报告六项任务上平均优于 GRPO 约 6%，最多使用少 35 倍的轨迹，并超过 prompt optimization baseline MIPROv2。这些是论文给定 model 和预算下的结果，不能解读为 prompt optimization 普遍胜过所有 reinforcement learning 方法。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
1e:["$","section","takeaways",{"id":"takeaways","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"08"}],["$","div",null,{"children":[["$","h2",null,{"children":"Takeaways"}],["$","p",null,{"className":"section-question","children":"这篇论文改变了哪些判断？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"GEPA 的启发是把日志中的高信息量错误转成具体规则，并保留互补解。评估时同时记录 Reflection 所见数据、搜索次数和隐藏测试，才能判断规则是否真正泛化。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
1f:["$","section","assumptions",{"id":"assumptions","children":[[["$","span","limits",{"className":"anchor-alias","id":"limits"}]],["$","span",null,{"className":"reading-section-number","children":"09"}],["$","div",null,{"children":[["$","h2",null,{"children":"Most Fragile Assumption"}],["$","p",null,{"className":"section-question","children":"哪一个假设失效会动摇方法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"最脆弱的假设是 Reflection 能从少量失败定位可迁移原因。它可能将个例编成过度具体的指令，或根据偶然成功把错误规则加入 Prompt。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"本条核对 arXiv 摘要，未通读论文全文或复现实验。优化依赖 reflection model、可用轨迹及评价预算；保存 prompt 并不更新 foundation model 参数，减少轨迹数量也不必然等于同比例降低总算力成本。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
20:["$","section","reproduction",{"id":"reproduction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"10"}],["$","div",null,{"children":[["$","h2",null,{"children":"One-Week Reproduction"}],["$","p",null,{"className":"section-question","children":"用一周检验一个最小且明确的命题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"Day 1–2：构造带可检查工具调用的 40 个任务。Day 3–5：对比标量评分搜索、日志 Reflection、Reflection 加多候选选择。Day 6–7：在未见 API 参数组合上重测，统一总 Token Budget。"}],"$undefined",null]}]]]}]]}]
21:["$","section","counterexample",{"id":"counterexample","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"11"}],["$","div",null,{"children":[["$","h2",null,{"children":"Counterexample Design"}],["$","p",null,{"className":"section-question","children":"如何构造有辨识力的反例？"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"让错误日志中出现与正确答案偶然相关的标识符。若 Reflection 把标识符写成规则，开发集提高而打乱标识符后失效，就可辨认语义诊断与捷径学习。"}],"$undefined",null]}]]]}]]}]
22:["$","section","follow-up",{"id":"follow-up","children":[[["$","span","outlook",{"className":"anchor-alias","id":"outlook"}]],["$","span",null,{"className":"reading-section-number","children":"12"}],["$","div",null,{"children":[["$","h2",null,{"children":"Follow-up Research"}],["$","p",null,{"className":"section-question","children":"从缺陷与需求推导新的研究问题。"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"后续相关工作 DoCtOR 已将失败归因、反事实步骤修正与定向 Reflection 结合，用于 Multi-Agent Collaboration。单独提出因果归因或定向反思已有接近的研究。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2608.28264v1",{"href":"#reference-2608.28264v1","aria-label":"来源 4: Finding Where the Buck Stops: An Automated Failure Attribution-Based Reflection Framework for Multi-Agent Collaboration","children":["[",4,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"让 Reflection 输出一项可被主动干预检验的错误解释，先修改环境或输入来区分原因，再允许更新 Prompt。相对 TextGrad 的反馈传递，这将优化过程转为诊断实验设计。关键收益是减少错误规则累积，且必须在相同诊断预算下比较。 提案应进一步面对多个错误相互抵消或共同致错的情况：在写入跨任务规则前，主动选择能区分竞争原因的干预，并检验规则在未见任务上的可识别性。若只定位单个决定性错误，研究就没有覆盖这个新增问题；是否足够新颖仍需更多相关工作检索。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2406.07496",{"href":"#reference-2406.07496","aria-label":"来源 2: TextGrad: Automatic \"Differentiation\" via Text","children":["[",2,"]"]}],["$","a","2309.16797",{"href":"#reference-2309.16797","aria-label":"来源 3: Promptbreeder: Self-Referential Self-Improvement Via Prompt Evolution","children":["[",3,"]"]}],["$","a","2608.28264v1",{"href":"#reference-2608.28264v1","aria-label":"来源 4: Finding Where the Buck Stops: An Automated Failure Attribution-Based Reflection Framework for Multi-Agent Collaboration","children":["[",4,"]"]}]]}]]}]]]}]]}]

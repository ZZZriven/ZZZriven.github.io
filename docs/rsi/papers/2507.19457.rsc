11:["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"论文通过对完整 execution trace 进行 reflection 来提出 prompt 改动，并利用历史候选的 Pareto frontier 寻找可组合的改进。相比只有最终 reward 的信号，轨迹可以提供出错位置与 context，但能否转化成更好的 prompt 仍依赖 reflection 质量。"}]]}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"先选取候选系统并在小批任务上执行，记录轨迹和 feedback；reflection model 据此提出 prompt 变体并测试。候选池保留不同任务上的有效方案，并可合并互补模块，反复进行选择、mutation 和评价。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"更新版摘要报告六项任务上平均优于 GRPO 约 6%，最多使用少 35 倍的轨迹，并超过 prompt optimization baseline MIPROv2。这些是论文给定 model 和预算下的结果，不能解读为 prompt optimization 普遍胜过所有 reinforcement learning 方法。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"本条核对 arXiv 摘要，未通读论文全文或复现实验。优化依赖 reflection model、可用轨迹及评价预算；保存 prompt 并不更新 foundation model 参数，减少轨迹数量也不必然等于同比例降低总算力成本。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：可进一步比较 feedback 只有分数、包含错误文本以及包含完整轨迹时的收益，并在预算相等时分析 reflection 成本。长期应用还应测试候选合并、validation set overfitting 以及迁移后规则冲突。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"从 execution trace 提取 feedback 并演化可复用的 prompt，属于 prompt 层面的 Persistent System Improvement。reflection 用于修改任务系统的 prompt；本条已核验材料未展示 reflection 优化算法或其更新 strategy 发生 self-modification。"}]]}]

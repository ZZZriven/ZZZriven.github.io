","span",null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"稀疏标量奖励通常不能直接说明失败原因，强化学习适配新任务又可能需要大量轨迹。论文研究能否从少量可读执行信息中提炼高层规则，并通过提示更新提高单个或复合LLM系统的表现。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"轨迹中包含的错误位置、工具返回和推理过程，比一个最终分数提供更多可操作信息。反思模型可将这些信息压缩成修改建议，而保留不同任务子集上的优势候选，有利于积累互补经验。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],"$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","h2",null,{"children":["关键观察",false]}]
11:["$","p",null,{"children":"论文方法围绕完整轨迹进行语言反思，并从自身历史候选的Pareto前沿选择与组合经验。官方实现说明也将评价器返回的诊断信息作为优化输入，表明反馈质量是重要的接口要求。"}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"先选取候选系统并在小批任务上执行，记录轨迹和反馈；反思模型据此提出提示变体并测试。候选池保留不同任务上的有效方案，并可合并互补模块，反复进行选择、变异和评价。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"更新版摘要报告六项任务上平均优于GRPO约6%，最多使用少35倍的轨迹，并超过提示优化基线MIPROv2。这些是论文给定模型和预算下的结果，不能解读为提示优化普遍胜过所有强化学习方法。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"本条核对摘要与官方方法说明，未通读论文全文或复现实验。优化依赖反思模型、可用轨迹及评价预算；保存提示并不更新基础模型参数，减少轨迹数量也不必然等于同比例降低总算力成本。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：可进一步比较反馈只有分数、包含错误文本以及包含完整轨迹时的收益，并在预算相等时分析反思成本。长期应用还应测试候选合并、验证集过拟合以及迁移后规则冲突。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"编者归类：属于可持久保存的提示层改进，适合与AFlow的结构搜索和ACE的记忆积累对照。GEPA使用反思来改进任务系统，但这里的证据没有表明它递归修改了自己的优化算法。"}]]}]

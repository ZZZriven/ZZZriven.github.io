:["0",1]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"由人设计的智能体结构固定后，能否自行发现更好的工具和工作流程？"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"自我修改可能需要先保留暂时不领先的方案，再把它们作为后续创新的起点。DGM 将经验验证与多分支档案结合，使新工具或流程有机会在后代中发挥作用；递归之处在于负责修改代码的智能体也使用演化后的自身实现。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],"$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","h2",null,{"children":["关键观察",false]}]
11:["$","p",null,{"children":"作者观察到，保留多样化智能体档案能帮助搜索越过局部最优，某些暂时较弱的版本也能产生更强后代。论文还报告未参与搜索基准上的迁移；这些证据支持代码改进具有一定可迁移性，但不等于任意任务上的持续增长。"}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"从历史智能体档案中选择个体，借助基础模型修改其代码，再用编程任务评估并保留有价值的变体。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"论文报告，冻结基础模型后，通过代码自修改，SWE-bench Verified 的 200 题子集成绩由 20% 提升至 50%；完整 Polyglot 基准由 14.2% 提升至 30.7%。原文还报告跨基准、未参与搜索任务的迁移，结论仍限于所用模型、任务与搜索预算。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"基础模型权重冻结，开放探索中的档案维护与父代选择也固定；基准得分提升是代码系统改进证据，不能直接推出全系统无约束递归演化。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"本站展望：将已有跨基准迁移检验扩展到更长演化周期、更广的未见任务与不同基础模型，并报告多次运行方差和完整搜索成本。进一步隔离自修改机制、档案多样性与推理预算的贡献，才能判断改进效率能否持续提高。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"直接研究能够迭代修改自身实现的系统，是理解系统层面 RSI 的重要案例。"}]]}]

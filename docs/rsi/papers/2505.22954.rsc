17:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"由人设计的 Agent 结构固定后，能否自行发现更好的工具和 workflow？"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Darwin Godel Machine: Open-Ended Evolution of Self-Improving Agents · v3","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Coding Agent 的表现同时受 Base Model 和外层程序限制：相同 Model，整文件重写可能耗尽 Context，精确编辑工具却能完成任务。若改进这些工具仍依赖人，部署后的失败经验就很难持续变成系统能力。DGM 关心的价值，是让一次失败推动可保留、可复用的 Agent 实现变化。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Darwin Godel Machine: Open-Ended Evolution of Self-Improving Agents · v3","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"ADAS 已用固定 Meta-Agent 搜索目标 Agent 的程序；STOP 已让 Improver 优化自身的调用程序；SICA 则让表现较好的 Coding Agent 接管后续自我修改。它们说明自动程序设计具有可行性。DGM 进一步检验 Archive 中的多条演化分支，尤其是当前分数不领先的中间版本，能否帮助发现更好的后代。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2408.08435",{"href":"#reference-2408.08435","aria-label":"来源 2: Automated Design of Agentic Systems","children":["[",2,"]"]}],["$","a","2310.02304",{"href":"#reference-2310.02304","aria-label":"来源 3: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation","children":["[",3,"]"]}],["$","a","2504.15228",{"href":"#reference-2504.15228","aria-label":"来源 4: A Self-Improving Coding Agent","children":["[",4,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"可以从两个失败模式推起。第一，错误日志包含具体修复线索，单一分数无法告诉程序该改哪个工具。第二，贪心搜索会丢掉暂时昂贵、但可能支持新功能的版本。已有 Coding Agent 能读日志并改仓库，因而自然可以把被修改仓库换成 Agent 自身；再保留多条分支，让新增功能有机会在后代中被利用。这是机制重建，不能证明作者当时确实如此思考。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2408.08435",{"href":"#reference-2408.08435","aria-label":"来源 2: Automated Design of Agentic Systems","children":["[",2,"]"]}],["$","a","2310.02304",{"href":"#reference-2310.02304","aria-label":"来源 3: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation","children":["[",3,"]"]}],["$","a","2504.15228",{"href":"#reference-2504.15228","aria-label":"来源 4: A Self-Improving Coding Agent","children":["[",4,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],"$L1c","$undefined","$L1d"]}]]]}]]}],"$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}]

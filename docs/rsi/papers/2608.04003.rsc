 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2608.04003v1","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"Read PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"SUMMARY"}],["$","p",null,{"children":"在新会话任务中控制是否保留经验，同时检查成绩变化与保存、检索、更新路径，衡量 memory 是否真正带来后续收益。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Improvement Target"}],["$","dd",null,{"children":"Cross-Session Experience & Causal Evaluation"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Feedback"}],["$","dd",null,{"children":"有序任务序列的评测结果，以及保存、检索和更新经验的过程证据。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"Evidence Scope"}],["$","dd",null,{"children":"核验 arXiv v1 摘要及提交记录；结果来自作者实验报告，尚未独立复现，也不构成 Improver Self-Modification 证据。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"Agent 可以保存偏好、任务历史与工具经验，但保存了内容不等于未来任务变好。研究要区分保留经验带来的收益、系统本身的能力，以及经验是否经由预期路径被实际使用。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"关键在于把经验开关设为可比较的实验条件，并追踪保存、检索、更新的完整路径。本站解读：仅报告最终成功率会混合多种来源的收益，过程证据才能帮助判断 persistent memory 是不是改进原因。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],"$L10"]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"摘要报告，不同 model 和 Agent 框架确实能从经验中获益，但收益因能力而异；具有相近整体增益的系统，其实际利用经验的路径证据仍可明显不同。保留状态与有效更新状态并非同一能力。"}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"将任务排成有顺序的新会话序列，在匹配条件下打开或关闭经验保留；覆盖 memory、过程复用、信息收集与更新，分别记录后续收益和经验路径证据，再据诊断对 Agent 循环加入针对性改动。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"论文摘要列出 26 个场景、204 个任务片段，比较七个 foundation model 和四个框架。所提出的改进系统提高了经验保留的平均收益，替换过时状态的任务改善最明显，但效果仍依赖能力类型与 model。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"这是一套经验利用的评测与诊断证据，不能直接证明 Agent 会修改自己的改进算法。场景和任务片段数也不等于所有个人助理任务的覆盖范围；此条目核验摘要，未复现评测或独立检查轨迹。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"本站展望：把经验保留与错误经验清理、知识失效和多用户隔离结合起来，在更长任务链中同时报告性能与路径证据。还可比较自动 memory 管理 strategy 与人工诊断改动，区分系统自主学习和工程改良。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"归入 Evaluation & Limits、关联类型为 Surveys, Theory & Evaluation。它验证 Persistent System Improvement 所需的基础条件：经验是否进入后续会话并产生收益；improver 能否 self-modification、能否长期持续提高，仍是更强的问题。"}]]}]

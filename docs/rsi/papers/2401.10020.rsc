$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"固定 reward model 可能限制后续学习，reward 判断本身能否一起改进？"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"固定 reward model 可能成为训练瓶颈，因此论文让 model 同时承担回答者与 judge，再将自生成偏好用于下一轮学习。值得关注的是 reward 判断能力是否随训练提升：若这一环节改善，后续训练信号也有机会变好，形成 feedback 与 policy 的共同更新。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":["$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","h2",null,{"children":["Observation",false]}]
11:["$","p",null,{"children":"作者在 Llama 2 70B 上运行三轮迭代 DPO，报告 instruction following 和 self-rewarding 判断两方面改善，并用 AlpacaEval 2.0 展示回答质量。该证据覆盖有限轮数与指定评估，并没有展示长期持续增长，也未证明自评永远与外部评价一致。"}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"让 model 通过 prompt 评估候选回答，再使用生成的偏好数据进行多轮 direct preference optimization。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"论文在其 instruction following 实验中观察到回答与 reward 判断两方面的改善。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"这些结果对应有限训练轮数与特定评估；持续改进是否稳定，需要更长周期与独立评价。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：可把回答质量、reward 排序准确性和校准误差分别画成跨轮次曲线，再用独立的人类或异构 judge 核验。更长期的实验应检查偏好漂移和错误强化，并比较何时引入少量 external feedback 最能稳定 self-rewarding 循环。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"同一 model 生成回答并评判候选，迭代训练后又承担下一轮评判，形成 Models & Rewards 能力的共同改进。论文报告 reward 判断改善；按本库“Improver Self-Modification”的窄口径，固定 DPO 流程和评判 prompt 没有被系统改写，故标为 Persistent System Improvement。"}]]}]

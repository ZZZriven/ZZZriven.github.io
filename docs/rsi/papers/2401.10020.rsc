14:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
15:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"固定 reward model 可能限制后续学习，reward 判断本身能否一起改进？"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Rewarding Language Models · v3","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Preference Training 的上限受反馈质量影响。若 Judge 固定，Solver 逐渐变强后仍被同一套误差模式评价；若一直追加人工判断，成本又随规模上升。问题因而落在一个具体闭环上：能否让产生回答的 Model 同时学习判断回答，并让新 Judge 参与下一轮数据生成？"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Rewarding Language Models · v3","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"Constitutional AI 已使用原则和 AI Feedback 生成训练信号，但其完整 Pipeline 仍包含人工设定的 Constitution、初始训练数据及特定反馈流程。Self-Rewarding 进一步让同一 Model 在多轮中兼任回答者和 Judge。其初始化同样使用人类提供的 Instruction 与偏好相关示例，不能解读为完全没有外部监督。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2212.08073",{"href":"#reference-2212.08073","aria-label":"来源 2: Constitutional AI: Harmlessness from AI Feedback","children":["[",2,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"先考虑一个可观察事实：Model 有时不能一次写好答案，却能指出两个答案的差别。把这种判断能力转成 Pairwise Preference，便有了额外训练数据。如果经过训练的 Model 判断也更可靠，那么上一轮的 Judge 就没有必要永久冻结。这个推理依赖生成与判断能共同受益，仍需分别测量两种能力，不能提前用最终成功作为前提。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2212.08073",{"href":"#reference-2212.08073","aria-label":"来源 2: Constitutional AI: Harmlessness from AI Feedback","children":["[",2,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"固定 reward model 可能成为训练瓶颈，因此论文让 model 同时承担回答者与 judge，再将自生成偏好用于下一轮学习。值得关注的是 reward 判断能力是否随训练提升：若这一环节改善，后续训练信号也有机会变好，形成 feedback 与 policy 的共同更新。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Rewarding Language Models · v3","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","method",{"id":"method","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"05"}],["$","div",null,{"children":[["$","h2",null,{"children":"Method & Worked Example"}],["$","p",null,{"className":"section-question","children":"沿着输入、处理、输出走完 Pipeline。"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":["$L1a","$L1b","$undefined","$L1c"]}],"$L1d"]]}]]}],"$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"阅读已固定版本的原文 Background、方法与主要结果，结合下列相关文献撰写。Paper Claim 表示作者报告，未独立复现；Inference 包括数学教学推演与 Idea Reconstruction。One-Week Reproduction、Counterexample 和 Follow-up 均为待执行提案，Novelty 尚需更全面的文献与实验检验。"}],["$","ol",null,{"children":[["$","li","paper",{"id":"reference-paper","children":[["$","a",null,{"href":"https://arxiv.org/html/2401.10020v3","target":"_blank","rel":"noreferrer","children":["[",1,"] ","Self-Rewarding Language Models · v3"," ↗"]}],["$","span",null,{"children":"原文 Background、Method / Formalization 与主要实验或理论结论。数字沿用原文设置；未独立运行完整实验。"}]]}],["$","li","2212.08073",{"id":"reference-2212.08073","children":[["$","a",null,{"href":"https://arxiv.org/abs/2212.08073v1","target":"_blank","rel":"noreferrer","children":["[",2,"] ","Constitutional AI: Harmlessness from AI Feedback"," ↗"]}],["$","span",null,{"children":"相关方法与研究背景；用于说明具体差异，不能替代对本篇结论的验证。"}]]}],["$","li","dpo",{"id":"reference-dpo","children":[["$","a",null,{"href":"https://arxiv.org/abs/2305.18290v3","target":"_blank","rel":"noreferrer","children":["[",3,"] ","Direct Preference Optimization: Your Language Model is Secretly a Reward Model"," ↗"]}],["$","span",null,{"children":"DPO 的 Preference Loss 与 KL-Regularized Policy 背景。"}]]}]]}],["$","span",null,{"children":["arXiv:","2401.10020"," · ","v3"," / REVIEWED ","2026.09.13"]}]]}]

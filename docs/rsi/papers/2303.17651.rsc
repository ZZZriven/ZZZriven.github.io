":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"语言模型的第一版输出不理想时，自身反馈能否帮助修订？"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"同一模型生成初稿与检查初稿时面对的任务不同：先找可改之处，再据此修订，可能调用一次生成未充分使用的能力。Self-Refine 将这种分工实现为提示循环，改善对象是当前输出，为研究自反馈的效果提供了清晰而轻量的起点。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],["$","h2",null,{"children":["关键观察",false]}],"$L10"]}]]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","p",null,{"children":"作者在七类任务上比较单步生成与迭代修订，覆盖对话回复和数学推理等，并报告人类评价和自动指标对后者的偏好。实验使用同一个模型承担生成、反馈和修订角色，不依赖额外训练；证据因此属于推理时输出改善。"}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"把生成、批评和修订串成循环，直到达到停止条件，无需额外训练。"}]]}]]}]

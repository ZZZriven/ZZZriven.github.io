1a:["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Refine: Iterative Refinement with Self-Feedback · v2","children":["[",1,"]"]}]]}]
1b:["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"原文展示了求 1 到 N 之和的代码优化案例。初稿使用循环逐个累加；Feedback 指出存在 Closed-form Expression；Refinement 改为 N(N+1)/2。代入 N=5 得到 15，是对原文案例的教学演算。Pipeline 的输入是任务与初稿，处理中保留反馈和修订历史，输出是最终程序；固定 Model 和外层循环并未因此更新。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Refine: Iterative Refinement with Self-Feedback · v2","children":["[",1,"]"]}]]}]]}]
1c:["$","section","mathematics",{"id":"mathematics","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"06"}],["$","div",null,{"children":[["$","h2",null,{"children":"Mathematical Foundations"}],["$","p",null,{"className":"section-question","children":"从符号、直觉与简单例子理解理论。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"算法本身没有必须掌握的新数学定理。把 y_t 看作第 t 版答案，f_t 是对它的反馈，R 是固定 Model 的修订调用，即可写出迭代。循环只是描述信息流，没有规定某个真实质量函数必须每步上升。代码案例中的求和公式可由首尾配对理解：每对和为 N+1，共 N/2 对，因此总和为 N(N+1)/2。"}],["$","pre",null,{"className":"math-block","aria-label":"数学表达式","children":"f_t = Feedback(x, y_t)\ny_(t+1) = Refine(x, y_t, f_t, history)\n1 + 2 + … + N = N(N+1)/2"}],["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Refine: Iterative Refinement with Self-Feedback · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
1d:["$","section","experiments",{"id":"experiments","children":[[["$","span","results",{"className":"anchor-alias","id":"results"}],["$","span","observation",{"className":"anchor-alias","id":"observation"}]],["$","span",null,{"className":"reading-section-number","children":"07"}],["$","div",null,{"children":[["$","h2",null,{"children":"Experiments & Claims"}],["$","p",null,{"className":"section-question","children":"Research Question → Experiment → Answer"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"Question：显式 Feedback 是否能让修订比初稿更好？→ Experiment：在多种生成任务上比较初稿、迭代修订和相关基线，并分析 Feedback 与迭代次数。→ Answer：论文报告多任务平均收益，但收益依赖评价目标与 Model 能力，不能推广成任意推理题都能靠自我批评纠错。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Refine: Iterative Refinement with Self-Feedback · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"作者在七类任务中观察到，相比单步生成，人类与自动评价更偏好迭代修订后的输出。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Refine: Iterative Refinement with Self-Feedback · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
1e:["$","section","takeaways",{"id":"takeaways","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"08"}],["$","div",null,{"children":[["$","h2",null,{"children":"Takeaways"}],["$","p",null,{"className":"section-question","children":"这篇论文改变了哪些判断？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"最实用的模式是将一个宽泛请求拆成可检查的维度，例如代码复杂度、任务约束或措辞。最容易误读的地方是把当前答案变好等同于系统学会了新能力；这篇研究主要提供 Task-local Refinement 证据。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Refine: Iterative Refinement with Self-Feedback · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
1f:["$","section","assumptions",{"id":"assumptions","children":[[["$","span","limits",{"className":"anchor-alias","id":"limits"}]],["$","span",null,{"className":"reading-section-number","children":"09"}],["$","div",null,{"children":[["$","h2",null,{"children":"Most Fragile Assumption"}],["$","p",null,{"className":"section-question","children":"哪一个假设失效会动摇方法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"最脆弱的假设是 Feedback 比初稿更可靠。若 Model 对问题本身有系统性误解，反馈可能只是更自信地重复误解，并把原本正确的部分改错。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Refine: Iterative Refinement with Self-Feedback · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"变化发生在当前回答中；这不是 model weights 或 self-improvement 算法的持续演化。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Refine: Iterative Refinement with Self-Feedback · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
20:["$","section","reproduction",{"id":"reproduction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"10"}],["$","div",null,{"children":[["$","h2",null,{"children":"One-Week Reproduction"}],["$","p",null,{"className":"section-question","children":"用一周检验一个最小且明确的命题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"Day 1：收集 30 个可单元测试的小程序题。Day 2–4：比较一次生成、两次独立采样、Feedback 加 Refinement，严格匹配调用与 Token Budget。Day 5–7：统计 Wrong→Right 与 Right→Wrong 两种转移，人工检查具体反馈是否可执行。最小目标是分离诊断价值与额外采样价值。"}],"$undefined",null]}]]]}]]}]
21:["$","section","counterexample",{"id":"counterexample","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"11"}],["$","div",null,{"children":[["$","h2",null,{"children":"Counterexample Design"}],["$","p",null,{"className":"section-question","children":"如何构造有辨识力的反例？"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"使用看似冗长却为数值稳定性而设计的代码，让 Feedback 只关注简洁与速度。若修订删除保护逻辑并在极端输入失败，便能展示单一评价维度如何诱发净退步。隐藏测试必须包含这些极端输入。"}],"$undefined",null]}]]]}]]}]
22:["$","section","follow-up",{"id":"follow-up","children":[[["$","span","outlook",{"className":"anchor-alias","id":"outlook"}]],["$","span",null,{"className":"reading-section-number","children":"12"}],["$","div",null,{"children":[["$","h2",null,{"children":"Follow-up Research"}],["$","p",null,{"className":"section-question","children":"从缺陷与需求推导新的研究问题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"研究“有条件的修订权限”：系统先识别哪些局部性质已有证据成立，再只允许满足这些性质的修改。与 STaR 的正确轨迹筛选相比，这把推理时编辑转成保持已证实性质的搜索。目标是在不可靠 Critic 下控制 Right→Wrong 风险；若保护机制只阻止所有修改，则需同时检验可用性与净收益。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2203.14465",{"href":"#reference-2203.14465","aria-label":"来源 2: STaR: Bootstrapping Reasoning With Reasoning","children":["[",2,"]"]}]]}]]}]]]}]]}]

13:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
14:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"language model 的第一版输出不理想时，自身 feedback 能否帮助修订？"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Refine: Iterative Refinement with Self-Feedback · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"LLM 的第一次回答往往是一个能用的草稿，仍可能遗漏约束、解释不够清楚或代码效率低。逐次让人指出问题成本高，训练专用 Refiner 又需要数据。Self-Refine 研究同一个固定 Model 能否在推理时生成有针对性的 Feedback，再据此修改当前输出。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Refine: Iterative Refinement with Self-Feedback · v2","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"STaR 通过筛选生成的 Reasoning 并 Fine-Tune 来改变后续 Model，解决的是训练期能力积累。Self-Refine 使用固定 Model，在一次任务内交替生成反馈与修订；这里没有把修订经验写回 Weights 的训练步骤。两者处理的时间尺度不同。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2203.14465",{"href":"#reference-2203.14465","aria-label":"来源 2: STaR: Bootstrapping Reasoning With Reasoning","children":["[",2,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"人写程序时常先得到正确但低效的实现，再从复杂度或边界条件检查它。Model 的生成和诊断能力也可能不完全同步。由此可以先把评价目标写清楚，让它只找具体问题，再让下一次调用只负责修复这些问题。独立的 Feedback 阶段是否有增益，要和等预算的重复生成比较。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2203.14465",{"href":"#reference-2203.14465","aria-label":"来源 2: STaR: Bootstrapping Reasoning With Reasoning","children":["[",2,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"同一 model 生成初稿与检查初稿时面对的任务不同：先找可改之处，再据此修订，可能调用一次生成未充分使用的能力。Self-Refine 将这种分工实现为 prompt 循环，改善对象是当前输出，为研究 self-feedback 的效果提供了清晰而轻量的起点。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Self-Refine: Iterative Refinement with Self-Feedback · v2","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","method",{"id":"method","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"05"}],["$","div",null,{"children":[["$","h2",null,{"children":"Method & Worked Example"}],["$","p",null,{"className":"section-question","children":"沿着输入、处理、输出走完 Pipeline。"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],"$L19","$undefined","$L1a"]}],"$L1b"]]}]]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]
15:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"阅读已固定版本的原文 Background、方法与主要结果，结合下列相关文献撰写。Paper Claim 表示作者报告，未独立复现；Inference 包括数学教学推演与 Idea Reconstruction。One-Week Reproduction、Counterexample 和 Follow-up 均为待执行提案，Novelty 尚需更全面的文献与实验检验。"}],["$","ol",null,{"children":[["$","li","paper",{"id":"reference-paper","children":[["$","a",null,{"href":"https://arxiv.org/html/2303.17651v2","target":"_blank","rel":"noreferrer","children":["[",1,"] ","Self-Refine: Iterative Refinement with Self-Feedback · v2"," ↗"]}],["$","span",null,{"children":"原文 Background、Method / Formalization 与主要实验或理论结论。数字沿用原文设置；未独立运行完整实验。"}]]}],["$","li","2203.14465",{"id":"reference-2203.14465","children":[["$","a",null,{"href":"https://arxiv.org/abs/2203.14465v2","target":"_blank","rel":"noreferrer","children":["[",2,"] ","STaR: Bootstrapping Reasoning With Reasoning"," ↗"]}],["$","span",null,{"children":"相关方法与研究背景；用于说明具体差异，不能替代对本篇结论的验证。"}]]}]]}],["$","span",null,{"children":["arXiv:","2303.17651"," · ","v2"," / REVIEWED ","2026.09.13"]}]]}]

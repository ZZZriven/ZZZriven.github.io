tion","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"Agent 可以在失败后重试同一任务，却常把教训写成仅适合当前地点的 prompt。论文研究冻结 model 如何保留更一般的行动知识，使环境配置或任务变化后仍能利用过去试错，而非完全重新探索。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"把经验表述成某行动是否有助于某状态变化，更接近可迁移的行动 model。CLIN 还在文字中保留不确定性；编辑理解是，这能把暂时观察与稳定规律区分开，减少一次失败被误写成普遍规则。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],"$L10"]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"正文明确让 memory cross-trial 保留，并进一步从多个任务的较好试次构造元 memory。生成的经验数远少于行动数，显示 memory 在压缩历史；摘要也报告新环境与新任务上的迁移收益，超出只修补本题。"}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"控制器结合任务和 memory 提出子目标，executor 转成有效环境动作。试次结束后，memory generator 综合轨迹与结果，更新关于必要动作或无贡献动作的半结构化句子，再从跨任务经验生成更一般的元 memory。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"作者在 ScienceWorld 中报告同任务重复尝试的持续改善，也在新环境或任务上观察到 zero-shot 迁移及后续适应。结果对应文本模拟器和所用 model，支持 memory 层的累积收益，不能外推到任意开放环境。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"因果抽象由 language model 根据有限轨迹生成，并非通过严格干预实验识别的因果规律。控制器、executor 和 generator 均冻结；环境还提供可行动作信息，所以表现包含模拟器接口对 search 空间的帮助。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：适合测试错误规律进入 memory 后能否被反例推翻，并将环境变化分为配置变化与规则变化。另可用清空 memory、保留原始轨迹和保留抽象三种对照，衡量抽象到底提供了多少跨任务收益。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"编辑归类为 Persistent System Improvement：更新后的经验会影响未来试次和不同任务，而非只修订当前输出。其贡献在于学习产物的保留与迁移；memory 生成算法仍固定，没有证明负责下一轮学习的程序自身被改进。"}]]}]

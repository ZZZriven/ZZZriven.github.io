1a:["$","section","method",{"id":"method","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"05"}],["$","div",null,{"children":[["$","h2",null,{"children":"Method & Worked Example"}],["$","p",null,{"className":"section-question","children":"沿着输入、处理、输出走完 Pipeline。"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"控制器结合任务和 memory 提出子目标，executor 转成有效环境动作。试次结束后，memory generator 综合轨迹与结果，更新关于必要动作或无贡献动作的半结构化句子，再从跨任务经验生成更一般的元 memory。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CLIN: A Continually Learning Language Agent for Rapid Task Adaptation and Generalization · v1","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"沿用原文 ScienceWorld 中种植植物的任务类型：输入目标和可见环境，Controller 读取记忆制定子目标，Executor 采取动作并接收结果，Trial 结束后 Memory Generator 更新动作与结果的关系。下一次环境重置，记忆继续保留。换房间或换任务后再测试，才能区分“记住具体位置”与“掌握可迁移的操作条件”。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CLIN: A Continually Learning Language Agent for Rapid Task Adaptation and Generalization · v1","children":["[",1,"]"]}]]}]]}]]]}]]}]
1b:["$","section","mathematics",{"id":"mathematics","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"06"}],["$","div",null,{"children":[["$","h2",null,{"children":"Mathematical Foundations"}],["$","p",null,{"className":"section-question","children":"从符号、直觉与简单例子理解理论。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"环境可表示为 POMDP：Agent 只看到部分状态，通过动作得到新 Observation 与 Reward。记忆相当于把历史压缩成一个可供决策使用的状态摘要。若摘要遗漏关键条件，同一条规则在两个隐藏状态中可能产生相反效果。因此，Memory 有效性取决于保留哪些区分，而非文本压缩率本身。"}],["$","pre",null,{"className":"math-block","aria-label":"数学表达式","children":"action_t ~ π(· | observation_t, memory, history)\nmemory′ = Summarize(memory, trajectory, feedback)\nEnvironment reset ≠ memory reset"}],["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CLIN: A Continually Learning Language Agent for Rapid Task Adaptation and Generalization · v1","children":["[",1,"]"]}]]}]]}]]]}]]}]
1c:["$","section","experiments",{"id":"experiments","children":[[["$","span","results",{"className":"anchor-alias","id":"results"}],["$","span","observation",{"className":"anchor-alias","id":"observation"}]],["$","span",null,{"className":"reading-section-number","children":"07"}],["$","div",null,{"children":[["$","h2",null,{"children":"Experiments & Claims"}],["$","p",null,{"className":"section-question","children":"Research Question → Experiment → Answer"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"Question：持续 Memory Update 是否超出同任务重试？→ Experiment：分别测试重复任务、变化环境和新任务，并比较相关语言 Agent。→ Answer：作者报告适应与迁移收益；这些结论限定在 ScienceWorld 任务及其变体，不能据此认定所有生活经验都能抽象迁移。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CLIN: A Continually Learning Language Agent for Rapid Task Adaptation and Generalization · v1","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"作者在 ScienceWorld 中报告同任务重复尝试的持续改善，也在新环境或任务上观察到 zero-shot 迁移及后续适应。结果对应文本模拟器和所用 model，支持 memory 层的累积收益，不能外推到任意开放环境。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CLIN: A Continually Learning Language Agent for Rapid Task Adaptation and Generalization · v1","children":["[",1,"]"]}]]}]]}]]]}]]}]
1d:["$","section","takeaways",{"id":"takeaways","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"08"}],["$","div",null,{"children":[["$","h2",null,{"children":"Takeaways"}],["$","p",null,{"className":"section-question","children":"这篇论文改变了哪些判断？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"CLIN 的重要实验设计是把 Task 与 Environment 两种变化拆开。只有在未见条件下继续有效，经验才开始具有超越轨迹记忆的意义。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CLIN: A Continually Learning Language Agent for Rapid Task Adaptation and Generalization · v1","children":["[",1,"]"]}]]}]]}]]]}]]}]
1e:["$","section","assumptions",{"id":"assumptions","children":[[["$","span","limits",{"className":"anchor-alias","id":"limits"}]],["$","span",null,{"className":"reading-section-number","children":"09"}],["$","div",null,{"children":[["$","h2",null,{"children":"Most Fragile Assumption"}],["$","p",null,{"className":"section-question","children":"哪一个假设失效会动摇方法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"最脆弱的假设是轨迹中观察到的因果关系足够稳定。隐藏条件、任务规则变化和偶然成功都可能让抽象规则失效，而语言表达常省略这些条件。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CLIN: A Continually Learning Language Agent for Rapid Task Adaptation and Generalization · v1","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"因果抽象由 language model 根据有限轨迹生成，并非通过严格干预实验识别的因果规律。控制器、executor 和 generator 均冻结；环境还提供可行动作信息，所以表现包含模拟器接口对 search 空间的帮助。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CLIN: A Continually Learning Language Agent for Rapid Task Adaptation and Generalization · v1","children":["[",1,"]"]}]]}]]}]]]}]]}]
1f:["$","section","reproduction",{"id":"reproduction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"10"}],["$","div",null,{"children":[["$","h2",null,{"children":"One-Week Reproduction"}],["$","p",null,{"className":"section-question","children":"用一周检验一个最小且明确的命题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"Day 1–2：选一个小型可控环境，建立两个房间版本与两个任务。Day 3–5：比较原始轨迹记忆、反思记忆和条件化规则记忆。Day 6–7：交叉切换房间与任务，测零样本迁移及继续学习的增益，记录规则的具体失效条件。"}],"$undefined",null]}]]]}]]}]
20:["$","section","counterexample",{"id":"counterexample","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"11"}],["$","div",null,{"children":[["$","h2",null,{"children":"Counterexample Design"}],["$","p",null,{"className":"section-question","children":"如何构造有辨识力的反例？"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"让训练环境中“加热”总能帮助完成目标，测试环境中材料发生变化、加热会损坏目标物。如果抽象记忆仍无条件建议加热，就能检验其规则是否保留了真正决定结果的条件。"}],"$undefined",null]}]]]}]]}]
21:["$","section","follow-up",{"id":"follow-up","children":[[["$","span","outlook",{"className":"anchor-alias","id":"outlook"}]],["$","span",null,{"className":"reading-section-number","children":"12"}],["$","div",null,{"children":[["$","h2",null,{"children":"Follow-up Research"}],["$","p",null,{"className":"section-question","children":"从缺陷与需求推导新的研究问题。"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"后续相关工作 DoCtOR 已将失败归因、反事实步骤修正与定向 Reflection 结合，用于 Multi-Agent Collaboration。单独提出因果归因或定向反思已有接近的研究。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2608.28264v1",{"href":"#reference-2608.28264v1","aria-label":"来源 4: Finding Where the Buck Stops: An Automated Failure Attribution-Based Reflection Framework for Multi-Agent Collaboration","children":["[",4,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"把 Memory 变成可主动验证的规则系统：Agent 为每条候选规则选择能区分竞争解释的下一次实验。相对 Reflexion 的事后经验总结，研究对象变成经验获取与因果抽象的共同设计。成功标准应是少量交互识别环境规则变化，并正确撤销旧知识。 提案应进一步面对多个错误相互抵消或共同致错的情况：在写入跨任务规则前，主动选择能区分竞争原因的干预，并检验规则在未见任务上的可识别性。若只定位单个决定性错误，研究就没有覆盖这个新增问题；是否足够新颖仍需更多相关工作检索。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2303.11366",{"href":"#reference-2303.11366","aria-label":"来源 2: Reflexion: Language Agents with Verbal Reinforcement Learning","children":["[",2,"]"]}],["$","a","2210.03629",{"href":"#reference-2210.03629","aria-label":"来源 3: ReAct: Synergizing Reasoning and Acting in Language Models","children":["[",3,"]"]}],["$","a","2608.28264v1",{"href":"#reference-2608.28264v1","aria-label":"来源 4: Finding Where the Buck Stops: An Automated Failure Attribution-Based Reflection Framework for Multi-Agent Collaboration","children":["[",4,"]"]}]]}]]}]]]}]]}]

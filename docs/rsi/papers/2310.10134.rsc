14:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
15:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"Agent 可以在失败后重试同一任务，却常把教训写成仅适合当前地点的 prompt。论文研究冻结 model 如何保留更一般的行动知识，使环境配置或任务变化后仍能利用过去试错，而非完全重新探索。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CLIN: A Continually Learning Language Agent for Rapid Task Adaptation and Generalization · v1","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"记住上次怎么失败，可能只帮助同一道题。持续学习还要求经验跨环境和任务变化仍然有用。CLIN 研究如何将交互总结成可更新的 Causal Abstraction，让固定 Model 在新的设置中利用过去经验。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CLIN: A Continually Learning Language Agent for Rapid Task Adaptation and Generalization · v1","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"ReAct 提供交互执行骨架，Reflexion 通过语言记忆改善后续 Trial。CLIN 更明确区分同任务适应与新任务、新环境的迁移，并围绕动作和结果关系组织记忆。其文本中的 causal 表述是一种经验抽象形式，不能自动等同于完成了严格的因果识别。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2303.11366",{"href":"#reference-2303.11366","aria-label":"来源 2: Reflexion: Language Agents with Verbal Reinforcement Learning","children":["[",2,"]"]}],["$","a","2210.03629",{"href":"#reference-2210.03629","aria-label":"来源 3: ReAct: Synergizing Reasoning and Acting in Language Models","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"一次成功轨迹可能包含很多偶然动作；原样记住容易过拟合。若能压缩出“某动作在什么条件下帮助或妨碍目标”，就可能在对象和位置变化后继续使用。接着需要持续修订这些规则，并从多个 Trial 提炼更一般的 Meta-Memory；这个过程的风险是过早把相关性写成普遍规律。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2303.11366",{"href":"#reference-2303.11366","aria-label":"来源 2: Reflexion: Language Agents with Verbal Reinforcement Learning","children":["[",2,"]"]}],["$","a","2210.03629",{"href":"#reference-2210.03629","aria-label":"来源 3: ReAct: Synergizing Reasoning and Acting in Language Models","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"把经验表述成某行动是否有助于某状态变化，更接近可迁移的行动 model。CLIN 还在文字中保留不确定性；编辑理解是，这能把暂时观察与稳定规律区分开，减少一次失败被误写成普遍规则。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CLIN: A Continually Learning Language Agent for Rapid Task Adaptation and Generalization · v1","children":["[",1,"]"]}]]}]]}]]]}]]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]

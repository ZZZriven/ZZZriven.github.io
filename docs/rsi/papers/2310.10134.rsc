002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv 原文",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2310.10134v1","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"阅读 PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"ABSTRACT / 摘要"}],["$","p",null,{"children":"从每次成功或失败中提炼带不确定性的因果经验，在不更新模型参数时改善后续任务与环境适应。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"改进对象"}],["$","dd",null,{"children":"跨试次经验与因果记忆"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"反馈来源"}],["$","dd",null,{"children":"模拟器动作观察、最终任务奖励转成的文字反馈，以及以往试次记忆。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"证据边界"}],["$","dd",null,{"children":"核验摘要、v1 元数据及正文第 3.1–3.3 节；迁移结论依据作者摘要，未复现基准。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"智能体可以在失败后重试同一任务，却常把教训写成仅适合当前地点的提示。论文研究冻结模型如何保留更一般的行动知识，使环境配置或任务变化后仍能利用过去试错，而非完全重新探索。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"把经验表述成某行动是否有助于某状态变化，更接近可迁移的行动模型。CLIN 还在文字中保留不确定性；编辑理解是，这能把暂时观察与稳定规律区分开，减少一次失败被误写成普遍规则。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],"$L10"]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],["$","h2",null,{"children":["关键观察",false]}],["$","p",null,{"children":"正文明确让记忆跨试次保留，并进一步从多个任务的较好试次构造元记忆。生成的经验数远少于行动数，显示记忆在压缩历史；摘要也报告新环境与新任务上的迁移收益，超出只修补本题。"}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"控制器结合任务和记忆提出子目标，执行器转成有效环境动作。试次结束后，记忆生成器综合轨迹与结果，更新关于必要动作或无贡献动作的半结构化句子，再从跨任务经验生成更一般的元记忆。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"作者在 ScienceWorld 中报告同任务重复尝试的持续改善，也在新环境或任务上观察到零样本迁移及后续适应。结果对应文本模拟器和所用模型，支持记忆层的累积收益，不能外推到任意开放环境。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"因果抽象由语言模型根据有限轨迹生成，并非通过严格干预实验识别的因果规律。控制器、执行器和生成器均冻结；环境还提供可行动作信息，所以表现包含模拟器接口对搜索空间的帮助。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：适合测试错误规律进入记忆后能否被反例推翻，并将环境变化分为配置变化与规则变化。另可用清空记忆、保留原始轨迹和保留抽象三种对照，衡量抽象到底提供了多少跨任务收益。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"编辑归类为持久系统优化：更新后的经验会影响未来试次和不同任务，而非只修订当前输出。其贡献在于学习产物的保留与迁移；记忆生成算法仍固定，没有证明负责下一轮学习的程序自身被改进。"}]]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"来源与核验范围"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。核心洞察、局限分析、关联分类与未来展望含本站解读；论文观察与实验结果在其原始设置下成立。摘要级核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2310.10134",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2310.10134","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要、作者和首次提交记录：持续适应与迁移结果。"}]]}],["$","li","https://arxiv.org/html/2310.10134v1",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2310.10134v1","target":"_blank","rel":"noreferrer","children":["因果记忆与元记忆方法"," ↗"]}],["$","span",null,{"children":"第 3.1–3.3 节：冻结模块、因果句式、不确定性、跨试次更新和元记忆。"}]]}]]}],["$","span",null,{"children":["arXiv:","2310.10134"," · v1"," / REVIEWED ","2026.09.12"]}]]}]

13:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
14:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"model 可能写出错误事实、无法运行的程序或不合适的文本，仅要求它重新想一遍并不保证发现问题。论文研究黑盒 model 如何利用外部工具验证自己的初稿，让批评具有可检查的信息依据。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CRITIC: Large Language Models Can Self-Correct with Tool-Interactive Critiquing · v4","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Model 自己检查事实或计算，容易与初稿共享同一个错误。CRITIC 研究让 Critique 访问搜索、代码执行等工具，用额外证据推动当前答案修订。价值在于把纠错过程连接到可观察结果。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CRITIC: Large Language Models Can Self-Correct with Tool-Interactive Critiquing · v4","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"Self-Refine 使用同源语言反馈，ReAct 已让推理调用工具。CRITIC 将外部工具集中用于 Verify→Correct 循环：先检查已有答案，再用得到的批评改写。这依然主要是 Test-time Refinement，基本方法没有持久更新权重或工具实现。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2303.17651",{"href":"#reference-2303.17651","aria-label":"来源 2: Self-Refine: Iterative Refinement with Self-Feedback","children":["[",2,"]"]}],["$","a","2210.03629",{"href":"#reference-2210.03629","aria-label":"来源 3: ReAct: Synergizing Reasoning and Acting in Language Models","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"如果错误来自缺少事实，反复措辞调整不会增加信息。先让 Model 指出可检查的断言，再调用适合的工具，就能为修订增加独立线索。搜索适合事实、执行器适合计算；反馈形式不同，但都可以转成下一轮修改条件。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2303.17651",{"href":"#reference-2303.17651","aria-label":"来源 2: Self-Refine: Iterative Refinement with Self-Feedback","children":["[",2,"]"]}],["$","a","2210.03629",{"href":"#reference-2210.03629","aria-label":"来源 3: ReAct: Synergizing Reasoning and Acting in Language Models","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"feedback 的价值来自验证带来的新增信息，而不只是多生成一段批评文字。编辑理解是，CRITIC 把 self-correction 拆成检查与修改两个环节：model 既要选择有用的检查，也要正确理解结果，才能改善初稿。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: CRITIC: Large Language Models Can Self-Correct with Tool-Interactive Critiquing · v4","children":["[",1,"]"]}]]}]]}]]]}]]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}]

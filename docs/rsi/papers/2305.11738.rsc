,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"model 可能写出错误事实、无法运行的程序或不合适的文本，仅要求它重新想一遍并不保证发现问题。论文研究黑盒 model 如何利用外部工具验证自己的初稿，让批评具有可检查的信息依据。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"feedback 的价值来自验证带来的新增信息，而不只是多生成一段批评文字。编辑理解是，CRITIC 把 self-correction 拆成检查与修改两个环节：model 既要选择有用的检查，也要正确理解结果，才能改善初稿。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],"$L10"]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"正文把工具封装为文本输入输出函数，验证轨迹可以多轮交互；实际实验按任务预先指定工具。算法依据批评是否认为答案正确来停止，所以工具结果、model 对结果的解释和停止决定共同影响可靠性。"}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"model 先基于原输入生成答案，再调用合适工具检查相关属性，将工具回执与批评接到初稿后重新生成。验证与修正循环重复，直到批评认为无需再改或达到轮数限制，全程采用 context 示例而非任务 fine-tuning。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"作者在自由形式问答、数学程序合成和文本毒性降低三类任务中报告改善，并强调 external feedback 的重要性。这些结果支持工具辅助的当前 Output Refinement，没有证明改正一次答案后，model 会永久掌握相应能力。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"工具能够提供证据，但检索内容或自动评价也会有误差；实现中的工具选择由研究者按任务配置。无参数更新且没有跨任务经验保存，因此不能从迭代次数增加推断长期学习，更不能推断无界 self-improvement。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：可以把错误发现、错误定位、修订正确率和正确答案保留率分别统计，再比较同预算的重采样。若把修订轨迹进一步用于训练，应独立检查新任务迁移，避免把工具贡献全部归于 model 自身。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"编辑归类为 Output Refinement：改动对象是这次任务的答案或代码，循环在单次求解内闭合。它为 RSI 研究提供验证环节的设计经验，尤其适合与纯内生 reflection 对照，以识别有效学习信号究竟来自何处。"}]]}]

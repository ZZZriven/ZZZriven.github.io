14:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
15:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"能生成代码不代表能可靠完成仓库级修复：model 还要定位文件、编辑局部、读懂错误并执行测试。论文研究这些操作的接口设计如何影响成功率，以及普通命令行为何可能消耗大量无效步骤。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: SWE-agent: Agent-Computer Interfaces Enable Automated Software Engineering · v3","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"软件维护需要定位文件、理解代码、精确编辑和测试。普通 Shell 输出对 LLM 往往过长，编辑操作又容易产生语法错误。SWE-agent 研究 ACI 的设计如何匹配 Model 的输入限制与动作能力，使固定 Model 更可靠地完成仓库级任务。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: SWE-agent: Agent-Computer Interfaces Enable Automated Software Engineering · v3","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"ReAct 提供交互模式，Reflexion 研究利用反馈改善重试。SWE-agent 更聚焦接口：哪些搜索结果、文件视图和编辑反馈适合 LLM。原文 ACI 由研究者设计与消融，Agent 主要修改用户任务仓库；不能把这些补丁归为 Agent 对自身工具的演化。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2210.03629",{"href":"#reference-2210.03629","aria-label":"来源 2: ReAct: Synergizing Reasoning and Acting in Language Models","children":["[",2,"]"]}],["$","a","2303.11366",{"href":"#reference-2303.11366","aria-label":"来源 3: Reflexion: Language Agents with Verbal Reinforcement Learning","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"同一个程序员换一个好编辑器会更高效，Model 也会受接口影响。长搜索结果占据 Context，缺少行号让编辑难定位，失败后若看不到修改结果又会重复犯错。因此应把接口设计拆成可控制因素，再逐项观察 Agent 行为，而非将所有失败归因于 Model 能力。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2210.03629",{"href":"#reference-2210.03629","aria-label":"来源 2: ReAct: Synergizing Reasoning and Acting in Language Models","children":["[",2,"]"]}],["$","a","2303.11366",{"href":"#reference-2303.11366","aria-label":"来源 3: Reflexion: Language Agents with Verbal Reinforcement Learning","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Agent 的表现取决于 foundation model 与操作环境的配合。紧凑编辑、清楚 feedback 和适量 context 可以改变同一 model 的有效能力；编辑理解是，系统层改进应把工具造成的摩擦与 model 本身的知识缺口分开测量。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: SWE-agent: Agent-Computer Interfaces Enable Automated Software Engineering · v3","children":["[",1,"]"]}]]}]]}]]]}]]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"阅读已固定版本的原文 Background、方法与主要结果，结合下列相关文献撰写。Paper Claim 表示作者报告，未独立复现；Inference 包括数学教学推演与 Idea Reconstruction。One-Week Reproduction、Counterexample 和 Follow-up 均为待执行提案，Novelty 尚需更全面的文献与实验检验。"}],["$","ol",null,{"children":[["$","li","paper",{"id":"reference-paper","children":[["$","a",null,{"href":"https://arxiv.org/html/2405.15793v3","target":"_blank","rel":"noreferrer","children":["[",1,"] ","SWE-agent: Agent-Computer Interfaces Enable Automated Software Engineering · v3"," ↗"]}],["$","span",null,{"children":"原文 Background、Method / Formalization 与主要实验或理论结论。数字沿用原文设置；未独立运行完整实验。"}]]}],["$","li","2210.03629",{"id":"reference-2210.03629","children":[["$","a",null,{"href":"https://arxiv.org/abs/2210.03629v3","target":"_blank","rel":"noreferrer","children":["[",2,"] ","ReAct: Synergizing Reasoning and Acting in Language Models"," ↗"]}],["$","span",null,{"children":"相关方法与研究背景；用于说明具体差异，不能替代对本篇结论的验证。"}]]}],["$","li","2303.11366",{"id":"reference-2303.11366","children":[["$","a",null,{"href":"https://arxiv.org/abs/2303.11366v4","target":"_blank","rel":"noreferrer","children":["[",3,"] ","Reflexion: Language Agents with Verbal Reinforcement Learning"," ↗"]}],["$","span",null,{"children":"相关方法与研究背景；用于说明具体差异，不能替代对本篇结论的验证。"}]]}]]}],["$","span",null,{"children":["arXiv:","2405.15793"," · ","v3"," / REVIEWED ","2026.09.13"]}]]}]

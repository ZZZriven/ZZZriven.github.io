1f:["$","section","reproduction",{"id":"reproduction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"10"}],["$","div",null,{"children":[["$","h2",null,{"children":"One-Week Reproduction"}],["$","p",null,{"className":"section-question","children":"用一周检验一个最小且明确的命题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"Day 1–2：准备十个小仓库修复任务。Day 3–5：比较原始 Shell、有限窗口 Viewer 和带检查的 Editor，固定 Model。Day 6–7：分析定位失败、语法破坏、测试遗漏及成本，避免只统计最终 Patch 是否生成。"}],"$undefined",null]}]]]}]]}]
20:["$","section","counterexample",{"id":"counterexample","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"11"}],["$","div",null,{"children":[["$","h2",null,{"children":"Counterexample Design"}],["$","p",null,{"className":"section-question","children":"如何构造有辨识力的反例？"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"构造必须同时查看远距离两个函数才能理解的问题。若窗口化接口降低了全局线索可见性，导致错误局部修复，就能展示 Context 节省的适用边界。"}],"$undefined",null]}]]]}]]}]

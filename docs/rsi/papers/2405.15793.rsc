 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv 原文",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2405.15793v3","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"阅读 PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"ABSTRACT / 摘要"}],["$","p",null,{"children":"通过更适合模型的搜索、编辑、反馈与上下文接口，提升在真实代码仓库中的问题修复能力。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"改进对象"}],["$","dd",null,{"children":"软件工程接口与工具"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"反馈来源"}],["$","dd",null,{"children":"仓库搜索结果、编辑后的内容、语法检查、代码执行与测试输出。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"证据边界"}],["$","dd",null,{"children":"核验摘要、v3 元数据及正文第 2–5 节；数字对应原论文完整集与 Lite 子集，未独立复现。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"能生成代码不代表能可靠完成仓库级修复：模型还要定位文件、编辑局部、读懂错误并执行测试。论文研究这些操作的接口设计如何影响成功率，以及普通命令行为何可能消耗大量无效步骤。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"智能体的表现取决于基础模型与操作环境的配合。紧凑编辑、清楚反馈和适量上下文可以改变同一模型的有效能力；编辑理解是，系统层改进应把工具造成的摩擦与模型本身的知识缺口分开测量。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":["$L10","$L11","$L12"]}]]}],"$L13","$L14","$L15","$L16"]}],"$L17","$L18","$L19","$L1a"]}],"$L1b"]}]]}]
10:["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}]
11:["$","h2",null,{"children":["关键观察",false]}]
12:["$","p",null,{"children":"消融中，逐条查看搜索命中可能让模型穷尽无关结果，整文件展示也可能比适当窗口更差。编辑后的语法检查有助于阻止错误传播；这些现象说明给出更多信息或更多自由度并不必然改善操作。"}]
13:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"设计少量搜索、定位、文件查看与局部编辑命令，在修改后直接展示新内容并检查语法。系统压缩旧观察，保留当前关键信息；模型交替提出操作和读取执行反馈，直至提交修复补丁。"}]]}]]}]
14:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"原论文中，GPT-4 Turbo 配合该接口在完整 SWE-bench 上解决 12.47% 的任务，在 Lite 子集解决 18.00%。这些是特定历史模型与预算下的修复成绩，用于说明接口设计作用，不代表当前最高水平。"}]]}]]}]
15:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"接口来自人工行为分析和配置搜索，运行中的智能体没有自动演化自身工具。它修改的是目标仓库，基础模型也冻结。因此代码修改、执行反馈与高分修复本身，均不足以构成递归自我改进。"}]]}]]}]
16:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：可以把接口作为自改进目标，要求候选版本在未见仓库、同模型与同预算下比较，并保留操作失败率。这样能检验新的工具究竟提高通用修复效率，还是只适应某个基准的文件模式。"}]]}]]}]
17:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"编辑归类为相关能力基础：RSI 系统若要编辑自己的实现，需要可靠的代码定位、修改和验证组件。SWE-agent 提供这一工程前提，但原论文实验没有让工具的产物回过头来增强其自身改进能力。"}]]}]
18:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"来源与核验范围"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。核心洞察、局限分析、关联分类与未来展望含本站解读；论文观察与实验结果在其原始设置下成立。摘要级核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2405.15793",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2405.15793","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"题名、作者、日期与 v3 版本记录。"}]]}],["$","li","https://arxiv.org/html/2405.15793v3",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2405.15793v3","target":"_blank","rel":"noreferrer","children":["接口设计、结果与消融"," ↗"]}],["$","span",null,{"children":"第 2–5 节，表 1 和表 3：人工设计流程、冻结模型、完整集及 Lite 成绩与接口消融。"}]]}]]}],["$","span",null,{"children":["arXiv:","2405.15793"," · v3"," / REVIEWED ","2026.09.12"]}]]}]

2 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2308.08998v2","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"Read PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"SUMMARY"}],["$","p",null,{"children":"把候选生成与 model 更新分开，重复利用经过 reward 筛选的数据，并明确呈现多轮 reward 上升与人类评价之间的差距。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Improvement Target"}],["$","dd",null,{"children":"Model Weights & Sampled Data"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Feedback"}],["$","dd",null,{"children":"reward model 为自生成候选打分；递增阈值选择训练数据，人工评价用于独立检查自动 reward 与真实偏好是否一致。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"Evidence Scope"}],["$","dd",null,{"children":"已核验 arXiv 摘要与 v2 历史，正文第 3 节 Grow/Improve、第 4 节实验及第 6 节 reward overfitting 讨论；未复现。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"online reinforcement learning 需要反复采样，language model 训练成本高且数据利用率有限。论文研究能否先离线生成候选，再多次筛选和训练，以更少的采样改进 model，并考察这种 self-training 循环是否真正提高人类感知的输出质量。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"生成新数据和学习已有数据不必以相同频率发生。把昂贵采样放在外层，内层逐步提高筛选标准，可以复用同一批候选；但收益首先受 reward model 衡量，因此必须区分 reward 增长与真实质量增长这两个问题。"}]]}]]}],"$L10","$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"机器翻译实验中，简单 behavior cloning 损失优于所比较的若干 offline reinforcement learning 损失。更多 Grow 轮次仍能提高 reward 分数，人工评价却以一次 Grow 更好；这一差异直接揭示了反复针对固定 reward 优化的局限。"}]]}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"Grow 阶段用当前 policy 为输入生成多个候选；Improve 阶段依据 reward 阈值筛选数据并更新 policy，逐步提高阈值且复用样本。完成若干 Improve 后，再用更新后的 policy 生成下一批数据，形成跨轮保留 weights 的闭环。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"作者在机器翻译 benchmark 上报告自动指标与人工评价改善，并展示离线数据复用的效率收益。进一步迭代能继续提升所用 reward，却未持续改善人工评价；结果支持有限有效的 self-training，而非单调、无上限的质量增长。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"实验依赖机器翻译领域已有的 reward model，任务覆盖有限。固定 reward 作为人类偏好的代理会被反复优化所放大，候选探索范围又受当前 policy 约束；reward 阈值越严格，也不意味着留下的数据覆盖越全面。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：应将人工抽检或独立验证 feedback 用于更新 reward model，并设置在独立质量停滞时停止的规则。还需报告每轮新增数据的多样性、筛选后覆盖与实际采样成本，辨别更高 reward 究竟来自学习还是利用代理漏洞。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"更新后的 policy 承担下一轮候选生成，weights 跨轮保留，属于 Persistent System Improvement。Grow/Improve 机制及 reward 设计保持外部给定，没有实证表明 model 会修改自身的训练算法。"}]]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。Insight、Limitations、Relation to RSI 与 Outlook 含本站解读；Observation 与 Results 在论文原始设置下成立。基于 abstract 的核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2308.08998",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2308.08998","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要与版本历史：作者、日期、离线采样复用及机器翻译实验范围。"}]]}],["$","li","https://arxiv.org/html/2308.08998v2",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2308.08998v2","target":"_blank","rel":"noreferrer","children":["训练闭环与人类评价边界"," ↗"]}],["$","span",null,{"children":"全文第 3—4 节：Grow/Improve 和损失比较；第 6 节：多轮 reward 上升但人工评价未继续提高。"}]]}]]}],["$","span",null,{"children":["arXiv:","2308.08998"," · v2"," / REVIEWED ","2026.09.12"]}]]}]

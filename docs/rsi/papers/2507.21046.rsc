28:["$","section","takeaways",{"id":"takeaways","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"08"}],["$","div",null,{"children":[["$","h2",null,{"children":"Takeaways"}],["$","p",null,{"className":"section-question","children":"这篇论文改变了哪些判断？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"最值得继承的是独立维度。本站将 Context 中的 Prompt 与 Memory 分开浏览，并再记录 Role、Persistence 与 Evidence，使读者能问“同样更新 Model 的方法，究竟更新了 Solver 还是 Judge”。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Survey of Self-Evolving Agents: What, When, How, and Where to Evolve on the Path to Artificial Super Intelligence · v4","children":["[",1,"]"]}]]}]]}]]]}]]}]

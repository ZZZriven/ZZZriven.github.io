1c:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
1d:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"model 训练、memory 管理、prompt optimization 和 multi-Agent collaboration 常被分散研究，但部署后的系统需要连续适应新任务。论文要解决的是如何为这些不同形式的演化建立共同定义，并明确自主性发生在哪个环节。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Survey of Self-Evolving Agents: What, When, How, and Where to Evolve on the Path to Artificial Super Intelligence · v4","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Self-Evolving Agents 同时涉及模型、Context、工具和协作流程，若按方法名称堆叠，很难找到共同问题。这篇 Survey 用 What、When、How 和应用场景组织研究，让读者分开思考更新对象、发生时机与驱动机制。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Survey of Self-Evolving Agents: What, When, How, and Where to Evolve on the Path to Artificial Super Intelligence · v4","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"STaR 改变 Model，Voyager 累积 Skill，ADAS 搜索 Agent 结构。这些已有工作说明适应不只发生在参数层。Survey 将它们放入更宽的 Self-Evolution 框架，涵盖训练及测试时适应；它的覆盖范围比严格要求 Improver 被持续更新的 RSI 更宽。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2203.14465",{"href":"#reference-2203.14465","aria-label":"来源 2: STaR: Bootstrapping Reasoning With Reasoning","children":["[",2,"]"]}],["$","a","2305.16291",{"href":"#reference-2305.16291","aria-label":"来源 3: Voyager: An Open-Ended Embodied Agent with Large Language Models","children":["[",3,"]"]}],["$","a","2408.08435",{"href":"#reference-2408.08435","aria-label":"来源 4: Automated Design of Agentic Systems","children":["[",4,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"同一 Agent 可以在训练阶段学参数，在部署后积累记忆，在单次任务内调整 Context。若把这些工作放入互斥桶，时间尺度与对象会混淆。先问改哪里，再问何时改、用何种反馈改，就能保留多种方法的共同点，同时解释同一技术为何出现在不同场景。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2203.14465",{"href":"#reference-2203.14465","aria-label":"来源 2: STaR: Bootstrapping Reasoning With Reasoning","children":["[",2,"]"]}],["$","a","2305.16291",{"href":"#reference-2305.16291","aria-label":"来源 3: Voyager: An Open-Ended Embodied Agent with Large Language Models","children":["[",3,"]"]}],["$","a","2408.08435",{"href":"#reference-2408.08435","aria-label":"来源 4: Automated Design of Agentic Systems","children":["[",4,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":["$L22","$L23","$undefined","$L24"]}]]]}]]}],"$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c"]}]

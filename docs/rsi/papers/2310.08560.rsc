 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2310.08560v2","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"Read PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"SUMMARY"}],["$","p",null,{"children":"通过分层存储、memory 读写和 control flow，让固定 context model 处理长期对话与超出窗口的文档。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Improvement Target"}],["$","dd",null,{"children":"Context & External Memory"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Feedback"}],["$","dd",null,{"children":"memory 函数执行结果、容量预警、用户新信息与检索结果。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"Evidence Scope"}],["$","dd",null,{"children":"核验摘要、版本历史、正文第 2 节与第 3 节实验设定；未独立复现，未逐项复核实验表格。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"长对话和大型文档会超过 model 的 context 容量，直接截断又会丢失用户偏好与早期事实。论文研究能否把信息保存在外部，并让 model 按需调入当前窗口，使连续交互不必总从头开始。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"可供保存的信息量与一次 reasoning 能访问的信息量可以分开设计。MemGPT 将 context 视为稀缺工作区，由 model 主动决定记住什么、检索什么；编辑理解是，长期 Agent 首先需要可靠保留经验的基础设施。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":["$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","h2",null,{"children":["Observation",false]}]
11:["$","p",null,{"children":"正文展示 model 收到容量预警后写入 memory，也能根据对话更新用户信息；函数执行错误会返回当前 context。实验覆盖对话一致性、个性化开场和跨文档检索，因此主要观测对象是 memory 使用能力。"}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"系统把输入分为只读 instruction、可写工作 memory 与消息队列，另设历史和归档存储。model 以 function calling 读写与检索，队列管理器在容量不足时清理并摘要，连续调用机制支持多步取回信息再作答。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"作者在长对话和文档分析任务中报告优于固定 context baseline 的表现，并展示嵌套键值检索。收益说明外部存储可以缓解窗口限制；论文没有把它转换为 foundation model 参数更新或多代 improver 增强的结果。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"系统 instruction、函数接口和队列管理规则由设计者提供，model 能改变 memory 内容，不能据此推定它优化了管理算法。检索成功也不等于 memory 真实，长期存储的完整性与长期 reasoning 可靠性仍需分别评价。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：可加入过期事实、互相矛盾的记录和长时间未访问的信息，检验纠错、遗忘与溯源机制。将同预算的长 context 和 external memory 方法比较，还能判断收益来自更好选择信息还是更多 model 调用。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"编辑归类为 Persistent System Improvement：model 主动更新 external memory，并在后续交互中检索使用，改变了保留的系统状态。本文证据主要支持长期对话与文档任务；这不等于独立新任务能力持续增长，也不涉及 memory 管理算法的 self-modification。"}]]}]

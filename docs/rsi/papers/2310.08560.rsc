ng-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"长对话和大型文档会超过模型的上下文容量，直接截断又会丢失用户偏好与早期事实。论文研究能否把信息保存在外部，并让模型按需调入当前窗口，使连续交互不必总从头开始。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"可供保存的信息量与一次推理能访问的信息量可以分开设计。MemGPT 将上下文视为稀缺工作区，由模型主动决定记住什么、检索什么；编辑理解是，长期智能体首先需要可靠保留经验的基础设施。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],"$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","h2",null,{"children":["关键观察",false]}]
11:["$","p",null,{"children":"正文展示模型收到容量预警后写入记忆，也能根据对话更新用户信息；函数执行错误会返回当前上下文。实验覆盖对话一致性、个性化开场和跨文档检索，因此主要观测对象是记忆使用能力。"}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"系统把输入分为只读指令、可写工作记忆与消息队列，另设历史和归档存储。模型以函数调用读写与检索，队列管理器在容量不足时清理并摘要，连续调用机制支持多步取回信息再作答。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"作者在长对话和文档分析任务中报告优于固定上下文基线的表现，并展示嵌套键值检索。收益说明外部存储可以缓解窗口限制；论文没有把它转换为基础模型参数更新或多代改进器增强的结果。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"系统指令、函数接口和队列管理规则由设计者提供，模型能改变记忆内容，不能据此推定它优化了管理算法。检索成功也不等于记忆真实，长期存储的完整性与长期推理可靠性仍需分别评价。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：可加入过期事实、互相矛盾的记录和长时间未访问的信息，检验纠错、遗忘与溯源机制。将同预算的长上下文和外部记忆方法比较，还能判断收益来自更好选择信息还是更多模型调用。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"编辑归类为持久系统优化：模型主动更新外部记忆，并在后续交互中检索使用，改变了保留的系统状态。本文证据主要支持长期对话与文档任务；这不等于独立新任务能力持续增长，也不涉及记忆管理算法的自修改。"}]]}]
17:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"来源与核验范围"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。核心洞察、局限分析、关联分类与未来展望含本站解读；论文观察与实验结果在其原始设置下成立。摘要级核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2310.08560",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2310.08560","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要、作者、首次提交日期与 v2 更新日期。"}]]}],["$","li","https://arxiv.org/html/2310.08560v2",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2310.08560v2","target":"_blank","rel":"noreferrer","children":["分层记忆与实验设定"," ↗"]}],["$","span",null,{"children":"第 2 节及第 3 节开头：记忆分层、队列、函数链、对话及文档任务。"}]]}]]}],["$","span",null,{"children":["arXiv:","2310.08560"," · v2"," / REVIEWED ","2026.09.12"]}]]}]

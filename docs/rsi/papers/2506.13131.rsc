1a:["$","section","method",{"id":"method","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"05"}],["$","div",null,{"children":[["$","h2",null,{"children":"Method & Worked Example"}],["$","p",null,{"className":"section-question","children":"沿着输入、处理、输出走完 Pipeline。"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"prompt 采样器从程序数据库组织历史候选，由 Gemini model 组合提出代码修改；自动 evaluator 检查、运行并打分，数据库通过演化选择保留有价值的程序，再 feedback 给下一轮生成与改写过程。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: AlphaEvolve: A coding agent for scientific and algorithmic discovery · v1","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"原文包括矩阵乘法算法与基础设施优化。沿用矩阵乘法任务：输入初始算法程序、允许修改区和评价函数；LLM 提议代码变化，先做低成本正确性检查，再评价有效运算或性能；数据库保存源码与多个分数，下一轮抽取候选及历史提示继续搜索。输出是经指定验证的算法，而非自动更新后的 Foundation Model。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: AlphaEvolve: A coding agent for scientific and algorithmic discovery · v1","children":["[",1,"]"]}]]}]]}]]]}]]}]
1b:["$","section","mathematics",{"id":"mathematics","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"06"}],["$","div",null,{"children":[["$","h2",null,{"children":"Mathematical Foundations"}],["$","p",null,{"className":"section-question","children":"从符号、直觉与简单例子理解理论。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"外层是程序空间搜索，内层评价可以包含正确性与资源指标。Evaluation Cascade 的直觉是先用便宜的必要条件过滤，再投入更贵的充分检查。通过有限测试只支持测试范围内正确；若某项数学结果有独立证明，应明确使用的是证明而非经验评分。数据库多样性帮助探索，却不提供全局最优保证。"}],["$","pre",null,{"className":"math-block","aria-label":"数学表达式","children":"Candidate program → cheap checks → expensive evaluation\nStore (code, correctness evidence, performance metrics)\nSelection reuses evaluated programs under a fixed pipeline"}],["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: AlphaEvolve: A coding agent for scientific and algorithmic discovery · v1","children":["[",1,"]"]}]]}]]}]]]}]]}]
1c:["$","section","experiments",{"id":"experiments","children":[[["$","span","results",{"className":"anchor-alias","id":"results"}],["$","span","observation",{"className":"anchor-alias","id":"observation"}]],["$","span",null,{"className":"reading-section-number","children":"07"}],["$","div",null,{"children":[["$","h2",null,{"children":"Experiments & Claims"}],["$","p",null,{"className":"section-question","children":"Research Question → Experiment → Answer"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"Question：这种搜索能否产生有实际价值的算法？→ Experiment：在数学问题、调度、硬件与训练组件等具体任务验证候选，并与既有实现比较。→ Answer：白皮书报告多种发现；不同应用的验证方式和资源条件不同，不应把一个案例的效率收益推广到全部任务。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: AlphaEvolve: A coding agent for scientific and algorithmic discovery · v1","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"论文报告用 48 次标量乘法完成复数 4×4 矩阵乘法的算法。在训练工程案例中，所发现的启发式在目标内核集合上平均提速 23%，对应总体训练时间减少约 1%；内核速度、训练时间和 model 能力是不同指标。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: AlphaEvolve: A coding agent for scientific and algorithmic discovery · v1","children":["[",1,"]"]}]]}]]}]]]}]]}]
1d:["$","section","takeaways",{"id":"takeaways","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"08"}],["$","div",null,{"children":[["$","h2",null,{"children":"Takeaways"}],["$","p",null,{"className":"section-question","children":"这篇论文改变了哪些判断？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"AlphaEvolve 强调可执行评价与搜索基础设施的结合。论文的外部算法发现证据很强地依赖 Evaluator 设计，是否构成递归改进还要看新算法被谁、以什么方式重新使用。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: AlphaEvolve: A coding agent for scientific and algorithmic discovery · v1","children":["[",1,"]"]}]]}]]}]]]}]]}]
1e:["$","section","assumptions",{"id":"assumptions","children":[[["$","span","limits",{"className":"anchor-alias","id":"limits"}]],["$","span",null,{"className":"reading-section-number","children":"09"}],["$","div",null,{"children":[["$","h2",null,{"children":"Most Fragile Assumption"}],["$","p",null,{"className":"section-question","children":"哪一个假设失效会动摇方法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"最脆弱的假设是自动评价覆盖了真正需求。程序可以对固定输入、硬件或数值精度过拟合，尤其当搜索次数很多时，微小评价漏洞也可能被放大。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: AlphaEvolve: A coding agent for scientific and algorithmic discovery · v1","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"核验 arXiv 摘要、方法和工程案例相关章节，未复现内部部署或通读全部白皮书。任务目标和自动 evaluator 仍由研究者定义；加速 foundation model 的训练基础设施，不等于已经自动再训练并接替多代发现 Agent。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: AlphaEvolve: A coding agent for scientific and algorithmic discovery · v1","children":["[",1,"]"]}]]}]]}]]]}]]}]
1f:["$","section","reproduction",{"id":"reproduction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"10"}],["$","div",null,{"children":[["$","h2",null,{"children":"One-Week Reproduction"}],["$","p",null,{"className":"section-question","children":"用一周检验一个最小且明确的命题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"Day 1–2：选择一个小型数值或组合优化函数，写独立正确性测试。Day 3–5：进行有预算的代码演化，比较只采样与带数据库选择。Day 6–7：在未见输入和另一运行配置重测，并报告整个搜索成本。"}],"$undefined",null]}]]]}]]}]
20:["$","section","counterexample",{"id":"counterexample","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"11"}],["$","div",null,{"children":[["$","h2",null,{"children":"Counterexample Design"}],["$","p",null,{"className":"section-question","children":"如何构造有辨识力的反例？"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"训练评价只包含小矩阵，隐藏测试加入病态数值与不同尺寸。若候选利用固定尺寸或低精度捷径而失败，就能定位可执行评分与普遍正确性的差距。"}],"$undefined",null]}]]]}]]}]
21:["$","section","follow-up",{"id":"follow-up","children":[[["$","span","outlook",{"className":"anchor-alias","id":"outlook"}]],["$","span",null,{"className":"reading-section-number","children":"12"}],["$","div",null,{"children":[["$","h2",null,{"children":"Follow-up Research"}],["$","p",null,{"className":"section-question","children":"从缺陷与需求推导新的研究问题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"研究 Evaluator 的共同发现：搜索器提出算法时，也提出最可能让它失败的输入族，由独立验证器将反例固化为可复用规范。相对 FunBO 的固定目标函数集合，这让搜索积累的是问题结构的可检验证据。需要控制评估器变化，保留固定外部测试以防指标漂移。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2406.04824",{"href":"#reference-2406.04824","aria-label":"来源 2: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch","children":["[",2,"]"]}],["$","a","2310.02304",{"href":"#reference-2310.02304","aria-label":"来源 3: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation","children":["[",3,"]"]}]]}]]}]]]}]]}]

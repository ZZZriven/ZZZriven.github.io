14:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
15:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"复杂数学和计算工程问题的解空间巨大，单次代码生成难以找到超越专家优化的算法。论文研究如何把 language model 的程序建议与反复执行评价结合，在可测量目标上持续改进候选解决方案。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: AlphaEvolve: A coding agent for scientific and algorithmic discovery · v1","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"许多科学和工程问题能写成程序并自动评估，但好算法仍依赖大量创造性搜索。AlphaEvolve 研究将 LLM 的代码生成与演化数据库、分级评价和并行计算结合，用反复可执行验证筛选候选。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: AlphaEvolve: A coding agent for scientific and algorithmic discovery · v1","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"FunBO 利用代码搜索发现 Acquisition Functions，STOP 研究改进 Improver。AlphaEvolve 主要搜索给定任务的算法源码，具有更广的任务与工程应用。优化训练基础设施可能间接帮助后续模型，但原报告未展示这些收益自动闭合成下一代研究者继续改进自己的完整链条。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2406.04824",{"href":"#reference-2406.04824","aria-label":"来源 2: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch","children":["[",2,"]"]}],["$","a","2310.02304",{"href":"#reference-2310.02304","aria-label":"来源 3: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"LLM 能提出人可读的程序变体，但单次提案可靠性不足。自动执行器能快速拒绝错误，数据库能保留互补实现，分级测试则可把昂贵评估留给有希望的候选。由此将创造性提案与确定性核验分工，再用演化选择累积有用改动。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2406.04824",{"href":"#reference-2406.04824","aria-label":"来源 2: FunBO: Discovering Acquisition Functions for Bayesian Optimization with FunSearch","children":["[",2,"]"]}],["$","a","2310.02304",{"href":"#reference-2310.02304","aria-label":"来源 3: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"model 负责提出有创造性的变体，evaluator 负责判定正确性和性能，演化过程则决定哪些程序进入未来 prompt。将提案与验证分工，使生成错误不必直接变成被接受的发现，并支持多目标 search。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: AlphaEvolve: A coding agent for scientific and algorithmic discovery · v1","children":["[",1,"]"]}]]}]]}]]]}]]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]

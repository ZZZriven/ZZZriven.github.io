m","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"复杂数学和计算工程问题的解空间巨大，单次代码生成难以找到超越专家优化的算法。论文研究如何把 language model 的程序建议与反复执行评价结合，在可测量目标上持续改进候选解决方案。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"model 负责提出有创造性的变体，evaluator 负责判定正确性和性能，演化过程则决定哪些程序进入未来 prompt。将提案与验证分工，使生成错误不必直接变成被接受的发现，并支持多目标 search。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],"$L10"]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"论文将应用范围集中在能以执行或明确指标评价的数学与计算任务，并展示调度、电路及训练内核案例。候选以可读代码表示，便于检验和部署，但评价机制仍需针对任务定义，不能覆盖所有科学研究。"}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"prompt 采样器从程序数据库组织历史候选，由 Gemini model 组合提出代码修改；自动 evaluator 检查、运行并打分，数据库通过演化选择保留有价值的程序，再 feedback 给下一轮生成与改写过程。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"论文报告用 48 次标量乘法完成复数 4×4 矩阵乘法的算法。在训练工程案例中，所发现的启发式在目标内核集合上平均提速 23%，对应总体训练时间减少约 1%；内核速度、训练时间和 model 能力是不同指标。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"核验 arXiv 摘要、方法和工程案例相关章节，未复现内部部署或通读全部白皮书。任务目标和自动 evaluator 仍由研究者定义；加速 foundation model 的训练基础设施，不等于已经自动再训练并接替多代发现 Agent。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：可追踪改进方案从离线评价到真实部署的收益保真度，并测试评价成本高或目标变化时的表现。要证明 recursive enhancement，还需测量改进基础设施后，下一轮算法发现是否稳定变得更有效。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"该系统以 execution feedback 演化外部算法和计算工程方案。论文也报告加速支撑自身 foundation model 的训练，因此与 AI 改进链条相关；但未展示这些收益自动产生更强 model，再由新 model 接手多代算法发现的闭环。"}]]}]

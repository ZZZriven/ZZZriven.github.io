14:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
15:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"无需昂贵的 model fine-tuning，Agent 能否从试错中有效学习？"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Reflexion: Language Agents with Verbal Reinforcement Learning · v4","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Agent 失败后重新开始，容易重复同一条错误行动。Fine-Tuning 可以积累经验，却对在线交互显得昂贵。Reflexion 研究能否将环境反馈转成简短的语言记忆，让固定 Model 在下一次尝试时避开已知失败。价值来自重试成本的降低。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Reflexion: Language Agents with Verbal Reinforcement Learning · v4","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"ReAct 已让 Agent 交替思考、行动和读取 Observation，但基本轨迹本身不要求将失败总结保留到下次尝试。Reflexion 在 Actor 和 Evaluator 之外加入 Self-Reflection，并将总结放进 Episodic Memory，使后续 Trial 能直接利用上次的教训。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2210.03629",{"href":"#reference-2210.03629","aria-label":"来源 2: ReAct: Synergizing Reasoning and Acting in Language Models","children":["[",2,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"二元失败信号只告诉系统没成功，长轨迹又包含大量无关细节。LLM 擅长把过程压缩成语言解释，因而可以尝试将失败定位为可执行的建议。把建议放回下一次 Actor 的输入，就形成低成本的策略调整。关键不确定性是这份总结能否正确归因，而非仅凭结果编故事。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2210.03629",{"href":"#reference-2210.03629","aria-label":"来源 2: ReAct: Synergizing Reasoning and Acting in Language Models","children":["[",2,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Reflexion 将任务成败转译成下次尝试可读取的语言经验，使 feedback 不仅停留在一个分数上。reflection memory 改变后续决策时的 context，因而是跨尝试的系统状态更新；这为分析 nonparametric learning 提供了实例，也把 feedback 可靠性变成核心变量。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Reflexion: Language Agents with Verbal Reinforcement Learning · v4","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","method",{"id":"method","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"05"}],["$","div",null,{"children":[["$","h2",null,{"children":"Method & Worked Example"}],["$","p",null,{"className":"section-question","children":"沿着输入、处理、输出走完 Pipeline。"}],["$L1a","$L1b"]]}]]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"阅读已固定版本的原文 Background、方法与主要结果，结合下列相关文献撰写。Paper Claim 表示作者报告，未独立复现；Inference 包括数学教学推演与 Idea Reconstruction。One-Week Reproduction、Counterexample 和 Follow-up 均为待执行提案，Novelty 尚需更全面的文献与实验检验。"}],["$","ol",null,{"children":[["$","li","paper",{"id":"reference-paper","children":[["$","a",null,{"href":"https://arxiv.org/html/2303.11366v4","target":"_blank","rel":"noreferrer","children":["[",1,"] ","Reflexion: Language Agents with Verbal Reinforcement Learning · v4"," ↗"]}],["$","span",null,{"children":"原文 Background、Method / Formalization 与主要实验或理论结论。数字沿用原文设置；未独立运行完整实验。"}]]}],["$","li","2210.03629",{"id":"reference-2210.03629","children":[["$","a",null,{"href":"https://arxiv.org/abs/2210.03629v3","target":"_blank","rel":"noreferrer","children":["[",2,"] ","ReAct: Synergizing Reasoning and Acting in Language Models"," ↗"]}],["$","span",null,{"children":"相关方法与研究背景；用于说明具体差异，不能替代对本篇结论的验证。"}]]}],["$","li","2608.28264v1",{"id":"reference-2608.28264v1","children":[["$","a",null,{"href":"https://arxiv.org/html/2608.28264v1","target":"_blank","rel":"noreferrer","children":["[",3,"] ","Finding Where the Buck Stops: An Automated Failure Attribution-Based Reflection Framework for Multi-Agent Collaboration"," ↗"]}],["$","span",null,{"children":"Follow-up 的相关工作核查；晚于原论文的研究仅用于评估提案，不作为作者当时的知识或动机。"}]]}]]}],["$","span",null,{"children":["arXiv:","2303.11366"," · ","v4"," / REVIEWED ","2026.09.13"]}]]}]

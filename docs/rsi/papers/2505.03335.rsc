ldren":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"reasoning 训练能否减少对人工编写训练题目的依赖？"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"AZR 把训练分布也交给 model 学习：出题角色寻找具有学习价值的任务，解题角色学习完成任务，两者共享 model。代码 executor 将这一循环固定在可验证的环境中，使 curriculum 变化能够与 model 更新相互作用，降低人工题库的供给压力。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],"$L10"]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"正文将程序、输入、输出三元组组织成归纳、溯因与演绎任务，并报告仅以自生成代码 reasoning 任务训练后，数学评估也有增益。不同 foundation model 和规模的收益不同，说明零外部训练题库仍依赖 pre-training 先验与可验证环境的能力。"}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"同一 model 联合学习出题与解题，以程序、输入、输出构造归纳、溯因和演绎任务；代码 executor 验证任务与答案，出题侧获得学习价值 feedback，解题侧获得正确性 reward。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"作者在代码与数学 reasoning 评估中观察到能力提升，并在多个 model 规模和 model 类别上验证方法。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"零外部数据指这一训练过程不使用外部题库；系统仍依赖 pretrained model、执行环境和人为设计的 reward 机制。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：值得分开测量 curriculum 多样性、难度适配和求解能力的贡献，并用独立任务检验跨领域迁移。扩展到非代码环境时，关键是构造可靠 verifier，同时避免 model 只挑选易获 reward 的任务而逐渐缩窄训练分布。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"同一 model 同时学习出题和解题，curriculum 与求解能力共同变化，属于 model 与 curriculum 的持久优化。代码 executor 与训练更新流程固定；本库不将训练角色共同变化自动等同于显式 Improver Self-Modification。"}]]}]

12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2502.12110v11","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"Read PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"SUMMARY"}],["$","p",null,{"children":"将新经验写成结构化笔记，动态建立关联并更新旧 memory 描述，让 memory 组织随经验变化。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Improvement Target"}],["$","dd",null,{"children":"Memory Structure & Semantic Representation"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Feedback"}],["$","dd",null,{"children":"新交互内容、检索到的历史笔记及 model 对关联和 context 属性的判断。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"Evidence Scope"}],["$","dd",null,{"children":"核验摘要、v11 元数据、正文第 3 节方法概览与第 4.3 节结果和 ablation；未复现实验。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"保存日志并检索相似片段，难以捕捉分散在多次交流中的关系。预先规定图结构也可能限制新知识的组织方式。论文要解决的是历史经验怎样形成可调整的知识网络，支持后续 multi-hop 问答。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"新的经历可以改变旧经历的解释，而不仅增加一条记录。A-MEM 将 memory 更新同时作用于链接与已有描述；编辑理解是，经验积累的价值取决于组织方式，memory 条目增长本身并不保证可用知识增长。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],"$L10"]}]]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","p",null,{"children":"正文结果显示收益会随 foundation model 和题型变化，复杂 multi-hop 问题更能体现关联 memory 的作用，部分简单检索题型仍有强 baseline。去掉链接生成或 memory 演化的 ablation 表现下降，支持两种更新分别有贡献。"}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"每条交互先转为包含描述、关键词和标签的笔记，并生成向量表示。系统检索有关旧 memory，由 model 判断链接、调整旧笔记属性；回答时从更新后的 memory 网络取回相关内容，作为 reasoning context。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"作者在 LoCoMo 与 DialSim 长期对话任务中报告改善，并在多种 foundation model 上比较 memory 方法。第 4.3 节同时呈现不同任务的表现和 ablation，因此应理解为这些 memory 问答设置中的增益，而非通用能力倍增。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"可持续变化的是 external memory 及其关系，foundation model 与更新 workflow 没有一起演化。memory 之间相似不代表因果或事实一致；若 model 错误重写旧描述，后续检索也可能继承错误，论文成绩不能排除此类长期风险。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：需要在信息会撤回、关系会改变的持续任务中，跟踪错误 memory 如何被识别和修正。保持原始事件与改写版本的关联，并在冻结查询集和未来查询上分别评价，可避免只改善已有题型。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"编辑归类为 Persistent System Improvement：系统保留经过重组的经验表示，用于之后的查询。它与仅在一次回答内追加 reflection 不同，但尚未展示 memory 更新器自身变强，因此不标为 Improver Self-Modification。"}]]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。Insight、Limitations、Relation to RSI 与 Outlook 含本站解读；Observation 与 Results 在论文原始设置下成立。基于 abstract 的核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2502.12110",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2502.12110","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要及版本历史：v11、作者、日期与 memory 更新目标。"}]]}],["$","li","https://arxiv.org/html/2502.12110v11",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2502.12110v11","target":"_blank","rel":"noreferrer","children":["memory 更新与实证"," ↗"]}],["$","span",null,{"children":"第 3 节方法概览、第 4.3 节及表 2–3：笔记链接、memory 演化、题型差异和 ablation。"}]]}]]}],["$","span",null,{"children":["arXiv:","2502.12110"," · v11"," / REVIEWED ","2026.09.12"]}]]}]

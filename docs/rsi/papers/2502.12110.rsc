14:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
15:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"保存日志并检索相似片段，难以捕捉分散在多次交流中的关系。预先规定图结构也可能限制新知识的组织方式。论文要解决的是历史经验怎样形成可调整的知识网络，支持后续 multi-hop 问答。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A-MEM: Agentic Memory for LLM Agents · v11","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"简单向量记忆把经历存成独立片段，难以表达新信息如何改变旧知识。长对话中的人物、计划和关系也会逐渐形成网络。A-MEM 研究如何在写入时构造结构化 Note，并动态建立链接和修订已有记忆，使后续检索能利用组织关系。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A-MEM: Agentic Memory for LLM Agents · v11","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"MemGPT 强调分层存储与主动搬运，Generative Agents 使用检索和 Reflection。A-MEM 进一步将 Note 的属性和连接作为可更新状态，借鉴原子化笔记与链接组织思想。它的 Memory Evolution 指记忆表示与关系变化，不应自动解释为底层 Memory Algorithm 已被重新编写。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2310.08560",{"href":"#reference-2310.08560","aria-label":"来源 2: MemGPT: Towards LLMs as Operating Systems","children":["[",2,"]"]}],["$","a","2304.03442",{"href":"#reference-2304.03442","aria-label":"来源 3: Generative Agents: Interactive Simulacra of Human Behavior","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"如果一次新对话同时提到旧朋友和新项目，单独存入一条记录会割裂相关信息。先检索旧 Note，再判断是否建立链接，就能把局部经历接入已有结构；新证据还可能补全旧 Note 的语境。问题随之转为如何控制错误链接和过度改写，这也是方法最需要验证的地方。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2310.08560",{"href":"#reference-2310.08560","aria-label":"来源 2: MemGPT: Towards LLMs as Operating Systems","children":["[",2,"]"]}],["$","a","2304.03442",{"href":"#reference-2304.03442","aria-label":"来源 3: Generative Agents: Interactive Simulacra of Human Behavior","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"新的经历可以改变旧经历的解释，而不仅增加一条记录。A-MEM 将 memory 更新同时作用于链接与已有描述；编辑理解是，经验积累的价值取决于组织方式，memory 条目增长本身并不保证可用知识增长。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A-MEM: Agentic Memory for LLM Agents · v11","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","method",{"id":"method","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"05"}],"$L1a"]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"阅读已固定版本的原文 Background、方法与主要结果，结合下列相关文献撰写。Paper Claim 表示作者报告，未独立复现；Inference 包括数学教学推演与 Idea Reconstruction。One-Week Reproduction、Counterexample 和 Follow-up 均为待执行提案，Novelty 尚需更全面的文献与实验检验。"}],["$","ol",null,{"children":[["$","li","paper",{"id":"reference-paper","children":[["$","a",null,{"href":"https://arxiv.org/html/2502.12110v11","target":"_blank","rel":"noreferrer","children":["[",1,"] ","A-MEM: Agentic Memory for LLM Agents · v11"," ↗"]}],["$","span",null,{"children":"原文 Background、Method / Formalization 与主要实验或理论结论。数字沿用原文设置；未独立运行完整实验。"}]]}],["$","li","2310.08560",{"id":"reference-2310.08560","children":[["$","a",null,{"href":"https://arxiv.org/abs/2310.08560v2","target":"_blank","rel":"noreferrer","children":["[",2,"] ","MemGPT: Towards LLMs as Operating Systems"," ↗"]}],["$","span",null,{"children":"相关方法与研究背景；用于说明具体差异，不能替代对本篇结论的验证。"}]]}],["$","li","2304.03442",{"id":"reference-2304.03442","children":[["$","a",null,{"href":"https://arxiv.org/abs/2304.03442v2","target":"_blank","rel":"noreferrer","children":["[",3,"] ","Generative Agents: Interactive Simulacra of Human Behavior"," ↗"]}],["$","span",null,{"children":"相关方法与研究背景；用于说明具体差异，不能替代对本篇结论的验证。"}]]}],["$","li","2608.29606v1",{"id":"reference-2608.29606v1","children":[["$","a",null,{"href":"https://arxiv.org/html/2608.29606v1","target":"_blank","rel":"noreferrer","children":["[",4,"] ","Agent Zero Memory: Provenance-Aware Long-Term Memory for LLM Agents"," ↗"]}],["$","span",null,{"children":"Follow-up 的相关工作核查；晚于原论文的研究仅用于评估提案，不作为作者当时的知识或动机。"}]]}]]}],["$","span",null,{"children":["arXiv:","2502.12110"," · ","v11"," / REVIEWED ","2026.09.13"]}]]}]

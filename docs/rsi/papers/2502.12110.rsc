1f:["$","section","reproduction",{"id":"reproduction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"10"}],["$","div",null,{"children":[["$","h2",null,{"children":"One-Week Reproduction"}],["$","p",null,{"className":"section-question","children":"用一周检验一个最小且明确的命题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"Day 1–2：准备有明确人物、时间和变化记录的对话。Day 3–5：比较平面向量检索、只加链接、链接加更新三组。Day 6–7：检查问答准确率、实体误连率和每次写入改动的旧 Note 数量，保持检索 Token Budget 一致。"}],"$undefined",null]}]]]}]]}]
20:["$","section","counterexample",{"id":"counterexample","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"11"}],["$","div",null,{"children":[["$","h2",null,{"children":"Counterexample Design"}],["$","p",null,{"className":"section-question","children":"如何构造有辨识力的反例？"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"安排两个同名人物拥有相似职业但相反偏好，让其中一人的新信息出现。如果系统更新了另一人的 Note，随后相关问题连续出错，就能定位到动态组织中的污染通道。"}],"$undefined",null]}]]]}]]}]
21:["$","section","follow-up",{"id":"follow-up","children":[[["$","span","outlook",{"className":"anchor-alias","id":"outlook"}]],["$","span",null,{"className":"reading-section-number","children":"12"}],["$","div",null,{"children":[["$","h2",null,{"children":"Follow-up Research"}],["$","p",null,{"className":"section-question","children":"从缺陷与需求推导新的研究问题。"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"后续相关工作 Agent Zero Memory 已为长期记忆设计来源与证据追踪。给记忆增加来源、时间或引用本身已有直接先例。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2608.29606v1",{"href":"#reference-2608.29606v1","aria-label":"来源 4: Agent Zero Memory: Provenance-Aware Long-Term Memory for LLM Agents","children":["[",4,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"研究 Memory Update 的事务语义：把一次改写视为带依赖关系的事务，用独立证据检查后提交，冲突时可局部回滚。相对 MemGPT 的存储层管理，这关注记忆网络更新的可靠性条件。应检验一次错误能否被限制在局部，以及回滚是否恢复下游答案，而非只加一个置信度字段。 更值得检验的问题是多条依赖记录在冲突更新后如何一致地撤销：构造一个错误上游事实影响多个策略的场景，比较仅检索来源与显式依赖事务的恢复行为，要求恢复下游决策且保留不受影响的知识。这里的新颖性主张仅是待验证的研究方向。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2310.08560",{"href":"#reference-2310.08560","aria-label":"来源 2: MemGPT: Towards LLMs as Operating Systems","children":["[",2,"]"]}],["$","a","2304.03442",{"href":"#reference-2304.03442","aria-label":"来源 3: Generative Agents: Interactive Simulacra of Human Behavior","children":["[",3,"]"]}],["$","a","2608.29606v1",{"href":"#reference-2608.29606v1","aria-label":"来源 4: Agent Zero Memory: Provenance-Aware Long-Term Memory for LLM Agents","children":["[",4,"]"]}]]}]]}]]]}]]}]

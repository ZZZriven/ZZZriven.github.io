ath",{"d":"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2212.10560v2","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"Read PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"SUMMARY"}],["$","p",null,{"children":"由少量人工种子任务扩展 instruction、输入与答案，经筛选后，再训练原 model，是自生成监督进入 model weights 的基础方法。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Improvement Target"}],["$","dd",null,{"children":"Training Data & Model Weights"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Feedback"}],["$","dd",null,{"children":"人工种子任务确定初始范围；synthetic data 经过相似度、重复与格式筛选，最终答案作为 supervised fine-tuning 目标。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"Evidence Scope"}],["$","dd",null,{"children":"已核验 arXiv 摘要、版本历史及正文第 2 节方法、第 4 节数据规模与质量分析；未复现实验。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"instruction tuning 依赖人工编写任务与答案，成本之外还受任务多样性限制。论文研究能否从少量种子任务出发，让 pretrained model 生成足够丰富的监督，再用于提升同一 model 对新 instruction 的适应能力，并通过独立任务检验效果。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"model 已有的知识未必能直接转化为稳定的 instruction following 行为；让 model 先构造任务与示例，再把这些示例整理成训练信号，可以把分散能力转成可调用行为。关键是监督的组织与筛选，而不是把所有自生成答案都当成事实。"}]]}]]}],"$L10","$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"作者发现先生成输入再给答案，会使分类任务偏向某些标签，因此改为先列标签再生成对应输入。数据规模与质量实验也显示，更大且更高质量的 instruction 集能够继续改善表现，说明生成量和监督可靠性需要分别考察。"}]]}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"以人工种子任务建立任务池，混合抽取人工和已生成 instruction 作示例；model 依次生成新 instruction、判断任务类型，再按类型生成输入输出。通过相似度、重复与格式规则过滤数据，最后以标准 supervised learning fine-tuning 原 model。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"论文在 Super-NaturalInstructions 上报告，相对原始 GPT3 的分数提高 33 个百分点；新编 instruction 的人工评价同样显示改进。结果支持自生成 instruction 作为训练资源的有效性，不能由此推断每个合成答案都正确。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"方法仍依赖人工种子任务及 pre-training 知识，启发式去重也不等于事实验证。正文主要展示数据池扩展后对原 model 的 fine-tuning，没有证明更新后的 model 反复接管数据生成后，能力还能跨多个训练循环持续增长。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：应追踪多轮 model 更新后任务覆盖、答案错误率与保留能力的共同变化。可以加入独立 verifier 及新任务 held-out set，检验 generator 变强后是否带来更好的下一轮监督，而非仅让 instruction 形式越来越接近训练集。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"方法使用自生成并筛选的 instruction 数据 fine-tuning 原 model，参数变化保留在目标系统中，因此属于 Persistent System Improvement。实验没有展示 fine-tuning 后的 model 反复接手多轮数据生成，也没有改写数据生成或训练算法，不能据此认定 Improver Self-Modification。"}]]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。Insight、Limitations、Relation to RSI 与 Outlook 含本站解读；Observation 与 Results 在论文原始设置下成立。基于 abstract 的核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2212.10560",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2212.10560","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要与版本历史：题名、作者、首次日期、v2 日期及主要评价结论。"}]]}],["$","li","https://arxiv.org/html/2212.10560v2",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2212.10560v2","target":"_blank","rel":"noreferrer","children":["数据生成与 fine-tuning 方法"," ↗"]}],["$","span",null,{"children":"全文第 2.2—2.3 节：分类任务生成次序、筛选规则、fine-tuning；第 4 节图 7：数据规模与质量分析。"}]]}]]}],["$","span",null,{"children":["arXiv:","2212.10560"," · v2"," / REVIEWED ","2026.09.12"]}]]}]

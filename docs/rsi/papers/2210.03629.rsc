a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2210.03629v3","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"Read PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"SUMMARY"}],["$","p",null,{"children":"交替进行 reasoning、行动和环境观察，在执行过程中获取新信息并调整计划，是 feedback 式 Agent 的基础组件。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Improvement Target"}],["$","dd",null,{"children":"Reasoning & Acting Workflow"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Feedback"}],["$","dd",null,{"children":"任务接口返回的检索内容、环境状态及动作结果。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"Evidence Scope"}],["$","dd",null,{"children":"核验摘要、v3 元数据与正文第 1–2 节；主结果范围依据摘要和引言，未复核全部实验。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"只在内部生成 reasoning 容易延续错误事实，只预测动作又难以跟踪子目标和异常。论文研究如何把语言 reasoning 与环境交互放进同一过程，使计划能依据新证据更新，行动也能主动补充 reasoning 所缺的信息。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"一次行动既能推进目标，也能产生新的认识。ReAct 让 reasoning 指导何时查询与操作，再让观察约束后续 reasoning；编辑理解是，它解决了 feedback 从哪里进入决策的问题，却没有自动解决经验怎样跨任务保留的问题。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":["$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","h2",null,{"children":["Observation",false]}]
11:["$","p",null,{"children":"原文区分密集交替的知识 reasoning 与只在关键位置出现思考的交互决策。正文也指出问答中的较好组合会同时利用内部知识与外部检索，说明固定地增加思考或固定地调用工具并非唯一有效 strategy。"}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"用少量包含思考、动作与观察的示例，对冻结 model 进行 prompting。动作调用任务接口获取结果，文字 reasoning 用于分解目标、提炼观察和修订计划；持续追加的任务 context 连接这些步骤，直至作答或完成环境任务。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"作者在问答、事实核验、文本环境和网页操作任务中报告有效性，并分析相对仅 reasoning 或仅行动的差异。主实验是 few-shot prompting 执行，成绩反映当次任务求解能力，而非多轮自主更新后的通用能力增长。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"核心 prompt 范式没有持久学习模块，也不要求修改 model parameters、prompt optimization 器或自身代码。论文另有初步 fine-tuning 实验，但不能因此把主方法的每次观察都说成参数学习，或把任务内重规划称为 Recursive Self-Improvement。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：可控制工具调用与 inference budget，分别测量检索有效性、计划修订和错误恢复。将成功与失败轨迹沉淀为未来可用经验时，应另设未见任务检验，确认效果确实来自学习而非重复同一题。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"编辑归类为相关能力基础：它提供 environment feedback 参与决策的 workflow，能够作为 memory 学习、self-correction 或 self-modification 系统的执行层。要形成持久 self-improvement，还需要额外的经验保存、更新目标和独立改进验证机制。"}]]}]
17:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。Insight、Limitations、Relation to RSI 与 Outlook 含本站解读；Observation 与 Results 在论文原始设置下成立。基于 abstract 的核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2210.03629",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2210.03629","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要、作者、日期和 v3 记录；四类实验任务与总体发现。"}]]}],["$","li","https://arxiv.org/html/2210.03629v3",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2210.03629v3","target":"_blank","rel":"noreferrer","children":["reasoning 与行动方法"," ↗"]}],["$","span",null,{"children":"第 1–2 节：冻结 model、任务内 context、密集与稀疏 reasoning，以及 fine-tuning 扩展的区分。"}]]}]]}],["$","span",null,{"children":["arXiv:","2210.03629"," · v3"," / REVIEWED ","2026.09.12"]}]]}]

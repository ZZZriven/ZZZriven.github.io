pan",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"只依据当前 prompt 生成角色行为，很难保持与过去经历、关系和计划的一致性。论文研究如何让虚拟角色记住互动，在新情境中使用经验，并自然产生邀请、协作等持续发展的社会行为。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"原始观察与对观察的解释承担不同作用：事实记录支撑回忆，高层 reflection 把分散经历压缩成可用于计划的判断。编辑理解是，这种分工启发经验系统，但可信的角色塑造与客观能力提升是不同目标。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":["$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","h2",null,{"children":["Observation",false]}]
11:["$","p",null,{"children":"作者展示从初始聚会意图发展出的邀请传播与协调到场，并用 ablation 说明观察、规划、reflection 对行为可信度各有贡献。原文中的 recursive reflection 指对旧 reflection 继续抽象，没有指向 model 训练或改进算法的 recursive self-modification。"}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"memory 流记录自然语言事件及时间信息；检索综合近期程度、重要性和情境相关度，周期性从经历提出问题并生成高层 reflection。相关 memory 与 reflection 进入计划过程，使行为能够回应历史和环境变化。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"论文在由 25 个 Agent 组成的交互沙盒中展示连贯个体行为与涌现社交行为。其主要实证支持模拟行为更可信，并不提供在科研、编码或其他独立能力任务上随代际增长的实验结果。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"人物背景、模拟环境及 memory 与 reflection 规则由研究者设定，评价目标偏向可信度。即使角色能形成新关系或抽象认识，也不能从文字上像学习的行为推断 foundation model weights 改变或得到可靠因果知识。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：若用于能力研究，应为角色引入明确任务和独立验证，测量 reflection 是否提高后续新任务成功率。还需对 reflection 的事实依据建立追踪，区分从真实观察形成的知识与从旧猜测经 recursion 生成的叙事。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"编辑归类为 Persistent System Improvement：memory 流与高层 reflection 会保留，并参与后续计划和行为。这里的优化证据针对行为可信度与连贯性，不能外推为科研或编码能力持续增长；固定的 reflection 规则也没有被系统重新设计。"}]]}]

 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv 原文",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2304.03442v2","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"阅读 PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"IN A NUTSHELL"}],["$","p",null,{"children":"记录智能体经历，检索相关事件并提炼高层反思，生成具有长期连贯性的个体和群体行为。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"改进对象"}],["$","dd",null,{"children":"经历记忆与行为规划"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"反馈来源"}],["$","dd",null,{"children":"模拟环境观察、互动记录及模型对记忆重要性与高层关系的判断。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"证据边界"}],["$","dd",null,{"children":"核验摘要、元数据、正文第 3.4 节案例和第 4.1–4.2 节架构；消融结论依据摘要，未复核用户实验。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"只依据当前提示生成角色行为，很难保持与过去经历、关系和计划的一致性。论文研究如何让虚拟角色记住互动，在新情境中使用经验，并自然产生邀请、协作等持续发展的社会行为。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"原始观察与对观察的解释承担不同作用：事实记录支撑回忆，高层反思把分散经历压缩成可用于计划的判断。编辑理解是，这种分工启发经验系统，但可信的角色塑造与客观能力提升是不同目标。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],"$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","h2",null,{"children":["关键观察",false]}]
11:["$","p",null,{"children":"作者展示从初始聚会意图发展出的邀请传播与协调到场，并用消融说明观察、规划、反思对行为可信度各有贡献。原文中的递归反思指对旧反思继续抽象，没有指向模型训练或改进算法的递归修改。"}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"记忆流记录自然语言事件及时间信息；检索综合近期程度、重要性和情境相关度，周期性从经历提出问题并生成高层反思。相关记忆与反思进入计划过程，使行为能够回应历史和环境变化。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"论文在由 25 个智能体组成的交互沙盒中展示连贯个体行为与涌现社交行为。其主要实证支持模拟行为更可信，并不提供在科研、编码或其他独立能力任务上随代际增长的实验结果。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"人物背景、模拟环境及记忆与反思规则由研究者设定，评价目标偏向可信度。即使角色能形成新关系或抽象认识，也不能从文字上像学习的行为推断基础模型权重改变或得到可靠因果知识。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：若用于能力研究，应为角色引入明确任务和独立验证，测量反思是否提高后续新任务成功率。还需对反思的事实依据建立追踪，区分从真实观察形成的知识与由旧猜测递归生成的叙事。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"编辑归类为持久系统优化：记忆流与高层反思会保留，并参与后续计划和行为。这里的优化证据针对行为可信度与连贯性，不能外推为科研或编码能力持续增长；固定的反思规则也没有被系统重新设计。"}]]}]
17:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"来源与核验范围"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。核心洞察、局限分析、关联分类与未来展望含本站解读；论文观察与实验结果在其原始设置下成立。摘要级核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2304.03442",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2304.03442","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要与版本历史：作者、日期、25 个智能体的设置及消融概述。"}]]}],["$","li","https://arxiv.org/html/2304.03442v2",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2304.03442v2","target":"_blank","rel":"noreferrer","children":["互动案例与记忆反思"," ↗"]}],["$","span",null,{"children":"第 3.4 节、第 4.1–4.2 节：关系记忆、协调行为、检索打分及高层反思。"}]]}]]}],["$","span",null,{"children":["arXiv:","2304.03442"," · v2"," / REVIEWED ","2026.09.12"]}]]}]

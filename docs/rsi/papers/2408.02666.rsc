00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv 原文",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2408.02666v2","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"阅读 PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"ABSTRACT / 摘要"}],["$","p",null,{"children":"从未标注偏好的指令构造优劣回答对，让评判模型生成并筛选判断理由，再用这些理由反复训练评判能力。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"改进对象"}],["$","dd",null,{"children":"评判模型权重"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"反馈来源"}],["$","dd",null,{"children":"回答对的预设合成优劣关系校验模型判断；与预设关系一致的理由和标签成为下一轮监督训练数据。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"证据边界"}],["$","dd",null,{"children":"已核验 arXiv 摘要与 v2 历史，正文第 3 节合成回答对与迭代流程，以及第 5 节评判结果；未复现实验。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"评判模型既用于训练奖励，也用于模型比较，但人工偏好数据昂贵且会随着被评模型变化而过时。论文研究能否只用合成训练信号提升评判者，让它不断产生更有用的判断理由，而无需追加人工偏好标签。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"先构造预期存在优劣关系的回答对，就能把难以收集的真实偏好问题转成对已知合成关系的判断问题。评判者生成的理由经过关系检查后成为下一轮训练数据，使评价能力本身进入自训练循环。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":["$L10","$L11","$L12"]}]]}],"$L13","$L14","$L15","$L16"]}],"$L17","$L18","$L19","$L1a"]}],"$L1b"]}]]}]
10:["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}]
11:["$","h2",null,{"children":["关键观察",false]}]
12:["$","p",null,{"children":"正文通过扰动原指令再回答，构造相对于原指令较差的回答；模型生成的判断只在与构造关系一致时保留。随评判能力提高，可筛选出的训练样本也会变化，形成由当前能力决定的课程，但该关系仍是合成假设。"}]
13:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"选择未带偏好标注的指令，生成正常回答及针对扰动指令的回答作为对照。当前评判模型多次生成判断和理由，保留选中预期优胜答案的轨迹，再监督微调模型；重复上述过程以更新下一轮评判者。"}]]}]]}]
14:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"摘要报告，Llama3-70B-Instruct 在 RewardBench 上由 75.4 提升至 88.3，多数投票可到 88.7。该结果针对评判能力，不能直接换算为被训练助手的任务收益；部署为奖励来源后的效果仍需单独评价。"}]]}]]}]
15:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"无需人工偏好标签不等于无需人工来源的指令，也不等于每个合成优劣关系都可靠。扰动可能改变任务而非单纯降低质量，筛选还会继承初始评判者偏差；固定基准提升不保证对新模型或新错误类型同样有效。"}]]}]]}]
16:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：最有价值的检验是把迭代评判者接入真实策略训练，测量独立任务质量是否随之提升。需要同时检查位置偏差、分布迁移和难以人为构造的细微错误，防止评判模型只学会识别合成数据的表面痕迹。"}]]}]]}]
17:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"评判模型权重更新后负责下一轮判断，属于持久系统优化中的反馈能力改进。尽管被改进的是评判者，数据构造、筛选和训练程序仍固定，不能仅因其提供训练信号就称为改进器自修改。"}]]}]
18:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"来源与核验范围"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。核心洞察、局限分析、关联分类与未来展望含本站解读；论文观察与实验结果在其原始设置下成立。摘要级核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2408.02666",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2408.02666","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要与版本历史：作者、日期、RewardBench 分数及多数投票条件。"}]]}],["$","li","https://arxiv.org/html/2408.02666v2",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2408.02666v2","target":"_blank","rel":"noreferrer","children":["合成偏好与迭代评判"," ↗"]}],["$","span",null,{"children":"全文第 3 节及图 2：扰动指令、回答对、判断筛选与微调；第 5 节：评判结果和比较协议。"}]]}]]}],["$","span",null,{"children":["arXiv:","2408.02666"," · v2"," / REVIEWED ","2026.09.12"]}]]}]

12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"作者在所设定的理论条件下，得到随样本量下降的 error bound，以及对初始化依赖随迭代减弱的结论。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"论文的 best response 与 self-rewarding 由 model 内部概率定义；内部一致性保证不能直接推出外部事实正确性或人类 preference alignment，也不等于无限改进。"}]]}]]}]

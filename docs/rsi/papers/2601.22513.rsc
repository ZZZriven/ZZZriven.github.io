sName":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"没有持续的 external feedback，self-rewarding 训练为什么还可能带来改善？"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"理解 self-rewarding 要同时追踪 policy 与 reward 如何变化：本轮 model 产生的监督，又会影响下一轮的 policy。作者以 policy condition number 刻画这一耦合过程，把迭代的作用解释为内部稳定性的改善，为区分单轮训练与多轮循环提供了分析工具。"}]]}]]}],"$L10","$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"作者分别研究单步更新的困难实例与完整迭代的 error bound：在论文条件下，统计误差随样本量约按平方根倒数下降，初始化影响随轮数指数衰减。这是理论推导而非大 model 训练曲线，不能把收敛率直接读成真实 model 的能力增长率。"}]]}]]}]

1a:["$","aside",null,{"className":"reading-sidebar","children":["$","div",null,{"className":"reading-sidebar-inner","children":[["$","p",null,{"className":"overline","children":"12 QUESTIONS"}],["$","nav",null,{"aria-label":"论文阅读目录","children":[[["$","a","problem",{"href":"#problem","children":[["$","span",null,{"children":"01"}],"Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":[["$","span",null,{"children":"02"}],"Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":[["$","span",null,{"children":"03"}],"Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":[["$","span",null,{"children":"04"}],"Core Intuition"]}],["$","a","method",{"href":"#method","children":[["$","span",null,{"children":"05"}],"Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":[["$","span",null,{"children":"06"}],"Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":[["$","span",null,{"children":"07"}],"Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":[["$","span",null,{"children":"08"}],"Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":[["$","span",null,{"children":"09"}],"Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":[["$","span",null,{"children":"10"}],"One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":[["$","span",null,{"children":"11"}],"Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":[["$","span",null,{"children":"12"}],"Follow-up Research"]}]],["$","a",null,{"href":"#rsi-relation","children":"Classification & RSI Relation"}],["$","a",null,{"href":"#sources","children":"Sources & Verification"}]]}]]}]}]

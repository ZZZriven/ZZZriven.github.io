2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2403.09629v2","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"Read PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"SUMMARY"}],["$","p",null,{"children":"在普通文本的多个位置生成中间 reasoning，用其对未来文本预测的帮助训练 model，将自生成 reasoning 学习扩展到问答数据之外。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Improvement Target"}],["$","dd",null,{"children":"Model Weights & Reasoning Policy"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Feedback"}],["$","dd",null,{"children":"真实后续文本的 log-likelihood 衡量自生成 reasoning 的帮助，policy gradient 据此更新 reasoning 生成相关参数。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"Evidence Scope"}],["$","dd",null,{"children":"已核验 arXiv 摘要与 v2 历史，正文第 3—4 节目标、并行 reasoning、mixture head 及学习信号；未复现实验。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"依靠题目和正确答案训练 reasoning，会把自学习限制在已有标注任务中。论文研究普通文本能否提供足够的监督，让 model 自己提出中间解释，再根据这些解释是否有助于预测后文来学习，而不需要逐条标注思维过程。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"中间 reasoning 是否有用，可以通过它改变后续文本概率的效果来衡量。这样，未写出的解释成为可学习的隐变量，监督来自真实后文；重点是学会产生对预测有帮助的 reasoning，而非要求 reasoning 文本模仿人工标准答案。"}]]}]]}],"$L10","$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"作者发现自生成 reasoning 对较难预测的文本位置帮助更明显。刚引入思考时，reasoning 文本会偏离原 model 习惯并损害预测，因此需要混合有 reasoning 与无 reasoning 的预测；这一现象说明增加思考步骤本身并不保证即时收益。"}]]}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"在多个文本位置并行采样 reasoning，以可学习的开始和结束标记界定思考。mixture head 组合原预测与思考后的预测，再用真实后续文本的预测改善作为 REINFORCE 信号，同时更新标记及 model weights。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"摘要报告，继续 pre-training 后 GSM8K zero-shot 成绩从 5.9% 升至 10.9%，CommonsenseQA 从 36.3% 升至 47.2%，且困难词元的预测改善。这些任务没有单独 fine-tuning，但结果仍限于所研究的 model、语料和训练规模。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"预测后文更好不等于中间解释在逻辑上真实，model 仍以外部文本提供的信号学习。并行采样与额外 reasoning 增加计算需求；实验不表明系统能创造新训练算法，也不证明持续扩大 reasoning 长度会获得无界改进。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：应联合评估 reasoning 的外部可验证性、迁移收益和每单位计算的提升。可进一步学习何时需要思考，并测试在长文本或领域迁移中，预测性监督会鼓励真正的 reasoning 结构，还是主要学到局部语言规律。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"当前 model 生成 reasoning，预测 feedback 再改变其 weights 和后续 reasoning policy，属于 Persistent System Improvement。训练目标、采样与更新算法保持给定，因而与修改自身改进程序的 recursive system 有明确区别。"}]]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。Insight、Limitations、Relation to RSI 与 Outlook 含本站解读；Observation 与 Results 在论文原始设置下成立。基于 abstract 的核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2403.09629",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2403.09629","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要与版本历史：题名、作者、日期、两项 zero-shot 成绩和未作任务 fine-tuning 的条件。"}]]}],["$","li","https://arxiv.org/html/2403.09629v2",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2403.09629v2","target":"_blank","rel":"noreferrer","children":["reasoning 学习与预测目标"," ↗"]}],["$","span",null,{"children":"全文第 3 节目标；第 4.1—4.4 节：并行采样、mixture head、后续文本监督和 REINFORCE。"}]]}]]}],["$","span",null,{"children":["arXiv:","2403.09629"," · v2"," / REVIEWED ","2026.09.12"]}]]}]

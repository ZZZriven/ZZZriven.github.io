16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv 原文",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2403.09629v2","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"阅读 PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"ABSTRACT / 摘要"}],["$","p",null,{"children":"在普通文本的多个位置生成中间推理，用其对未来文本预测的帮助训练模型，将自生成推理学习扩展到问答数据之外。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"改进对象"}],["$","dd",null,{"children":"模型权重与推理生成策略"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"反馈来源"}],["$","dd",null,{"children":"真实后续文本的对数似然衡量自生成推理的帮助，策略梯度据此更新推理生成相关参数。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"证据边界"}],["$","dd",null,{"children":"已核验 arXiv 摘要与 v2 历史，正文第 3—4 节目标、并行推理、混合头及学习信号；未复现实验。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"依靠题目和正确答案训练推理，会把自学习限制在已有标注任务中。论文研究普通文本能否提供足够的监督，让模型自己提出中间解释，再根据这些解释是否有助于预测后文来学习，而不需要逐条标注思维过程。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"中间推理是否有用，可以通过它改变后续文本概率的效果来衡量。这样，未写出的解释成为可学习的隐变量，监督来自真实后文；重点是学会产生对预测有帮助的推理，而非要求推理文本模仿人工标准答案。"}]]}]]}],["$","section","observation",{"id":"observation","children":["$L10","$L11"]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","span",null,{"className":"reading-section-number","children":["0",3]}]
11:["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],["$","h2",null,{"children":["关键观察",false]}],["$","p",null,{"children":"作者发现自生成推理对较难预测的文本位置帮助更明显。刚引入思考时，推理文本会偏离原模型习惯并损害预测，因此需要混合有推理与无推理的预测；这一现象说明增加思考步骤本身并不保证即时收益。"}]]}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"在多个文本位置并行采样推理，以可学习的开始和结束标记界定思考。混合头组合原预测与思考后的预测，再用真实后续文本的预测改善作为 REINFORCE 信号，同时更新标记及模型权重。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"摘要报告，继续预训练后 GSM8K 零样本成绩从 5.9% 升至 10.9%，CommonsenseQA 从 36.3% 升至 47.2%，且困难词元的预测改善。这些任务没有单独微调，但结果仍限于所研究的模型、语料和训练规模。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"预测后文更好不等于中间解释在逻辑上真实，模型仍以外部文本提供的信号学习。并行采样与额外推理增加计算需求；实验不表明系统能创造新训练算法，也不证明持续扩大推理长度会获得无界改进。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：应联合评估推理的外部可验证性、迁移收益和每单位计算的提升。可进一步学习何时需要思考，并测试在长文本或领域迁移中，预测性监督会鼓励真正的推理结构，还是主要学到局部语言规律。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"当前模型生成推理，预测反馈再改变其权重和后续推理策略，属于持久系统优化。训练目标、采样与更新算法保持给定，因而与修改自身改进程序的递归系统有明确区别。"}]]}]
17:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"来源与核验范围"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。核心洞察、局限分析、关联分类与未来展望含本站解读；论文观察与实验结果在其原始设置下成立。摘要级核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2403.09629",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2403.09629","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要与版本历史：题名、作者、日期、两项零样本成绩和未作任务微调的条件。"}]]}],["$","li","https://arxiv.org/html/2403.09629v2",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2403.09629v2","target":"_blank","rel":"noreferrer","children":["推理学习与预测目标"," ↗"]}],["$","span",null,{"children":"全文第 3 节目标；第 4.1—4.4 节：并行采样、混合头、后续文本监督和 REINFORCE。"}]]}]]}],["$","span",null,{"children":["arXiv:","2403.09629"," · v2"," / REVIEWED ","2026.09.12"]}]]}]

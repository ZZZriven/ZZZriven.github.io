sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"编程问答或短代码 benchmark 不足以衡量自动 AI 研发：完成 machine learning 项目需要处理数据、训练 model、安排实验并生成有效提交。论文因此寻找可重复评价、具有明确结果和人类参照的工程任务集合。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"machine learning 竞赛同时具备现实数据、可执行目标和公开成绩，可将多步骤工程工作压缩为可评分任务。评价对象是 model 与 Agent 框架的组合，预算和试验安排因此会直接影响能力估计。"}]]}]]}],"$L10","$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"论文把数据准备、model 训练与实验运行列为主要能力，并比较资源扩展和 pre-training data contamination 的影响。这说明竞赛成绩必须结合代理实现、计算预算和任务可见性解释，不能仅凭单一分数归因为 Agent 自主学习。"}]]}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"从公开平台整理 75 项 machine learning 竞赛，构建数据与评分流程，以原竞赛公开榜单作为人类参照。研究使用开源 Agent scaffold 测试多个 model，并通过不同资源配置和污染分析考察成绩变化的来源。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"原论文最优配置 o1-preview 加 AIDE 在 16.9%的竞赛达到至少铜牌水平。这里指达到门槛的竞赛比例，并非在所有参赛者中排名前 16.9%；它也是原论文历史结果，不是当前公开榜单最高成绩。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"竞赛工程成绩不直接等于自主发现新算法或 Recursive Self-Improvement。数据泄漏、历史任务可见性、训练资源与代理脚手架都会影响比较；原论文的历史结果必须保留 model 和预算 context。本条核验摘要，未独立重跑竞赛。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：更适合用固定预算、held-out tasks 和版本明确的评分协议比较改进前后系统。长期评估可加入失败日志、任务约束遵守情况及跨竞赛迁移，减少把试验堆量或数据泄漏误当作能力增长。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"编者归类：这是 RSI 相关 AI 研发能力的外部测量工具，并非 self-improvement 算法。它可检测改进后的系统是否更会完成 machine learning 任务，但还需额外记录系统更新过程，才能将分数变化归因于自主学习。"}]]}]

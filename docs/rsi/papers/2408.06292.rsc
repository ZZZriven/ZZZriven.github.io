l,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"LLM 能够辅助头脑风暴或编程，但完整科研流程还包含实验规划、故障修复、结果解释与证据沟通。论文研究能否将这些环节接成可重复执行的流程，让后续想法利用此前的实验与评审信息。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"可执行实验和可检查的论文产物能把 language model 的想法落到外部证据上。将研究想法、实现计划及已完成研究保存在档案中，可以为下一轮提供探索历史，而不仅依靠一次性生成的灵感。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],"$L10"]}]]}],"$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","p",null,{"children":"正文案例既展示了有效算法修改和与日志一致的数值，也记录了猜测硬件版本、把负结果描述成进步等错误。自动生成看似完整的论文与得到可靠科学结论之间，仍存在明显的验证距离。"}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"系统从小型实验模板生成候选想法，用文献检索筛查相似工作，通过 Aider 修改代码并执行多轮实验；结果日志支持绘图和 LaTeX 写作，随后由 LLM 评审，并把想法与 feedback 加入档案。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"作者在扩散 model、language model 和 grokking 三个小规模方向展示端到端生成论文，报告每篇成本低于 15 美元。部分稿件超过其自动评审器的录用阈值；这一指标不等于论文经过真实会议独立录用。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"原论文依赖人工提供的研究方向、初始模板和评价流程；示范主要是小规模 machine learning 实验。自动评审有偏差，写作也可能错误解释数据。本条核读方法、案例与局限材料，未复核全部生成论文。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：应优先建立日志到论断的逐项核验、独立实验复现与盲评，再研究哪些发现真正改善后续研究。衡量单位成本产生的可靠新知识，比仅统计生成论文数量更能反映科研能力。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"该系统自动生成研究想法、运行实验并形成论文，属于自主科研能力与研究产物优化。原文把将科研发现回流为自身能力、以及研究自身代码列为后续方向，因此当前实验不构成自身系统的 recursive optimization 闭环。"}]]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。Insight、Limitations、Relation to RSI 与 Outlook 含本站解读；Observation 与 Results 在论文原始设置下成立。基于 abstract 的核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2408.06292",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2408.06292","target":"_blank","rel":"noreferrer","children":["arXiv 原始论文"," ↗"]}],["$","span",null,{"children":"摘要与元数据"}]]}],["$","li","https://arxiv.org/html/2408.06292v3",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2408.06292v3","target":"_blank","rel":"noreferrer","children":["方法、案例与局限正文"," ↗"]}],["$","span",null,{"children":"第 3 至 5 节、实验概览及局限材料核读；未通读生成论文附件"}]]}],["$","li","https://arxiv.org/html/2408.06292v3#S9",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2408.06292v3#S9","target":"_blank","rel":"noreferrer","children":["arXiv：分类与更新范围核验"," ↗"]}],["$","span",null,{"children":"核对论文的优化目标、被冻结的组件、更新范围及与系统 self-modification 的区别。"}]]}]]}],["$","span",null,{"children":["arXiv:","2408.06292"," · v3"," / REVIEWED ","2026.09.12"]}]]}]

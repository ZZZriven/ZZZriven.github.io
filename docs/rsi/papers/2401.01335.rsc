"$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"完成 supervised fine-tuning 后，继续使用相同示范做常规训练未必有效，收集新的偏好标签又增加成本。论文研究能否保留既有高质量示范，让 model 自己产生不断变化的对比回答，从而挖掘同一批人工数据尚未发挥的监督价值。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"固定示范并不意味着学习难度固定：如果作为对照的生成回答随着 model 进步而变化，同一示范就能持续提供新的区分信号。self-play 在这里是更新训练对手的机制，目标仍由原始示范分布锚定。"}]]}]]}],"$L10","$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"作者观察到 supervised fine-tuning 后的回答与示范仍存在质量差距，例如流畅回答可能加入无依据的细节。旧 model 生成的数据把这些实际偏差暴露出来，随后 model 在多类 benchmark 上获得改进，而不是单纯重复拟合相同的正例。"}]]}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"从已 supervised fine-tuning 的 model 出发，用上一轮 model 为示范中的 prompt 生成回答，将其与人工示范配对。当前 model 通过论文构造的对比目标区分两类分布；训练完成后替换旧对手，再采样新的生成回答继续下一轮。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"论文报告通用知识、reasoning 和对话等 benchmark 上的改善，部分比较中优于额外使用 AI 偏好数据的 DPO baseline。理论分析给出目标分布对应最优解的条件，但这与真实大 model 在任意有限训练条件下达到该解不同。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"无需新增标注并不等于无需人工数据：高质量示范始终是正例和目标来源。理论结论依赖设定及可优化性，有限数据与 model 容量会限制提升；把生成回答统一当作对照，也可能忽略优于示范的候选。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：可研究正例质量不齐时的稳健目标，并在新领域检验多轮训练的迁移与遗忘。尤其应记录被视为负例的生成回答有多少其实更好，避免固定示范成为能力上限或把真实改进误当作需要压低的偏差。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"同一 model 的更新版本在后续轮次成为对手，训练 weights 跨轮保留，因此归为 Persistent System Improvement。对比目标和更新规则由研究者设计，未由 model 自主重写，不能将 self-play 名称直接解释为 Improver Self-Modification。"}]]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。Insight、Limitations、Relation to RSI 与 Outlook 含本站解读；Observation 与 Results 在论文原始设置下成立。基于 abstract 的核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2401.01335",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2401.01335","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要与版本历史：题名、作者、日期、实验范围及理论结论的作者陈述。"}]]}],["$","li","https://arxiv.org/html/2401.01335v3",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2401.01335v3","target":"_blank","rel":"noreferrer","children":["self-play 与监督锚点"," ↗"]}],["$","span",null,{"children":"全文第 4 节及图 1：示范与生成回答差距；第 4.1 节：当前玩家、旧 model 对手及跨轮替换。"}]]}]]}],["$","span",null,{"children":["arXiv:","2401.01335"," · v3"," / REVIEWED ","2026.09.12"]}]]}]

rXiv 原文",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2410.10762","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"阅读 PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"IN A NUTSHELL"}],["$","p",null,{"children":"把工作流优化写成代码空间搜索，用蒙特卡洛树搜索的变体组织候选、执行反馈和修改经验，减少人工编排。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"改进对象"}],["$","dd",null,{"children":"工作流结构与提示"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"反馈来源"}],["$","dd",null,{"children":"任务执行成绩与树结构修改经验"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"证据边界"}],["$","dd",null,{"children":"六个基准；搜索空间、执行模型与评价函数受设定限制"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"复杂任务往往需要多个模型调用及明确的执行顺序，但人工编排成本高；自动方法也容易被固定结构和低效搜索限制。论文希望同时探索提示与控制流程，并有效复用失败和成功的修改经验。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"工作流可以视作模型调用节点与代码表达的连接关系。将搜索历史保存成树，能够从多个有潜力的候选继续扩展；将常见操作组成算子，则可为巨大代码空间提供便于搜索的先验结构。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],["$","h2",null,{"children":["关键观察",false]}],["$","p",null,{"children":"正文实际搜索主要放开提示与连接代码，而固定模型、温度和输出格式以控制复杂度。树结构保存父子修改经验，执行器提供任务成绩，使候选选择不仅依赖语言模型对自身方案的评价。"}]]}]]}],"$L10","$L11","$L12","$L13"]}],"$L14","$L15","$L16","$L17"]}],"$L18"]}]]}]
10:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"AFlow循环执行候选选择、LLM代码扩展、工作流执行评价和经验回传，使用MCTS变体平衡探索与利用。搜索在给定算子集合内推进，到预算上限或满足收敛条件时选择表现较好的工作流。"}]]}]]}]
11:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"论文摘要报告六个数据集上相对比较基线平均提升5.7%，并展示小模型配合优化流程的成本优势。这些结果支持工作流搜索的实用价值，但具体优势依赖任务、执行模型与所比较的流程。"}]]}]]}]
12:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"自动化发生在人工指定的任务、算子、评价函数和搜索预算内；主要实验并未同时搜索模型权重或评测标准。文中的低推理费用比较也不应自动解释成包含离线搜索成本的全部生命周期成本。"}]]}]]}]
13:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：后续应同时报告搜索开销、部署调用量和跨任务迁移收益，判断何时能摊薄优化成本。若把算子创建或搜索策略也交给系统修改，需要单独检验这些修改是否提升未来搜索效率。"}]]}]]}]
14:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"编者归类：属于系统支架的持续改进，承接ADAS的代码表达并加强搜索组织。搜索到的工作流可被保存复用，但MCTS和扩展机制本身保持固定，因而应与改进器递归演化分开阅读。"}]]}]

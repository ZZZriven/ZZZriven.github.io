"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"复杂任务往往需要多个 model 调用及明确的执行顺序，但人工编排成本高；自动方法也容易被固定结构和低效 search 限制。论文希望同时探索 prompt 与 control flow，并有效复用失败和成功的修改经验。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"workflow 可以视作 model 调用节点与代码表达的连接关系。将 search 历史保存成树，能够从多个有潜力的候选继续扩展；将常见操作组成算子，则可为巨大代码空间提供便于 search 的先验结构。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":["$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","h2",null,{"children":["Observation",false]}]
11:["$","p",null,{"children":"正文实际 search 主要放开 prompt 与连接代码，而固定 model、温度和输出格式以控制复杂度。树结构保存父子修改经验，executor 提供任务成绩，使候选选择不仅依赖 language model 对自身方案的评价。"}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"AFlow 循环执行候选选择、LLM 代码扩展、workflow 执行评价和经验回传，使用 MCTS 变体平衡探索与利用。search 在给定算子集合内推进，到预算上限或满足收敛条件时选择表现较好的 workflow。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"论文摘要报告六个数据集上相对比较 baseline 平均提升 5.7%，并展示小 model 配合优化流程的成本优势。这些结果支持 workflow search 的实用价值，但具体优势依赖任务、执行 model 与所比较的流程。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"自动化发生在人工指定的任务、算子、评价函数和 search 预算内；主要实验并未同时 search model weights 或评测标准。文中的低 reasoning 费用比较也不应自动解释成包含离线 search 成本的全部生命周期成本。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：后续应同时报告 search 开销、部署调用量和 cross-task transfer 收益，判断何时能摊薄优化成本。若把算子创建或 search strategy 也交给系统修改，需要单独检验这些修改是否提升未来 search 效率。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"以固定 search 流程和 LLM optimizer 改写任务 workflow，保存可复用的 prompt 与节点连接，属于 Persistent System Improvement。论文区分 optimizer 和 executor；被 search 的 workflow 改善，没有展示 MCTS 或 optimizer strategy 自身被改写并接手后续 search。"}]]}]

1e:["$","section","method",{"id":"method","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"05"}],["$","div",null,{"children":[["$","h2",null,{"children":"Method & Worked Example"}],["$","p",null,{"className":"section-question","children":"沿着输入、处理、输出走完 Pipeline。"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"Generator 产生任务轨迹，Reflector 从成败中提炼经验，Curator 形成增量条目，再由确定性逻辑合入 context。条目保留标识及帮助/误导计数，通过局部更新、语义去重和 grow-and-refine 控制规模。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agentic Context Engineering: Evolving Contexts for Self-Improving Language Models · v3","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"沿用 AppWorld 的任务设置作教学演示：Generator 利用 Playbook 执行 API 任务，轨迹暴露某个查询必须分页。Reflector 提取具体错误及建议，Curator 生成增量条目并合并到已有 Playbook。下一个任务读取这条策略，输出回答及新的执行轨迹。原文覆盖 Offline Prompt 与 Online Memory 适应，部署时必须说明哪一种状态会持续保留。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agentic Context Engineering: Evolving Contexts for Self-Improving Language Models · v3","children":["[",1,"]"]}]]}]]}]]]}]]}]
1f:["$","section","mathematics",{"id":"mathematics","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"06"}],["$","div",null,{"children":[["$","h2",null,{"children":"Mathematical Foundations"}],["$","p",null,{"className":"section-question","children":"从符号、直觉与简单例子理解理论。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"可把 Playbook 看作条目集合 C，Reflection 产生增量 Δ，Curator 执行合并、修订或删除。集合符号只是解释结构，并非证明每次 Merge 都保持知识正确。整段改写的问题是高损压缩，增量更新则把风险转移到重复、冲突与过期规则；两者都需要独立评价。"}],["$","pre",null,{"className":"math-block","aria-label":"数学表达式","children":"Δ_t = Reflect(trajectory_t, feedback_t)\nC_(t+1) = Curate(C_t, Δ_t)\nTrack: retained facts, contradictions, retrieval cost"}],["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agentic Context Engineering: Evolving Contexts for Self-Improving Language Models · v3","children":["[",1,"]"]}]]}]]}]]]}]]}]
20:["$","section","experiments",{"id":"experiments","children":[[["$","span","results",{"className":"anchor-alias","id":"results"}],["$","span","observation",{"className":"anchor-alias","id":"observation"}]],["$","span",null,{"className":"reading-section-number","children":"07"}],["$","div",null,{"children":[["$","h2",null,{"children":"Experiments & Claims"}],["$","p",null,{"className":"section-question","children":"Research Question → Experiment → Answer"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"Question：结构化增量维护是否避免 Context Collapse 并改善适应？→ Experiment：在 Agent 与领域任务比较相关 Context 方法，分析更新方式、泛化及成本。→ Answer：作者报告收益，并展示整段重写造成细节骤失的案例；这支持所测设置中的维护机制，不代表 Context 越长越好。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agentic Context Engineering: Evolving Contexts for Self-Improving Language Models · v3","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"论文报告在 Agent 与金融 reasoning 任务上分别获得平均 10.6 个百分点与 8.6 个百分点的提升，并展示仅利用 execution feedback、不提供真实标签的适应效果。具体增益随 model、离线/在线设置和任务指标变化。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agentic Context Engineering: Evolving Contexts for Self-Improving Language Models · v3","children":["[",1,"]"]}]]}]]}]]]}]]}]
21:["$","section","takeaways",{"id":"takeaways","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"08"}],["$","div",null,{"children":[["$","h2",null,{"children":"Takeaways"}],["$","p",null,{"className":"section-question","children":"这篇论文改变了哪些判断？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"ACE 把 Context Maintenance 变成明确过程。保留知识与选择当前任务所需知识是两道问题，稳定地积累错误规则同样可能导致退步。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agentic Context Engineering: Evolving Contexts for Self-Improving Language Models · v3","children":["[",1,"]"]}]]}]]}]]]}]]}]
22:["$","section","assumptions",{"id":"assumptions","children":[[["$","span","limits",{"className":"anchor-alias","id":"limits"}]],["$","span",null,{"className":"reading-section-number","children":"09"}],["$","div",null,{"children":[["$","h2",null,{"children":"Most Fragile Assumption"}],["$","p",null,{"className":"section-question","children":"哪一个假设失效会动摇方法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"最脆弱的假设是历史策略仍适用于未来环境。增量写入会保护旧内容，也可能延长过期经验的寿命；错误条目一旦被重复引用，后续整理未必能识别。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agentic Context Engineering: Evolving Contexts for Self-Improving Language Models · v3","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"收益依赖 reflection 器能否从轨迹提取可靠经验；错误洞见也可能污染 memory。作者明确指出简短 instruction 适合部分任务。本条核读方法、结果摘要和局限章节，未独立复现，也不把 context 变化称为 weights 学习。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agentic Context Engineering: Evolving Contexts for Self-Improving Language Models · v3","children":["[",1,"]"]}]]}]]}]]]}]]}]
23:["$","section","reproduction",{"id":"reproduction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"10"}],["$","div",null,{"children":[["$","h2",null,{"children":"One-Week Reproduction"}],["$","p",null,{"className":"section-question","children":"用一周检验一个最小且明确的命题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"Day 1–2：建立包含分页、权限和字段变化的小 API 环境。Day 3–5：比较整段重写、纯追加和增量整理。Day 6–7：修改 API 规则，测事实保留、旧规则撤销、成功率与 Prompt 长度。"}],"$undefined",null]}]]]}]]}]
24:["$","section","counterexample",{"id":"counterexample","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"11"}],["$","div",null,{"children":[["$","h2",null,{"children":"Counterexample Design"}],["$","p",null,{"className":"section-question","children":"如何构造有辨识力的反例？"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"让早期 API 用页码分页，后期改为游标分页，并保持相同函数名。若旧策略被持续保留且压过新反馈，ACE 风格积累就可能比重新开始更差。"}],"$undefined",null]}]]]}]]}]
25:["$","section","follow-up",{"id":"follow-up","children":[[["$","span","outlook",{"className":"anchor-alias","id":"outlook"}]],["$","span",null,{"className":"reading-section-number","children":"12"}],["$","div",null,{"children":[["$","h2",null,{"children":"Follow-up Research"}],["$","p",null,{"className":"section-question","children":"从缺陷与需求推导新的研究问题。"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"后续相关工作 Agent Zero Memory 已为长期记忆设计来源与证据追踪。给记忆增加来源、时间或引用本身已有直接先例。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2608.29606v1",{"href":"#reference-2608.29606v1","aria-label":"来源 4: Agent Zero Memory: Provenance-Aware Long-Term Memory for LLM Agents","children":["[",4,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"研究有失效机制的 Playbook：每条策略附带可观测的适用条件，环境变化时优先重测相关条目，再局部撤销。相对 GEPA 的候选优化，目标是非平稳环境中知识的有效期识别。成功标准是变化后的恢复速度和错误复用减少量。 更值得检验的问题是多条依赖记录在冲突更新后如何一致地撤销：构造一个错误上游事实影响多个策略的场景，比较仅检索来源与显式依赖事务的恢复行为，要求恢复下游决策且保留不受影响的知识。这里的新颖性主张仅是待验证的研究方向。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2507.19457",{"href":"#reference-2507.19457","aria-label":"来源 2: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning","children":["[",2,"]"]}],["$","a","2310.08560",{"href":"#reference-2310.08560","aria-label":"来源 3: MemGPT: Towards LLMs as Operating Systems","children":["[",3,"]"]}],["$","a","2608.29606v1",{"href":"#reference-2608.29606v1","aria-label":"来源 4: Agent Zero Memory: Provenance-Aware Long-Term Memory for LLM Agents","children":["[",4,"]"]}]]}]]}]]]}]]}]

,null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"不断改写提示或压缩记忆时，系统容易偏爱简短摘要，丢失具体领域知识；多轮重写还可能逐渐抹掉先前经验。论文研究如何在不改权重的条件下，让上下文长期积累且保持可用。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"经验应被存成带身份和使用反馈的细粒度条目，而不只是一个每轮重写的长提示。将提炼洞见与整理存储分工，再用局部增量合并，可以减少无关知识被覆盖，并控制重复内容的增长。"}]]}]]}],["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],"$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","h2",null,{"children":["关键观察",false]}]
11:["$","p",null,{"children":"正文将既有方法的简短偏好与上下文坍缩作为动机，并用消融分析反思器、增量更新和多轮适应的贡献。作者也观察到某些任务只需要简单规则，详细上下文并非在所有领域都更有效。"}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"Generator产生任务轨迹，Reflector从成败中提炼经验，Curator形成增量条目，再由确定性逻辑合入上下文。条目保留标识及帮助/误导计数，通过局部更新、语义去重和grow-and-refine控制规模。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"论文报告在智能体与金融推理任务上分别获得平均10.6 个百分点与8.6 个百分点的提升，并展示仅利用执行反馈、不提供真实标签的适应效果。具体增益随模型、离线/在线设置和任务指标变化。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"收益依赖反思器能否从轨迹提取可靠经验；错误洞见也可能污染记忆。作者明确指出简短指令适合部分任务。本条核读方法、结果摘要和局限章节，未独立复现，也不把上下文变化称为权重学习。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：更长周期中应追踪错误条目累积、过期经验删除和新旧任务冲突，并衡量存储增长与推理成本。为每条策略保留来源、适用条件和回滚记录，有助于把持续记忆变成可审计的学习过程。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"编者归类：属于跨调用保留的记忆与上下文改进，可与Reflexion及Voyager对读。它展示经验如何沉淀进系统支架；递归修改经验整理器或提高未来学习效率，仍需要额外证据。"}]]}]
17:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"来源与核验范围"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。核心洞察、局限分析、关联分类与未来展望含本站解读；论文观察与实验结果在其原始设置下成立。摘要级核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2510.04618",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2510.04618","target":"_blank","rel":"noreferrer","children":["arXiv 原始论文"," ↗"]}],["$","span",null,{"children":"摘要与元数据"}]]}],["$","li","https://arxiv.org/html/2510.04618v3",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2510.04618v3","target":"_blank","rel":"noreferrer","children":["方法、结果与局限正文"," ↗"]}],["$","span",null,{"children":"第3节、结果摘要及Limitations and Challenges核读"}]]}]]}],["$","span",null,{"children":["arXiv:","2510.04618"," · v3"," / REVIEWED ","2026.09.12"]}]]}]

18:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
19:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"不断改写 prompt 或压缩 memory 时，系统容易偏爱简短摘要，丢失具体领域知识；多轮重写还可能逐渐抹掉先前经验。论文研究如何在不改 weights 的条件下，让 context 长期积累且保持可用。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agentic Context Engineering: Evolving Contexts for Self-Improving Language Models · v3","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"长期 Context Adaptation 会积累大量细节。每轮整段重写容易把具体教训压缩成空泛原则，甚至突然遗失大部分内容。ACE 研究如何将 Context 当作可增量维护的 Playbook，使新经验加入时保留仍然有效的旧策略。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agentic Context Engineering: Evolving Contexts for Self-Improving Language Models · v3","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"GEPA 使用执行轨迹反思来更新 Prompts，MemGPT 研究有限窗口中的长期记忆管理。ACE 关注的是 Context 内容本身的维护：生成、反思与整理分工，通过局部 Delta 和 Grow-and-Refine 降低整段重写带来的信息丢失。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2507.19457",{"href":"#reference-2507.19457","aria-label":"来源 2: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning","children":["[",2,"]"]}],["$","a","2310.08560",{"href":"#reference-2310.08560","aria-label":"来源 3: MemGPT: Towards LLMs as Operating Systems","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"若知识已经以一条条操作经验存在，加入新经验无需每次重新概括全部内容。可以先识别本次真正新增或被推翻的规则，再局部合并；累积到一定规模后专门处理重复和过时条目。这个思路类似维护结构化笔记，难点从摘要能力转向更新冲突与检索预算。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2507.19457",{"href":"#reference-2507.19457","aria-label":"来源 2: GEPA: Reflective Prompt Evolution Can Outperform Reinforcement Learning","children":["[",2,"]"]}],["$","a","2310.08560",{"href":"#reference-2310.08560","aria-label":"来源 3: MemGPT: Towards LLMs as Operating Systems","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"经验应被存成带身份和使用 feedback 的细粒度条目，而不只是一个每轮重写的长 prompt。将提炼洞见与整理存储分工，再用局部增量合并，可以减少无关知识被覆盖，并控制重复内容的增长。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Agentic Context Engineering: Evolving Contexts for Self-Improving Language Models · v3","children":["[",1,"]"]}]]}]]}]]]}]]}],"$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}]

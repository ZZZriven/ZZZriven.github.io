1b:["$","aside",null,{"className":"reading-sidebar","children":["$","div",null,{"className":"reading-sidebar-inner","children":[["$","p",null,{"className":"overline","children":"12 QUESTIONS"}],["$","nav",null,{"aria-label":"论文阅读目录","children":[[["$","a","problem",{"href":"#problem","children":[["$","span",null,{"children":"01"}],"Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":[["$","span",null,{"children":"02"}],"Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":[["$","span",null,{"children":"03"}],"Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":[["$","span",null,{"children":"04"}],"Core Intuition"]}],["$","a","method",{"href":"#method","children":[["$","span",null,{"children":"05"}],"Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":[["$","span",null,{"children":"06"}],"Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":[["$","span",null,{"children":"07"}],"Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":[["$","span",null,{"children":"08"}],"Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":[["$","span",null,{"children":"09"}],"Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":[["$","span",null,{"children":"10"}],"One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":[["$","span",null,{"children":"11"}],"Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":[["$","span",null,{"children":"12"}],"Follow-up Research"]}]],["$","a",null,{"href":"#rsi-relation","children":"Classification & RSI Relation"}],["$","a",null,{"href":"#sources","children":"Sources & Verification"}]]}]]}]}]
1c:["$","div",null,{"children":[["$","h2",null,{"children":"Method & Worked Example"}],["$","p",null,{"className":"section-question","children":"沿着输入、处理、输出走完 Pipeline。"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"从 Agent 档案中选择效用最高者分析历史结果并修改自身代码，再运行 benchmark 入档；效用综合任务得分、运行时间和费用，不更新 foundation model weights。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Self-Improving Coding Agent · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"论文记录了 Smart Edit、Context Summarization 和 Symbol Locator 等实际变化。以 Symbol Locator 为例：输入是某个符号引用及代码仓库；旧 Agent 依靠多次搜索定位定义。自我修改阶段增加 AST 定位工具，下一轮执行任务时调用它，输出定义所在文件和位置。该工具连同 Agent 源码被保留；外层评估器重新统计成本、时间和任务成功率，再决定谁接任下一轮 Meta-Agent。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Self-Improving Coding Agent · v2","children":["[",1,"]"]}]]}]]}]]]}]
1d:["$","section","mathematics",{"id":"mathematics","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"06"}],["$","div",null,{"children":[["$","h2",null,{"children":"Mathematical Foundations"}],["$","p",null,{"className":"section-question","children":"从符号、直觉与简单例子理解理论。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Utility 是三个可比较分量的加权和。Accuracy 本身在 0 到 1 之间；Cost 与 Time 先除以预算上限，再截断到 1，最后用 1 减去它们，使更便宜、更快得到更高分。原文权重为 0.5、0.25、0.25，超时还乘以 0.5。它是一项工程偏好，没有推导出唯一正确的权重。即使 Accuracy 上升，成本增加也可能让总 Utility 下降。"}],["$","pre",null,{"className":"math-block","aria-label":"数学表达式","children":"U = 0.5·accuracy\n  + 0.25·[1 − min(1, cost / $10)]\n  + 0.25·[1 − min(1, time / 300s)]\nU_final = 0.5·U if timeout, otherwise U"}],["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Self-Improving Coding Agent · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"代入一个教学数值：Accuracy=0.6、Cost=$2、Time=60 秒且未超时，三个贡献分别为 0.3、0.2、0.2，Utility=0.7。min(1,·) 把资源惩罚截断，花费达到 $10 后，Cost 项归零，继续变贵不会让该项变成负数。因而改进 Utility 有多种途径：答对更多、花钱更少或完成更快。比较版本时应同时展示三项，否则一个更便宜但答对更少的 Agent 也可能得到更高排名。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Self-Improving Coding Agent · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
1e:["$","section","experiments",{"id":"experiments","children":[[["$","span","results",{"className":"anchor-alias","id":"results"}],["$","span","observation",{"className":"anchor-alias","id":"observation"}]],["$","span",null,{"className":"reading-section-number","children":"07"}],["$","div",null,{"children":[["$","h2",null,{"children":"Experiments & Claims"}],["$","p",null,{"className":"section-question","children":"Research Question → Experiment → Answer"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"Question：完整 Agent 能否通过编辑自身提高综合效用？→ Experiment：运行迭代自我修改，在 SWE-bench Verified、LiveCodeBench 子集和文件编辑、符号定位任务上记录每轮表现。→ Answer：作者观察到综合改进及可解释的工具变化，但单轮得分会下降，最佳 Accuracy 与最佳 Utility 也不必对应同一个版本。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Self-Improving Coding Agent · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"作者在 SWE-bench Verified 的随机子集上报告 17% 到 53% 的提升，并在其他编程评估中观察到增益。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Self-Improving Coding Agent · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
1f:["$","section","takeaways",{"id":"takeaways","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"08"}],["$","div",null,{"children":[["$","h2",null,{"children":"Takeaways"}],["$","p",null,{"className":"section-question","children":"这篇论文改变了哪些判断？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"SICA 把“自身”落实为可执行的 Agent Repository。最值得复用的实验习惯是保存源码与每轮 Utility，而不是只保存最后一个 Prompt。论文展示了改进后 Agent 接管下一轮的结构，也暴露出评价权重会塑造演化方向。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Self-Improving Coding Agent · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
20:["$","section","assumptions",{"id":"assumptions","children":[[["$","span","limits",{"className":"anchor-alias","id":"limits"}]],["$","span",null,{"className":"reading-section-number","children":"09"}],["$","div",null,{"children":[["$","h2",null,{"children":"Most Fragile Assumption"}],["$","p",null,{"className":"section-question","children":"哪一个假设失效会动摇方法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"最脆弱的假设是固定 Utility 能代表未来用户需求。成本上限、超时和题目组合都是设计选择；一个针对短任务优化的编辑器，可能牺牲长任务中必要的核验步骤。选出 Utility 最高的父代并不保证选出最佳长期 Improver。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Self-Improving Coding Agent · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"这一数字来自论文的随机子集和资源约束，不能与完整 SWE-bench Verified 榜单直接横比；代码演化不等于 foundation model 学习，单次迭代也可能退步。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Self-Improving Coding Agent · v2","children":["[",1,"]"]}]]}]]}]]]}]]}]
21:["$","section","reproduction",{"id":"reproduction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"10"}],["$","div",null,{"children":[["$","h2",null,{"children":"One-Week Reproduction"}],["$","p",null,{"className":"section-question","children":"用一周检验一个最小且明确的命题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"Day 1–2：选取可隔离运行的文件编辑与符号定位任务，建立独立测试集。Day 3–5：限制修改范围为两个工具，运行五轮，保留每轮源码、成本和错误日志。Day 6–7：分别按原 Utility 与只看 Accuracy 重放选择，检验效率收益来自工具改进还是少做了必要检查。"}],"$undefined",null]}]]]}]]}]
22:["$","section","counterexample",{"id":"counterexample","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"11"}],["$","div",null,{"children":[["$","h2",null,{"children":"Counterexample Design"}],["$","p",null,{"className":"section-question","children":"如何构造有辨识力的反例？"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"在开发集放入容易用字符串搜索定位的符号，隐藏集加入同名符号、动态导入与多层继承。如果演化出的快速 Locator 在开发集更好、隐藏集显著更差，就能定位到一个具体失败：局部的效率奖励偏好捷径，且不足以支撑可迁移能力。"}],"$undefined",null]}]]]}]]}]
23:["$","section","follow-up",{"id":"follow-up","children":[[["$","span","outlook",{"className":"anchor-alias","id":"outlook"}]],["$","span",null,{"className":"reading-section-number","children":"12"}],["$","div",null,{"children":[["$","h2",null,{"children":"Follow-up Research"}],["$","p",null,{"className":"section-question","children":"从缺陷与需求推导新的研究问题。"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"后续相关工作 HyperAgents 已研究可编辑 Meta-Agent，并用受控的 Improvement@k 比较产生更好后继的能力。因此，仅增加 Improver 评测不足以支撑新颖性。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2603.19461v1",{"href":"#reference-2603.19461v1","aria-label":"来源 4: HyperAgents","children":["[",4,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"让 Agent 学习一份“变化影响契约”：每次修改同时给出受影响的行为、资源消耗与必须保持的能力，由独立任务生成器主动寻找契约违例。研究目标是让下一代继承可检验的工程知识，而非仅继承源码。相对 ADAS 的候选搜索和 STOP 的程序改进，需要验证契约能否跨不同 Utility 保留价值；不能把多写一段修改说明当作实现。 相对 HyperAgents，待检验的缺口是改进机制在何种条件下可分解、移植与继承；需要同起点、同预算的组件交叉实验，识别机制作用及交互项。这个缺口尚未完成穷尽式检索，不能宣称已确认 Novelty。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2408.08435",{"href":"#reference-2408.08435","aria-label":"来源 2: Automated Design of Agentic Systems","children":["[",2,"]"]}],["$","a","2310.02304",{"href":"#reference-2310.02304","aria-label":"来源 3: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation","children":["[",3,"]"]}],["$","a","2603.19461v1",{"href":"#reference-2603.19461v1","aria-label":"来源 4: HyperAgents","children":["[",4,"]"]}]]}]]}]]]}]]}]

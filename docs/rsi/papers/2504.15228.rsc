16:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
17:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"配备基本编程工具的 Agent，能否通过编辑自己而提升表现？"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Self-Improving Coding Agent · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"一个 Agent 可以拥有很强的语言推理能力，却持续浪费时间在文件定位、长 Context 和低效编辑上。手工调整这些工程组件既慢又依赖经验。SICA 把这类瓶颈视为可由 Agent 自己修改的代码问题，同时把准确率、时间和成本纳入选择目标，使改进有实际部署价值。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Self-Improving Coding Agent · v2","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"ADAS 通过固定 Meta-Agent 生成目标程序，证明 Agent 设计可以自动搜索。STOP 已研究改进调用程序的 Improver。SICA 将任务执行者与下一轮修改者统一到同一套完整 Python Agent 中；相较于只搜索一个受限 forward 函数，它允许工具、Context 管理等更多组件变化。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2408.08435",{"href":"#reference-2408.08435","aria-label":"来源 2: Automated Design of Agentic Systems","children":["[",2,"]"]}],["$","a","2310.02304",{"href":"#reference-2310.02304","aria-label":"来源 3: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"从日常调试出发：大量失败来自工具接口，修复接口通常比更换 Model 便宜。Coding Agent 本来就会修改 Python 工程，因而具备修改自身工程的基本动作。下一步的关键问题是该让谁来修改：如果最新版本已经更善于读代码和编辑文件，就有理由让它承担后续修改，再通过外部 Benchmark 拒绝无效更新。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2408.08435",{"href":"#reference-2408.08435","aria-label":"来源 2: Automated Design of Agentic Systems","children":["[",2,"]"]}],["$","a","2310.02304",{"href":"#reference-2310.02304","aria-label":"来源 3: Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"SICA 让档案中表现最佳的 Agent 承担下一轮改进工作，目标 Agent 与改进 Agent 因而不再固定分离。优化对象是组织工具、prompt 和 model 调用的程序；效用同时考虑得分、耗时与费用，使自身实现成为可以累积更新的经验。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: A Self-Improving Coding Agent · v2","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","method",{"id":"method","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"05"}],"$L1c"]}],"$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]
18:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"阅读已固定版本的原文 Background、方法与主要结果，结合下列相关文献撰写。Paper Claim 表示作者报告，未独立复现；Inference 包括数学教学推演与 Idea Reconstruction。One-Week Reproduction、Counterexample 和 Follow-up 均为待执行提案，Novelty 尚需更全面的文献与实验检验。"}],["$","ol",null,{"children":[["$","li","paper",{"id":"reference-paper","children":[["$","a",null,{"href":"https://arxiv.org/html/2504.15228v2","target":"_blank","rel":"noreferrer","children":["[",1,"] ","A Self-Improving Coding Agent · v2"," ↗"]}],["$","span",null,{"children":"原文 Background、Method / Formalization 与主要实验或理论结论。数字沿用原文设置；未独立运行完整实验。"}]]}],["$","li","2408.08435",{"id":"reference-2408.08435","children":[["$","a",null,{"href":"https://arxiv.org/abs/2408.08435v2","target":"_blank","rel":"noreferrer","children":["[",2,"] ","Automated Design of Agentic Systems"," ↗"]}],["$","span",null,{"children":"相关方法与研究背景；用于说明具体差异，不能替代对本篇结论的验证。"}]]}],["$","li","2310.02304",{"id":"reference-2310.02304","children":[["$","a",null,{"href":"https://arxiv.org/abs/2310.02304v3","target":"_blank","rel":"noreferrer","children":["[",3,"] ","Self-Taught Optimizer (STOP): Recursively Self-Improving Code Generation"," ↗"]}],["$","span",null,{"children":"相关方法与研究背景；用于说明具体差异，不能替代对本篇结论的验证。"}]]}],["$","li","2603.19461v1",{"id":"reference-2603.19461v1","children":[["$","a",null,{"href":"https://arxiv.org/html/2603.19461v1","target":"_blank","rel":"noreferrer","children":["[",4,"] ","HyperAgents"," ↗"]}],["$","span",null,{"children":"Follow-up 的相关工作核查；晚于原论文的研究仅用于评估提案，不作为作者当时的知识或动机。"}]]}]]}],["$","span",null,{"children":["arXiv:","2504.15228"," · ","v2"," / REVIEWED ","2026.09.13"]}]]}]

16:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
17:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"compound AI system 包含 model 调用、程序和外部 solver，往往无法对端到端目标直接求数值 gradient。论文研究能否以自然语言批评为 feedback，将最终失败追溯到可修改变量，从而自动改进多个相互依赖的组件或设计产物。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: TextGrad: Automatic \"Differentiation\" via Text · v1","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Compound AI System 中，最终错误可能来自多个上游组件。只给总分，很难决定改哪个 Prompt、代码或其他变量。TextGrad 研究把语言 Feedback 沿计算图向上游传递，让每个可优化变量收到与其作用相关的修改建议。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: TextGrad: Automatic \"Differentiation\" via Text · v1","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"OPRO 根据候选与分数搜索，Self-Refine 用反馈修订当前输出。TextGrad 增加计算图抽象与局部反馈传播，使多个组件能围绕共同目标优化。其 Textual Gradient 是语言建议，不等同于数学上的可微梯度。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2309.03409",{"href":"#reference-2309.03409","aria-label":"来源 2: Large Language Models as Optimizers","children":["[",2,"]"]}],["$","a","2303.17651",{"href":"#reference-2303.17651","aria-label":"来源 3: Self-Refine: Iterative Refinement with Self-Feedback","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"数值 AutoDiff 的优势来自记住前向依赖，再把输出误差分配给输入。LLM 虽然不一定提供可用导数，却能阅读局部输入、输出和下游反馈，解释该组件如何影响最终结果。于是可以保留图结构，让语言承担局部归因和编辑；这种类比是否有效必须用实际修改后的目标值验证。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2309.03409",{"href":"#reference-2309.03409","aria-label":"来源 2: Large Language Models as Optimizers","children":["[",2,"]"]}],["$","a","2303.17651",{"href":"#reference-2303.17651","aria-label":"来源 3: Self-Refine: Iterative Refinement with Self-Feedback","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"feedback 的价值不仅在于指出答案错了，还在于结合组件的角色和下游目标说明应改哪里。computation graph 提供这种依赖结构，language model 承担语义上的错误归因；所谓 textual gradient 是优化建议的比喻，并不具有数值导数的数学保证。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: TextGrad: Automatic \"Differentiation\" via Text · v1","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","method",{"id":"method","children":["$undefined","$L1c","$L1d"]}],"$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}]

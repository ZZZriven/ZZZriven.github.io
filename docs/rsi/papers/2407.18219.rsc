 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv 原文",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2407.18219v2","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"阅读 PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"IN A NUTSHELL"}],["$","p",null,{"children":"把单次解题改写为多轮决策问题，训练模型从自身失败历史中修正回答；训练更新与推理时修订需要分开理解。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"改进对象"}],["$","dd",null,{"children":"模型权重与多轮修订策略"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"反馈来源"}],["$","dd",null,{"children":"训练时使用答案正确性奖励和轨迹中的失败历史；改进示范可来自自采样选优或更强模型，部署可选择是否调用检查器。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"证据边界"}],["$","dd",null,{"children":"已核验 arXiv 摘要与 v2 历史，正文第 3—4 节训练设定、轨迹生成，以及第 4.3 节两种部署协议；未复现实验。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESEARCH PROBLEM"}],["$","h2",null,{"children":["研究问题",false]}],["$","p",null,{"children":"直接要求现成模型反思，往往不能让回答随尝试次数稳定改善。论文研究怎样训练一种能利用既往失败的策略，使增加推理轮次成为有效计算，并避免模型只会重述原答案或在修订时破坏原本正确的解法。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"INSIGHT"}],["$","h2",null,{"children":["核心洞察",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"修订能力需要在模型实际会犯错的状态上训练，而不只是学习孤立的正确答案。把问题、过去尝试和反馈共同视为状态，能够把如何从失败转向成功变成训练对象，进而缩小训练与部署时历史分布的差异。"}]]}]]}],["$","section","observation",{"id":"observation","children":["$L10","$L11"]}],"$L12","$L13","$L14","$L15"]}],"$L16","$L17","$L18","$L19"]}],"$L1a"]}]]}]
10:["$","span",null,{"className":"reading-section-number","children":["0",3]}]
11:["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OBSERVATION"}],["$","h2",null,{"children":["关键观察",false]}],["$","p",null,{"children":"论文比较直接重复采样和连续修订，训练后的模型在数学任务中能更有效地利用多轮计算。作者还分别报告带正确性检查器和不带检查器的推理：两者的停止及选答案机制不同，分数不能混为一种纯内省能力。"}]]}]
12:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"METHOD"}],["$","h2",null,{"children":["方法解析",false]}],["$","p",null,{"children":"将单轮题目构成多轮 MDP，用当前模型收集失败和成功轨迹，再通过自身多次采样选优或更强模型补充改进回答。采用奖励加权的监督训练更新策略，并迭代收集新轨迹，让模型学习在既有尝试之后作出修订。"}]]}]]}]
13:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"RESULTS & EVIDENCE"}],["$","h2",null,{"children":["实验与结论",false]}],["$","p",null,{"children":"作者报告 Llama2、Llama3 与 Mistral 系列在数学推理中随轮次改善，并在相同推理计算条件下超过若干单轮策略。分析显示改进来自有意义的回答修正；结论适用于论文的数据、反馈协议与计算预算。"}]]}]]}]
14:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"LIMITATIONS"}],["$","h2",null,{"children":["局限与边界",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"训练依赖题目与正确性信号，改进回答还可能来自更强模型，因此不能笼统称为完全无外部反馈。标题中的 Recursive 指多轮内省；推理时通常修订上下文里的回答，并未在每轮自主修改模型训练算法。"}]]}]]}]
15:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","span",null,{"className":"reading-section-en","children":"OUTLOOK"}],["$","h2",null,{"children":["未来展望",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：应把带检查器、无检查器和更强教师支持的成绩分别列出，再扩展到长程工具使用。还需检验训练后的修订策略能否处理未见失败类型，以及在有限预算下什么时候继续修订优于重新开始。"}]]}]]}]
16:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"THE RSI CONNECTION · 本站判断"}],["$","h2",null,{"children":"与递归自我改进的关系"}],["$","p",null,{"children":"主分类为模型与奖励，因为核心贡献是训练并保留多轮修订策略；部署阶段另含输出修订机制。迭代训练属于持久系统优化，但这里的递归术语不构成改进器自修改证据。"}]]}]
17:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"来源与核验范围"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。核心洞察、局限分析、关联分类与未来展望含本站解读；论文观察与实验结果在其原始设置下成立。摘要级核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2407.18219",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2407.18219","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要与版本历史：题名、作者、日期、数学任务、多模型及等推理预算比较。"}]]}],["$","li","https://arxiv.org/html/2407.18219v2",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2407.18219v2","target":"_blank","rel":"noreferrer","children":["轨迹训练与部署协议"," ↗"]}],["$","span",null,{"children":"全文第 3—4.2 节：MDP、当前策略轨迹、自蒸馏或教师示范；第 4.3 节及图 3：带检查器和无检查器推理。"}]]}]]}],["$","span",null,{"children":["arXiv:","2407.18219"," · v2"," / REVIEWED ","2026.09.12"]}]]}]

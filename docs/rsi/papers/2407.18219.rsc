22 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15}],"arXiv",["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":14}]]}],["$","a",null,{"className":"rsi-button","href":"https://arxiv.org/pdf/2407.18219v2","target":"_blank","rel":"noreferrer","children":[["$","$Lf",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":15}],"Read PDF",["$","$Lf",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:0:props:children:0:props:children:5:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-up-right","size":14}]]}]]}]]}],["$","div",null,{"className":"reading-summary","children":[["$","span",null,{"className":"overline","children":"SUMMARY"}],["$","p",null,{"children":"把单次解题改写为多轮决策问题，训练 model 从自身失败历史中修正回答；训练更新与 inference-time 修订需要分开理解。"}]]}],["$","dl",null,{"className":"evidence-strip","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Improvement Target"}],["$","dd",null,{"children":"Model Weights & Multi-Turn Refinement Policy"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Feedback"}],["$","dd",null,{"children":"训练时使用答案正确性 reward 和轨迹中的失败历史；改进示范可来自自采样选优或更强 model，部署可选择是否调用 checker。"}]]}],["$","div",null,{"style":{"gridColumn":"1 / -1"},"children":[["$","dt",null,{"children":"Evidence Scope"}],["$","dd",null,{"children":"已核验 arXiv 摘要与 v2 历史，正文第 3—4 节训练设定、轨迹生成，以及第 4.3 节两种部署协议；未复现实验。"}]]}]]}],["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":[["$","span",null,{"className":"reading-section-number","children":["0",1]}],["$","div",null,{"children":[["$","h2",null,{"children":["Research Problem",false]}],["$","p",null,{"children":"直接要求现成 model reflection，往往不能让回答随尝试次数稳定改善。论文研究怎样训练一种能利用既往失败的 policy，使增加 inference rounds 成为有效计算，并避免 model 只会重述原答案或在修订时破坏原本正确的解法。"}]]}]]}],["$","section","insight",{"id":"insight","children":[["$","span",null,{"className":"reading-section-number","children":["0",2]}],["$","div",null,{"children":[["$","h2",null,{"children":["Insight",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"修订能力需要在 model 实际会犯错的状态上训练，而不只是学习孤立的正确答案。把问题、过去尝试和 feedback 共同视为状态，能够把如何从失败转向成功变成训练对象，进而缩小训练与部署时历史分布的差异。"}]]}]]}],"$L10","$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18"]}],"$L19"]}]]}]
10:["$","section","observation",{"id":"observation","children":[["$","span",null,{"className":"reading-section-number","children":["0",3]}],["$","div",null,{"children":[["$","h2",null,{"children":["Observation",false]}],["$","p",null,{"children":"论文比较直接重复采样和连续修订，训练后的 model 在数学任务中能更有效地利用多轮计算。作者还分别报告带 correctness checker 和不带 checker 的 inference：两者的停止及选答案机制不同，分数不能混为一种纯内省能力。"}]]}]]}]
11:["$","section","method",{"id":"method","children":[["$","span",null,{"className":"reading-section-number","children":["0",4]}],["$","div",null,{"children":[["$","h2",null,{"children":["Method",false]}],["$","p",null,{"children":"将单轮题目构成多轮 MDP，用当前 model 收集失败和成功轨迹，再通过自身多次采样选优或更强 model 补充改进回答。采用 reward 加权的监督训练更新 policy，并迭代收集新轨迹，让 model 学习在既有尝试之后作出修订。"}]]}]]}]
12:["$","section","results",{"id":"results","children":[["$","span",null,{"className":"reading-section-number","children":["0",5]}],["$","div",null,{"children":[["$","h2",null,{"children":["Results",false]}],["$","p",null,{"children":"作者报告 Llama2、Llama3 与 Mistral 系列在数学 reasoning 中随轮次改善，并在相同 inference compute 条件下超过若干单轮 policy。分析显示改进来自有意义的回答修正；结论适用于论文的数据、feedback 协议与计算预算。"}]]}]]}]
13:["$","section","limits",{"id":"limits","children":[["$","span",null,{"className":"reading-section-number","children":["0",6]}],["$","div",null,{"children":[["$","h2",null,{"children":["Limitations",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"训练依赖题目与正确性信号，改进回答还可能来自更强 model，因此不能笼统称为完全无 external feedback。标题中的 Recursive 指多轮内省；inference-time 通常修订 context 里的回答，并未在每轮自主修改 model 训练算法。"}]]}]]}]
14:["$","section","outlook",{"id":"outlook","children":[["$","span",null,{"className":"reading-section-number","children":["0",7]}],["$","div",null,{"children":[["$","h2",null,{"children":["Outlook",["$","small",null,{"children":"本站解读"}]]}],["$","p",null,{"children":"编辑展望：应把带 checker、无 checker 和更强教师支持的成绩分别列出，再扩展到 long-horizon 工具使用。还需检验训练后的修订 policy 能否处理未见失败类型，以及在有限预算下什么时候继续修订优于重新开始。"}]]}]]}]
15:["$","aside",null,{"className":"rsi-relation","id":"rsi-relation","children":[["$","span",null,{"className":"overline","children":"EDITORIAL NOTE · 本站判断"}],["$","h2",null,{"children":"Relation to RSI"}],["$","p",null,{"children":"主分类为 Models & Rewards，因为核心贡献是训练并保留多轮修订 policy；部署阶段另含 Output Refinement 机制。迭代训练属于 Persistent System Improvement，但这里的 recursion 术语不构成 Improver Self-Modification 证据。"}]]}]
16:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"以下标注本条目实际使用的材料。Insight、Limitations、Relation to RSI 与 Outlook 含本站解读；Observation 与 Results 在论文原始设置下成立。基于 abstract 的核验不等同于全文复现。"}],["$","ul",null,{"children":[["$","li","https://arxiv.org/abs/2407.18219",{"children":[["$","a",null,{"href":"https://arxiv.org/abs/2407.18219","target":"_blank","rel":"noreferrer","children":["arXiv 摘要与版本"," ↗"]}],["$","span",null,{"children":"摘要与版本历史：题名、作者、日期、数学任务、多 model 及等 inference budget 比较。"}]]}],["$","li","https://arxiv.org/html/2407.18219v2",{"children":[["$","a",null,{"href":"https://arxiv.org/html/2407.18219v2","target":"_blank","rel":"noreferrer","children":["轨迹训练与部署协议"," ↗"]}],["$","span",null,{"children":"全文第 3—4.2 节：MDP、当前 strategy 轨迹、自蒸馏或教师示范；第 4.3 节及图 3：带 checker 和无 checker reasoning。"}]]}]]}],["$","span",null,{"children":["arXiv:","2407.18219"," · v2"," / REVIEWED ","2026.09.12"]}]]}]

20:["$","section","reproduction",{"id":"reproduction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"10"}],["$","div",null,{"children":[["$","h2",null,{"children":"One-Week Reproduction"}],["$","p",null,{"className":"section-question","children":"用一周检验一个最小且明确的命题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"Day 1–2：用可重置的小型环境实现采集、制作和移动任务。Day 3–5：对比保存可执行 Skill 与只保留文本经验，匹配行动预算。Day 6–7：改变初始资源和地图，测新任务完成率、无效调用率及每个 Skill 的复用次数。"}],"$undefined",null]}]]]}]]}]
21:["$","section","counterexample",{"id":"counterexample","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"11"}],["$","div",null,{"children":[["$","h2",null,{"children":"Counterexample Design"}],["$","p",null,{"className":"section-question","children":"如何构造有辨识力的反例？"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"让两个地图具有相同资源描述，却要求相反的前置动作。若描述相似的 Skill 被反复检索并失败，而从头规划能成功，就能检验语义相似度对行为可迁移性的不足。"}],"$undefined",null]}]]]}]]}]
22:["$","section","follow-up",{"id":"follow-up","children":[[["$","span","outlook",{"className":"anchor-alias","id":"outlook"}]],["$","span",null,{"className":"reading-section-number","children":"12"}],["$","div",null,{"children":[["$","h2",null,{"children":"Follow-up Research"}],["$","p",null,{"className":"section-question","children":"从缺陷与需求推导新的研究问题。"}],[["$","div","0",{"className":"analysis-block analysis-hypothesis","children":[["$","span",null,{"className":"claim-label claim-hypothesis","children":"Hypothesis"}],["$","p",null,{"children":"研究自动发现 Skill 的适用边界：执行成功后主动改变环境条件，学习何时技能仍有效，再让 Curriculum 专门探索边界未知的组合。相对 Reflexion 的事后总结，这将经验获取目标变成可复用技能的适用域识别。关键指标应是组合成功率和错误迁移减少量，不能只数 Library 条目。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2210.03629",{"href":"#reference-2210.03629","aria-label":"来源 2: ReAct: Synergizing Reasoning and Acting in Language Models","children":["[",2,"]"]}],["$","a","2303.11366",{"href":"#reference-2303.11366","aria-label":"来源 3: Reflexion: Language Agents with Verbal Reinforcement Learning","children":["[",3,"]"]}]]}]]}]]]}]]}]

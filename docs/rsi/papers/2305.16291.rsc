15:["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"Contents · 12 Questions"}],["$","nav",null,{"aria-label":"移动端论文目录","children":[["$","a","problem",{"href":"#problem","children":["01"," ","Research Problem & Background"]}],["$","a","prior-work",{"href":"#prior-work","children":["02"," ","Prior Work & Research Gap"]}],["$","a","idea-reconstruction",{"href":"#idea-reconstruction","children":["03"," ","Idea Reconstruction"]}],["$","a","intuition",{"href":"#intuition","children":["04"," ","Core Intuition"]}],["$","a","method",{"href":"#method","children":["05"," ","Method & Worked Example"]}],["$","a","mathematics",{"href":"#mathematics","children":["06"," ","Mathematical Foundations"]}],["$","a","experiments",{"href":"#experiments","children":["07"," ","Experiments & Claims"]}],["$","a","takeaways",{"href":"#takeaways","children":["08"," ","Takeaways"]}],["$","a","assumptions",{"href":"#assumptions","children":["09"," ","Most Fragile Assumption"]}],["$","a","reproduction",{"href":"#reproduction","children":["10"," ","One-Week Reproduction"]}],["$","a","counterexample",{"href":"#counterexample","children":["11"," ","Counterexample Design"]}],["$","a","follow-up",{"href":"#follow-up","children":["12"," ","Follow-up Research"]}]]}]]}]
16:["$","div",null,{"className":"reading-sections","children":[["$","section","problem",{"id":"problem","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"children":"Research Problem & Background"}],["$","p",null,{"className":"section-question","children":"问题为什么重要，解决它有什么价值？"}],[["$","div","0",{"className":"analysis-block analysis-paper","children":[["$","span",null,{"className":"claim-label claim-paper","children":"Paper Claim"}],["$","p",null,{"children":"开放环境中的 Agent，怎样保留并复用过去学到的行为？"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Voyager: An Open-Ended Embodied Agent with Large Language Models · v2","children":["[",1,"]"]}]]}]]}],["$","div","1",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"开放环境中的任务互相依赖：获得工具后才能采集更高级资源。若每次都从原始动作重新推理，Context 和尝试预算很快耗尽。Voyager 研究如何让固定 LLM 持续探索，同时把已经成功的行为保存为可执行 Skill，降低之后解决复杂任务的成本。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Voyager: An Open-Ended Embodied Agent with Large Language Models · v2","children":["[",1,"]"]}]]}]]}]]]}]]}],["$","section","prior-work",{"id":"prior-work","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"02"}],["$","div",null,{"children":[["$","h2",null,{"children":"Prior Work & Research Gap"}],["$","p",null,{"className":"section-question","children":"前人做到哪一步，缺口在哪里？"}],[["$","div","0",{"className":"analysis-block analysis-prior","children":[["$","span",null,{"className":"claim-label claim-prior","children":"Prior Work"}],["$","p",null,{"children":"ReAct 提供交互式推理与行动；Reflexion 将失败总结保存为语言记忆。Voyager 在这些能力背景下进一步强调可运行的 Skill Library 和自动 Curriculum。语言总结告诉系统注意什么，可执行 Skill 则能直接调用一段长行为序列，两者的验证和复用方式不同。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2210.03629",{"href":"#reference-2210.03629","aria-label":"来源 2: ReAct: Synergizing Reasoning and Acting in Language Models","children":["[",2,"]"]}],["$","a","2303.11366",{"href":"#reference-2303.11366","aria-label":"来源 3: Reflexion: Language Agents with Verbal Reinforcement Learning","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","idea-reconstruction",{"id":"idea-reconstruction","children":["$undefined",["$","span",null,{"className":"reading-section-number","children":"03"}],["$","div",null,{"children":[["$","h2",null,{"children":"Idea Reconstruction"}],["$","p",null,{"className":"section-question","children":"从已有知识与失败模式出发，如何走到这个想法？"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"从 Minecraft 的 Tech Tree 推起：复杂目标可以由较小目标组合，而已完成的小目标往往无需重新设计。程序恰好能封装这种可重用行为。若再根据库存、已完成任务和失败记录选择下一目标，就能让探索难度随可用工具变化。这里仍需验证 Library 中的技能在新环境中是否保持有效。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","2210.03629",{"href":"#reference-2210.03629","aria-label":"来源 2: ReAct: Synergizing Reasoning and Acting in Language Models","children":["[",2,"]"]}],["$","a","2303.11366",{"href":"#reference-2303.11366","aria-label":"来源 3: Reflexion: Language Agents with Verbal Reinforcement Learning","children":["[",3,"]"]}]]}]]}]]]}]]}],["$","section","intuition",{"id":"intuition","children":[[["$","span","insight",{"className":"anchor-alias","id":"insight"}]],["$","span",null,{"className":"reading-section-number","children":"04"}],["$","div",null,{"children":[["$","h2",null,{"children":"Core Intuition"}],["$","p",null,{"className":"section-question","children":"用一个清楚的视角抓住方法本质。"}],[["$","div","0",{"className":"analysis-block analysis-inference","children":[["$","span",null,{"className":"claim-label claim-inference","children":"Inference"}],["$","p",null,{"children":"Voyager 把成功经验存为可执行代码 skill，使学习成果能被检索、组合并用于后续探索。自动 curriculum 负责决定下一步学什么，skill library 负责保留已学内容；model 能力与系统能力由此可以分开观察，后者能在不更新参数时持续积累。"}],"$undefined",["$","div",null,{"className":"block-citations","children":[["$","a","paper",{"href":"#reference-paper","aria-label":"来源 1: Voyager: An Open-Ended Embodied Agent with Large Language Models · v2","children":["[",1,"]"]}]]}]]}]]]}]]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]
17:["$","div",null,{"className":"reading-source","id":"sources","children":[["$","h2",null,{"children":"Sources & Verification"}],["$","p",null,{"children":"阅读已固定版本的原文 Background、方法与主要结果，结合下列相关文献撰写。Paper Claim 表示作者报告，未独立复现；Inference 包括数学教学推演与 Idea Reconstruction。One-Week Reproduction、Counterexample 和 Follow-up 均为待执行提案，Novelty 尚需更全面的文献与实验检验。"}],["$","ol",null,{"children":[["$","li","paper",{"id":"reference-paper","children":[["$","a",null,{"href":"https://arxiv.org/html/2305.16291v2","target":"_blank","rel":"noreferrer","children":["[",1,"] ","Voyager: An Open-Ended Embodied Agent with Large Language Models · v2"," ↗"]}],["$","span",null,{"children":"原文 Background、Method / Formalization 与主要实验或理论结论。数字沿用原文设置；未独立运行完整实验。"}]]}],["$","li","2210.03629",{"id":"reference-2210.03629","children":[["$","a",null,{"href":"https://arxiv.org/abs/2210.03629v3","target":"_blank","rel":"noreferrer","children":["[",2,"] ","ReAct: Synergizing Reasoning and Acting in Language Models"," ↗"]}],["$","span",null,{"children":"相关方法与研究背景；用于说明具体差异，不能替代对本篇结论的验证。"}]]}],["$","li","2303.11366",{"id":"reference-2303.11366","children":[["$","a",null,{"href":"https://arxiv.org/abs/2303.11366v4","target":"_blank","rel":"noreferrer","children":["[",3,"] ","Reflexion: Language Agents with Verbal Reinforcement Learning"," ↗"]}],["$","span",null,{"children":"相关方法与研究背景；用于说明具体差异，不能替代对本篇结论的验证。"}]]}]]}],["$","span",null,{"children":["arXiv:","2305.16291"," · ","v2"," / REVIEWED ","2026.09.13"]}]]}]
